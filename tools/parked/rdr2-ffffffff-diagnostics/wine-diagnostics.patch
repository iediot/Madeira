+/* Madeira [wake-trace] (env MADEIRA_WAKE_TRACE=<seconds>): which thread wakes a thread
+ * that has been idle for at least that long, with the main program's code addresses on
+ * the waker's stack. RDR2 hands its "Unknown error FFFFFFFF" to a thread that sleeps
+ * until an error arrives; the waker is the code that raised it. A thread whose waits
+ * keep timing out stays idle across them. */
+struct ios_wt_slot { ULONG tid; LONG waiting; void *peb; ULONG_PTR obj[4]; ULONGLONG idle_since; int kind, nobj; };
+static struct ios_wt_slot ios_wt_tab[4096];
+static LONG ios_wt_lines;
+extern void ios_wake_trace_stack( void );
+
+static int ios_wt_seconds(void)
+{
+    static int secs = -1;
+    if (secs < 0)
+    {
+        const char *e = getenv( "MADEIRA_WAKE_TRACE" );
+        secs = e && atoi( e ) > 0 ? atoi( e ) : 0;
+    }
+    return secs;
+}
+
+static ULONGLONG ios_wt_now(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (ULONGLONG)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+static const char *ios_wt_kind( int kind )
+{
+    switch (kind)
+    {
+    case 1: return "wait";
+    case 2: return "wait-multi";
+    case 3: return "wait-alert";
+    default: return "?";
+    }
+}
+
+static struct ios_wt_slot *ios_wt_self(void)
+{
+    ULONG tid = HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+    struct ios_wt_slot *slot = &ios_wt_tab[(tid >> 2) & 4095];
+    if (slot->tid != tid)
+    {
+        slot->tid = tid;
+        slot->idle_since = 0;
+    }
+    return slot;
+}
+
+static void ios_wt_enter( int kind, const ULONG_PTR *objs, int nobj )
+{
+    struct ios_wt_slot *slot;
+    int i;
+    if (!ios_wt_seconds() || !NtCurrentTeb()) return;
+    slot = ios_wt_self();
+    slot->peb = NtCurrentTeb()->Peb;
+    slot->nobj = !objs ? 0 : nobj < 4 ? nobj : 4;
+    for (i = 0; i < slot->nobj; i++) slot->obj[i] = objs[i];
+    slot->kind = kind;
+    if (!slot->idle_since) slot->idle_since = ios_wt_now();
+    __atomic_store_n( &slot->waiting, 1, __ATOMIC_RELEASE );
+}
+
+static void ios_wt_leave( unsigned int status )
+{
+    struct ios_wt_slot *slot;
+    ULONGLONG idle;
+    if (!ios_wt_seconds() || !NtCurrentTeb()) return;
+    slot = ios_wt_self();
+    __atomic_store_n( &slot->waiting, 0, __ATOMIC_RELEASE );
+    if (status == STATUS_TIMEOUT) return;   /* still idle */
+    {
+        ULONGLONG now = ios_wt_now(), since = slot->idle_since;
+        idle = since && since < now ? now - since : 0;
+    }
+    slot->idle_since = 0;
+    if (idle >= (ULONGLONG)ios_wt_seconds() * 1000000000ull &&
+        __sync_add_and_fetch( &ios_wt_lines, 1 ) <= 2000)
+        ERR( "[wake-trace] tid %04x woke after %.1f s idle (%s on %#lx) -> %#x\n",
+             slot->tid, idle / 1e9, ios_wt_kind( slot->kind ), (unsigned long)slot->obj[0], status );
+}
+
+/* A wake operation: report every thread idle long enough that it may wake. obj is a
+ * handle (matched within this process) or, for alerts, a thread id (tid != 0). */
+static void ios_wt_wake( const char *op, ULONG_PTR obj, ULONG tid )
+{
+    ULONGLONG now, min;
+    void *peb;
+    int i, hits = 0;
+    if (!ios_wt_seconds() || !NtCurrentTeb()) return;
+    now = ios_wt_now();
+    min = (ULONGLONG)ios_wt_seconds() * 1000000000ull;
+    peb = NtCurrentTeb()->Peb;
+    for (i = 0; i < 4096; i++)
+    {
+        struct ios_wt_slot *slot = &ios_wt_tab[i];
+        ULONGLONG since = slot->idle_since;
+        if (!__atomic_load_n( &slot->waiting, __ATOMIC_ACQUIRE ) || !since || since > now || now - since < min) continue;
+        if (tid) { if (slot->tid != tid) continue; }
+        else
+        {
+            int j, match = 0;
+            if (slot->peb != peb || slot->kind == 3) continue;
+            for (j = 0; j < slot->nobj; j++) if (slot->obj[j] == obj) match = 1;
+            if (!match) continue;
+        }
+        if (__sync_add_and_fetch( &ios_wt_lines, 1 ) > 2000) return;
+        ERR( "[wake-trace] tid %04lx %s(%#lx) wakes tid %04x idle %.1f s (%s)\n",
+             HandleToULong( NtCurrentTeb()->ClientId.UniqueThread ), op, (unsigned long)obj,
+             slot->tid, (now - since) / 1e9, ios_wt_kind( slot->kind ) );
+        if (!hits++) ios_wake_trace_stack();
+    }
+}
+#endif
