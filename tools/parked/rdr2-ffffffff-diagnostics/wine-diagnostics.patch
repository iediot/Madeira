+/* Madeira [at] anti-tamper trace (env MADEIRA_AT_TRACE=<program name>, e.g. RDR2.exe):
+ * every exception the named program gets, with the x64 instruction bytes that raised
+ * it, and where its handler resumes (how far past the instruction, and whether it set
+ * the trap flag). Anti-debug guards raise exceptions on purpose and check exactly this. */
+static PEB *at_peb;
+static int at_enabled;
+static struct { DWORD tid; DWORD code; ULONG64 rip; } at_last[1024];
+
+static int at_on(void)
+{
+    PEB *peb = NtCurrentTeb()->Peb;
+    if (peb != at_peb)
+    {
+        WCHAR buf[64];
+        UNICODE_STRING name, value;
+        int on = 0;
+
+        RtlInitUnicodeString( &name, L"MADEIRA_AT_TRACE" );
+        value.Buffer = buf;
+        value.Length = 0;
+        value.MaximumLength = sizeof(buf) - sizeof(WCHAR);
+        if (!RtlQueryEnvironmentVariable_U( NULL, &name, &value ) && value.Length &&
+            peb->ProcessParameters && peb->ProcessParameters->ImagePathName.Buffer)
+        {
+            const UNICODE_STRING *img = &peb->ProcessParameters->ImagePathName;
+            USHORT n = img->Length / sizeof(WCHAR), w = value.Length / sizeof(WCHAR), i;
+            if (n >= w)
+            {
+                for (i = 0; i < w; i++)
+                    if (RtlDowncaseUnicodeChar( img->Buffer[n - w + i] ) != RtlDowncaseUnicodeChar( buf[i] )) break;
+                on = (i == w);
+            }
+        }
+        at_enabled = on;
+        at_peb = peb;
+    }
+    return at_enabled;
+}
+
+static int at_take( ULONG64 rip )
+{
+    static LONG counts[4096], total;
+    LONG n = InterlockedIncrement( &counts[(rip ^ (rip >> 12)) & 4095] );
+    if (n > 3 && n % 1000) return 0;
+    return InterlockedIncrement( &total ) <= 6000;
+}
+
+static void at_place( ULONG64 addr, char *out )
+{
+    ULONG_PTR base = (ULONG_PTR)NtCurrentTeb()->Peb->ImageBaseAddress;
+    IMAGE_NT_HEADERS *nt = base ? RtlImageNtHeader( (HMODULE)base ) : NULL;
+    void *mod = NULL;
+
+    if (nt && addr - base < nt->OptionalHeader.SizeOfImage) sprintf( out, "exe+%#I64x", addr - base );
+    else if (RtlPcToFileHeader( (void *)addr, &mod ) && mod) sprintf( out, "%p+%#I64x", mod, addr - (ULONG_PTR)mod );
+    else sprintf( out, "%#I64x", addr );
+}
+
+static void at_note_exception( const EXCEPTION_RECORD *rec, const CONTEXT *ctx )
+{
+    DWORD tid = HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+    void *mod = NULL;
+    char where[48], bytes[16 * 3 + 1] = "";
+    int i;
+
+    if (!at_on()) return;
+    at_last[(tid >> 2) & 1023].tid = tid;
+    at_last[(tid >> 2) & 1023].code = rec->ExceptionCode;
+    at_last[(tid >> 2) & 1023].rip = ctx->Rip;
+    if (!at_take( ctx->Rip )) return;
+    at_place( ctx->Rip, where );
+    if (RtlPcToFileHeader( (void *)ctx->Rip, &mod ) && mod)
+        for (i = 0; i < 12; i++) sprintf( bytes + 3 * i, "%02x ", ((const BYTE *)ctx->Rip)[i] );
+    ERR( "[at-exc] tid %04lx code %08lx at %s bytes %s eflags %#lx rsp %#I64x info %#I64x %#I64x\n", tid,
+         rec->ExceptionCode, where, bytes, ctx->EFlags, ctx->Rsp,
+         rec->NumberParameters > 0 ? (ULONG64)rec->ExceptionInformation[0] : 0,
+         rec->NumberParameters > 1 ? (ULONG64)rec->ExceptionInformation[1] : 0 );
+}
+
+static void at_note_continue( const CONTEXT *ctx )
+{
+    DWORD tid = HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+    char where[48], from[48];
+
+    if (!at_on()) return;
+    if (at_last[(tid >> 2) & 1023].tid == tid && at_last[(tid >> 2) & 1023].code)
+    {
+        ULONG64 rip = at_last[(tid >> 2) & 1023].rip;
+        DWORD code = at_last[(tid >> 2) & 1023].code;
+        at_last[(tid >> 2) & 1023].code = 0;
+        if (!at_take( rip ^ 0x5a5a5a5a5a5aull ) && !(ctx->EFlags & 0x100)) return;
+        at_place( rip, from );
+        at_place( ctx->Rip, where );
+        ERR( "[at-cont] tid %04lx after %08lx at %s resumes at %s (%+I64d bytes) eflags %#lx%s rsp %#I64x\n", tid, code,
+             from, where, (LONG64)(ctx->Rip - rip), ctx->EFlags, (ctx->EFlags & 0x100) ? " TRAP-FLAG" : "", ctx->Rsp );
+    }
+    else if (ctx->EFlags & 0x100 && at_take( ctx->Rip ^ 0x77ull ))
+    {
+        at_place( ctx->Rip, where );
+        ERR( "[at-cont] tid %04lx resumes at %s eflags %#lx TRAP-FLAG (no exception before)\n", tid, where, ctx->EFlags );
+    }
+}
