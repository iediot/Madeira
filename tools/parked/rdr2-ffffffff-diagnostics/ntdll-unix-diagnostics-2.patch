+
+#ifdef WINE_IOS
+/* [wake-trace] (sync.c): the main program's code addresses on this thread's stack, from
+ * the syscall frame's sp up, so a waker can be placed in the game's code. x64 and ARM64EC
+ * code share the thread's stack, so the x64 return addresses are in it. */
+void ios_wake_trace_stack( void )
+{
+    struct syscall_frame *frame = get_syscall_frame();
+    TEB *teb = NtCurrentTeb();
+    const IMAGE_DOS_HEADER *dos;
+    const IMAGE_NT_HEADERS64 *nt;
+    ULONG_PTR base, size, sp, top, p;
+    int hits = 0;
+
+    if (!frame || !teb || !teb->Peb || !(base = (ULONG_PTR)teb->Peb->ImageBaseAddress)) return;
+    dos = (const IMAGE_DOS_HEADER *)base;
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE) return;
+    nt = (const IMAGE_NT_HEADERS64 *)(base + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC) return;
+    size = nt->OptionalHeader.SizeOfImage;
+    sp = frame->sp & ~7ul;
+    top = (ULONG_PTR)teb->Tib.StackBase;
+    if (sp < (ULONG_PTR)teb->Tib.StackLimit || sp >= top) return;
+    if (top - sp > 0x20000) top = sp + 0x20000;
+    for (p = sp; p + 8 <= top && hits < 32; p += 8)
+    {
+        ULONG_PTR v = *(const ULONG_PTR *)p;
+        if (v - base >= size) continue;
+        ERR( "[wake-trace]   [sp+%#lx] exe+%#lx\n", (unsigned long)(p - sp), (unsigned long)(v - base) );
+        hits++;
+    }
+    if (!hits) ERR( "[wake-trace]   no main-program addresses in %#lx bytes of stack (sp %#lx)\n",
+                    (unsigned long)(top - sp), (unsigned long)sp );
+}
+#endif
+
+#ifdef WINE_IOS
+/* [at] anti-tamper trace (env MADEIRA_AT_TRACE=<program name>, e.g. RDR2.exe): the
+ * queries an anti-tamper or anti-debug guard makes about the process, its threads, the
+ * system and its own memory, from the named program only, each with what it was told
+ * and where in the program it asked from. Rate-limited per call type. */
+int ios_at_on( void )
+{
+    static void *cached_peb;
+    static int cached_on;
+    TEB *teb = NtCurrentTeb();
+    const char *want;
+    PEB *peb;
+
+    if (!teb || !(peb = teb->Peb)) return 0;
+    if (peb == __atomic_load_n( &cached_peb, __ATOMIC_ACQUIRE )) return cached_on;
+    want = getenv( "MADEIRA_AT_TRACE" );
+    cached_on = 0;
+    if (want && *want && peb->ProcessParameters && peb->ProcessParameters->ImagePathName.Buffer)
+    {
+        const WCHAR *p = peb->ProcessParameters->ImagePathName.Buffer;
+        size_t n = peb->ProcessParameters->ImagePathName.Length / sizeof(WCHAR), w = strlen( want ), i;
+        if (n >= w)
+        {
+            for (i = 0; i < w; i++)
+            {
+                WCHAR c = p[n - w + i], d = (unsigned char)want[i];
+                if (c >= 'A' && c <= 'Z') c += 32;
+                if (d >= 'A' && d <= 'Z') d += 32;
+                if (c != d) break;
+            }
+            cached_on = (i == w);
+        }
+    }
+    if (cached_on)
+        ERR( "[at] tracing this process: BeingDebugged=%u NtGlobalFlag=%#x heap=%p\n", peb->BeingDebugged,
+             (unsigned)peb->NtGlobalFlag, peb->ProcessHeap );
+    __atomic_store_n( &cached_peb, peb, __ATOMIC_RELEASE );
+    return cached_on;
+}
+
+/* 1 = log this one: the first 40 of each key, then every 500th; 30000 lines in all */
+int ios_at_take( unsigned key )
+{
+    static LONG counts[1024], total;
+    LONG n = __sync_add_and_fetch( &counts[key % 1024], 1 );
+    if (n > 40 && n % 500) return 0;
+    return __sync_add_and_fetch( &total, 1 ) <= 30000;
+}
+
+/* where in the main program the call came from: its first 6 code addresses on the stack */
+void ios_at_where( char *out, size_t outlen )
+{
+    struct syscall_frame *frame = get_syscall_frame();
+    TEB *teb = NtCurrentTeb();
+    const IMAGE_DOS_HEADER *dos;
+    const IMAGE_NT_HEADERS64 *nt;
+    ULONG_PTR base, size, sp, top, p;
+    size_t off = 0;
+    int hits = 0;
+
+    out[0] = 0;
+    if (!frame || !teb || !teb->Peb || !(base = (ULONG_PTR)teb->Peb->ImageBaseAddress)) return;
+    dos = (const IMAGE_DOS_HEADER *)base;
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE) return;
+    nt = (const IMAGE_NT_HEADERS64 *)(base + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC) return;
+    size = nt->OptionalHeader.SizeOfImage;
+    sp = frame->sp & ~7ul;
+    top = (ULONG_PTR)teb->Tib.StackBase;
+    if (sp < (ULONG_PTR)teb->Tib.StackLimit || sp >= top) return;
+    if (top - sp > 0x4000) top = sp + 0x4000;
+    for (p = sp; p + 8 <= top && hits < 6 && off + 24 < outlen; p += 8)
+    {
+        ULONG_PTR v = *(const ULONG_PTR *)p;
+        if (v - base < 0x1000 || v - base >= size) continue;
+        off += snprintf( out + off, outlen - off, " exe+%#lx", (unsigned long)(v - base) );
+        hits++;
+    }
+}
+
+void ios_at_hex( char *out, const void *data, size_t len, size_t max )
+{
+    size_t i, off = 0;
+    out[0] = 0;
+    if (!data) return;
+    if (len > max) len = max;
+    for (i = 0; i < len; i++) off += sprintf( out + off, "%02x", ((const unsigned char *)data)[i] );
+}
+#endif
+
+#ifdef WINE_IOS
+/* [at-close]: the code addresses on this thread's stack, named by module (the PEB loader
+ * list, read without the loader lock: a diagnostic, racy against a concurrent unload). */
+void ios_at_where_mod( char *out, size_t outlen )
+{
+    struct syscall_frame *frame = get_syscall_frame();
+    TEB *teb = NtCurrentTeb();
+    ULONG_PTR sp, top, p, last = 0;
+    size_t off = 0;
+    int hits = 0;
+
+    out[0] = 0;
+    if (!frame || !teb || !teb->Peb || !teb->Peb->LdrData) return;
+    sp = frame->sp & ~7ul;
+    top = (ULONG_PTR)teb->Tib.StackBase;
+    if (sp < (ULONG_PTR)teb->Tib.StackLimit || sp >= top) return;
+    if (top - sp > 0x4000) top = sp + 0x4000;
+    for (p = sp; p + 8 <= top && hits < 10 && off + 80 < outlen; p += 8)
+    {
+        ULONG_PTR v = *(const ULONG_PTR *)p;
+        LIST_ENTRY *head = &teb->Peb->LdrData->InLoadOrderModuleList, *e;
+        int n = 0;
+        for (e = head->Flink; e && e != head && n < 512; e = e->Flink, n++)
+        {
+            LDR_DATA_TABLE_ENTRY *m = CONTAINING_RECORD( e, LDR_DATA_TABLE_ENTRY, InLoadOrderLinks );
+            ULONG_PTR base = (ULONG_PTR)m->DllBase;
+            if (v - base >= 0x1000 && v - base < m->SizeOfImage)
+            {
+                char name[40];
+                int i, len = m->BaseDllName.Length / sizeof(WCHAR);
+                if (base == last) break;   /* one entry per module run */
+                for (i = 0; i < len && i < 39; i++) name[i] = (char)m->BaseDllName.Buffer[i];
+                name[i] = 0;
+                off += snprintf( out + off, outlen - off, " %s+%#lx", name, (unsigned long)(v - base) );
+                last = base;
+                hits++;
+                break;
+            }
+        }
+    }
+}
+#endif
