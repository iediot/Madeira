diff --git a/build/ntdll-unix/server_ios.c b/build/ntdll-unix/server_ios.c
index dcb65df9..48076652 100644
--- a/build/ntdll-unix/server_ios.c
+++ b/build/ntdll-unix/server_ios.c
@@ -3758,6 +3758,27 @@ static int remove_fd_from_cache( HANDLE handle )
 
 
 #ifdef WINE_IOS
+/* [at-close] (MADEIRA_AT_TRACE): a close of a handle whose cached descriptor is a game
+ * data file (.rpf, or anything under Program Files), with the modules on the closing
+ * thread's stack. RDR2's streamer read a handle that had stopped being a file (0x37c,
+ * STATUS_OBJECT_TYPE_MISMATCH), so something in its process closes its archives.
+ * Caller holds fd_cache_mutex: peek the cache, take no lock. */
+void ios_at_note_close( HANDLE handle, const char *how )
+{
+    extern int ios_at_on( void );
+    extern void ios_at_where_mod( char *out, size_t outlen );
+    enum server_fd_type type;
+    char path[1024], where[512];
+    int fd = -1;
+
+    if (!ios_at_on()) return;
+    if (get_cached_fd( handle, &fd, &type, NULL, NULL ) || fd < 0 || type != FD_TYPE_FILE) return;
+    if (fcntl( fd, F_GETPATH, path ) == -1) return;
+    if (!strstr( path, ".rpf" ) && !strstr( path, ".RPF" )) return;
+    ios_at_where_mod( where, sizeof(where) );
+    ERR( "[at-close] %s(%p) fd %d %s by%s\n", how, handle, fd, path, where );
+}
+
 /* madeira-bcd: get_handle_fd hands the descriptor over in its reply (build/wineserver/
  * fd_ios.c). The server is a thread of this process and shares its descriptor table, so
  * the copy it makes with F_DUPFD_CLOEXEC is what SCM_RIGHTS through the process socket
@@ -5714,6 +5735,12 @@ NTSTATUS WINAPI NtDuplicateObject( HANDLE source_process, HANDLE source, HANDLE
      * retrieve it again */
     if (options & DUPLICATE_CLOSE_SOURCE)
     {
+#ifdef WINE_IOS
+        {
+            extern void ios_at_note_close( HANDLE handle, const char *how );
+            ios_at_note_close( source, "DuplicateObject(CLOSE_SOURCE)" );
+        }
+#endif
         fd = remove_fd_from_cache( source );
         close_inproc_sync( source );
     }
@@ -5788,6 +5815,12 @@ NTSTATUS WINAPI NtClose( HANDLE handle )
 
     /* always remove the cached fd; if the server request fails we'll just
      * retrieve it again */
+#ifdef WINE_IOS
+    {
+        extern void ios_at_note_close( HANDLE handle, const char *how );
+        ios_at_note_close( handle, "NtClose" );
+    }
+#endif
     fd = remove_fd_from_cache( handle );
     close_inproc_sync( handle );
 
