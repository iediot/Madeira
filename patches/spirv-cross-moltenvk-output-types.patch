+// Keep shader arithmetic and output reads in the original type. Convert only
+// when returning the completed interface, after component/array flattening and padding.
+SPIRType CompilerMSL::fragment_output_type(const SPIRType &type, uint32_t index)
+{
+	auto result = get<SPIRType>(type.member_types[index]);
+	if (!has_member_decoration(type.self, index, DecorationLocation) ||
+	    has_member_decoration(type.self, index, DecorationBuiltIn))
+		return result;
+	auto itr = fragment_output_types.find(get_member_decoration(type.self, index, DecorationLocation));
+	if (itr == end(fragment_output_types) || itr->second == SPIRType::Unknown)
+		return result;
+	auto base = result.basetype;
+	bool matches = itr->second == SPIRType::Float ? (base == SPIRType::Float || base == SPIRType::Half) :
+	               itr->second == SPIRType::UInt ? (base == SPIRType::UInt || base == SPIRType::UShort || base == SPIRType::UByte) :
+	               (base == SPIRType::Int || base == SPIRType::Short || base == SPIRType::SByte);
+	if (!matches)
+	{
+		result.basetype = itr->second;
+		result.width = 32;
+	}
+	return result;
+}
+
 // Emit a structure declaration for the specified interface variable.
 void CompilerMSL::emit_interface_block(uint32_t ib_var_id)
 {
@@ -12109,6 +12133,44 @@ void CompilerMSL::emit_interface_block(uint32_t ib_var_id)
 		//assert(ib_type.basetype == SPIRType::Struct && !ib_type.member_types.empty());
 		assert(ib_type.basetype == SPIRType::Struct);
 		emit_struct(ib_type);
+		if (ib_var_id != stage_out_var_id || get_entry_point().model != ExecutionModelFragment)
+			return;
+		fragment_output_type_name.clear();
+		bool remapped = false;
+		for (uint32_t i = 0; i < ib_type.member_types.size(); i++)
+			remapped |= fragment_output_type(ib_type, i).basetype != get<SPIRType>(ib_type.member_types[i]).basetype;
+		if (!remapped)
+			return;
+
+		fragment_output_type_name = type_to_glsl(ib_type) + "_attachment";
+		statement("struct ", fragment_output_type_name);
+		begin_scope();
+		for (uint32_t i = 0; i < ib_type.member_types.size(); i++)
+		{
+			auto target = fragment_output_type(ib_type, i);
+			statement(type_to_glsl(target), " ", to_member_name(ib_type, i),
+			          member_attribute_qualifier(ib_type, i), ";");
+		}
+		statement(fragment_output_type_name, "(thread const ", type_to_glsl(ib_type), "& value)");
+		begin_scope();
+		for (uint32_t i = 0; i < ib_type.member_types.size(); i++)
+		{
+			auto target = fragment_output_type(ib_type, i);
+			auto name = to_member_name(ib_type, i);
+			// A desktop GPU stores the raw bits of a mismatched output (a float written
+			// to an R32_UINT target keeps its bit pattern: packed velocities, IDs), so
+			// reinterpret when the sizes match; convert only when they cannot be.
+			auto &source = get<SPIRType>(ib_type.member_types[i]);
+			if (target.basetype != source.basetype && target.vecsize == source.vecsize && target.width == source.width)
+				statement(name, " = as_type<", type_to_glsl(target), ">(value.", name, ");");
+			else if (target.basetype != source.basetype)
+				statement(name, " = ", type_to_glsl(target), "(value.", name, ");");
+			else
+				statement(name, " = value.", name, ";");
+		}
+		end_scope();
+		end_scope_decl();
+		statement("");
 	}
 }
 
