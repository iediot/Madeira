+    if (!rt) continue;
+    smbTraceSurface("draw-target", rt.ptr());
+    auto &record = m_smbTextures[rt->dxmtTexture().ptr()];
+    record.texture = rt->dxmtTexture();
+    ++record.draws;
+    bool seen = false;
+    for (auto &old : m_smbTargets) seen |= old.ptr() == rt.ptr();
