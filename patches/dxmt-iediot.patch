+  else if (f >= 1 && f <= 4) bpb = 16;                                              /* R32G32B32A32 */
+  else if (f >= 5 && f <= 8) bpb = 12;                                              /* R32G32B32 */
+  else if (f >= 9 && f <= 22) bpb = 8;                                              /* 64-bit */
+  else if (f >= 48 && f <= 59) bpb = 2;                                             /* R8G8, R16 */
