+    auto *t = m_textures[i].ptr();
+    if (!t || !t->dxmtTexture()) continue;
+    auto &record = m_smbTextures[t->dxmtTexture().ptr()];
+    record.texture = t->dxmtTexture();
+    Logger::info(str::format("[smb] sampler=", i, " tex=", t->dxmtTexture().ptr(),
