+
+static void mvkMadeiraVMUsageSnapshot(MVKMadeiraVMUsage tags[256], MVKMadeiraVMUsage& jitRX,
+									  MVKMadeiraVMUsage& jitRW) {
+	uint64_t rx = mvkMadeiraParseAddress("WINE_IOS_JIT_RX");
+	uint64_t rw = mvkMadeiraParseAddress("WINE_IOS_JIT_RW");
+	uint64_t jitSize = mvkMadeiraParseAddress("WINE_IOS_JIT_SIZE");
+	mach_vm_address_t address = 0;
+	natural_t depth = 0;
+	for (unsigned guard = 0; guard < 131072; ++guard) {
+		vm_region_submap_info_data_64_t info = {};
+		mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_COUNT_64;
+		mach_vm_size_t size = 0;
+		if (mach_vm_region_recurse(mach_task_self(), &address, &size, &depth,
+								   (vm_region_recurse_info_t)&info, &count) != KERN_SUCCESS) break;
+		if (info.is_submap) { ++depth; continue; }
+		uint64_t pageSize = vm_page_size;
+		MVKMadeiraVMUsage usage = { (uint64_t)info.pages_resident * pageSize,
+			(uint64_t)info.pages_dirtied * pageSize, (uint64_t)info.pages_swapped_out * pageSize };
+		auto& tag = tags[info.user_tag & 255];
+		tag.resident += usage.resident; tag.dirty += usage.dirty; tag.swapped += usage.swapped;
+		uint64_t end = address + size;
+		auto overlaps = [&](uint64_t base) { return base && jitSize && address < base + jitSize && end > base; };
+		if (overlaps(rx)) { jitRX.resident += usage.resident; jitRX.dirty += usage.dirty; jitRX.swapped += usage.swapped; }
+		if (overlaps(rw)) { jitRW.resident += usage.resident; jitRW.dirty += usage.dirty; jitRW.swapped += usage.swapped; }
+		if (!size || end <= address) break;
+		address = end;
+		depth = 0;
+	}
+}
+
+static unsigned mvkMadeiraMallocZoneSnapshot(MVKMadeiraMallocZoneUsage usages[32],
+										 uint64_t& used, uint64_t& allocated) {
+	vm_address_t* addresses = nullptr;
+	unsigned count = 0;
+	used = allocated = 0;
+	if (malloc_get_all_zones(mach_task_self(), nullptr, &addresses, &count) != KERN_SUCCESS) return 0;
+	unsigned reported = std::min(count, 32u);
+	for (unsigned i = 0; i < count; ++i) {
+		auto zone = (malloc_zone_t*)addresses[i];
+		malloc_statistics_t stats = {};
+		malloc_zone_statistics(zone, &stats);
+		used += stats.size_in_use;
+		allocated += stats.size_allocated;
+		if (i >= reported) continue;
+		const char* name = malloc_get_zone_name(zone);
+		if (!name) name = "unnamed";
+		for (unsigned j = 0; name[j] && j + 1 < sizeof(usages[i].name); ++j) {
+			char c = name[j];
+			usages[i].name[j] = (c == ' ' || c == ',' || c == '=') ? '_' : c;
+		}
+		usages[i].used = stats.size_in_use;
+		usages[i].allocated = stats.size_allocated;
+	}
+	return reported;
+}
