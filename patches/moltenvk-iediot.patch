+/** Describes a texture as Metal sees it. The texture must be valid. */
+static void mvkMadeiraDumpTextureJSON(std::string& json, id<MTLTexture> tex, MVKPixelFormats* pixFmts) {
+	json += "{\"ptr\":";
+	mvkMadeiraJSONPtr(json, tex);
+	json += ",\"label\":";
+	mvkMadeiraJSON(json, tex.label);
+	MVKMadeiraDumpFormat fmt = { nullptr, 0, MTLBlitOptionNone };
+	bool known = mvkMadeiraDumpFormat(tex.pixelFormat, fmt);
+	char buf[256];
+	snprintf(buf, sizeof(buf), ",\"type\":%lu,\"format\":%lu,\"formatName\":", (unsigned long)tex.textureType, (unsigned long)tex.pixelFormat);
+	json += buf;
+	mvkMadeiraJSON(json, known ? fmt.name : (pixFmts ? pixFmts->getName(tex.pixelFormat) : nullptr));
+	snprintf(buf, sizeof(buf), ",\"size\":[%lu,%lu,%lu,%lu],\"mips\":%lu,\"samples\":%lu,\"usage\":%lu,\"storageMode\":%lu",
+			 (unsigned long)tex.width, (unsigned long)tex.height, (unsigned long)tex.depth, (unsigned long)tex.arrayLength,
+			 (unsigned long)tex.mipmapLevelCount, (unsigned long)tex.sampleCount, (unsigned long)tex.usage, (unsigned long)tex.storageMode);
+	json += buf;
+	// A sampled view names the texture an earlier pass wrote (texture.ptr / parentTexture of its entries).
+	if (id<MTLTexture> parent = tex.parentTexture) {
+		json += ",\"parentTexture\":";
+		mvkMadeiraJSONPtr(json, parent);
+		snprintf(buf, sizeof(buf), ",\"parentFormat\":%lu,\"parentFormatName\":", (unsigned long)parent.pixelFormat);
+		json += buf;
+		mvkMadeiraJSON(json, pixFmts ? pixFmts->getName(parent.pixelFormat) : nullptr);
+		snprintf(buf, sizeof(buf), ",\"parentSize\":[%lu,%lu,%lu,%lu],\"parentMips\":%lu,\"levels\":[%lu,%lu],\"slices\":[%lu,%lu]",
+				 (unsigned long)parent.width, (unsigned long)parent.height, (unsigned long)parent.depth, (unsigned long)parent.arrayLength,
+				 (unsigned long)parent.mipmapLevelCount, (unsigned long)tex.parentRelativeLevel, (unsigned long)tex.mipmapLevelCount,
+				 (unsigned long)tex.parentRelativeSlice, (unsigned long)tex.arrayLength);
+		json += buf;
+	}
+	if (id<MTLBuffer> buff = tex.buffer) {
+		json += ",\"buffer\":";
+		mvkMadeiraJSONPtr(json, buff);
+		snprintf(buf, sizeof(buf), ",\"bufferOffset\":%lu,\"bufferBytesPerRow\":%lu", (unsigned long)tex.bufferOffset, (unsigned long)tex.bufferBytesPerRow);
+		json += buf;
+	}
+	json += "}";
+}
+
+static id<MTLTexture> mvkMadeiraDumpRoot(id<MTLTexture> tex) {
+	while (id<MTLTexture> parent = tex.parentTexture) { tex = parent; }
+	return tex;
+}
