+// The storage images of every descriptor set the bound compute pipeline reads, as the
+// binding code walks them: the first id of a storage-image descriptor is its MTLTexture.
+void MVKCommandEncoder::madeiraDumpDispatch(MTLSize threadgroups, MTLSize threadsPerThreadgroup, bool indirect) {
+	if ( !_madeiraDump || !_mtlCmdBuffer ) { return; }
+	MVKComputePipeline* pipeline = getComputePipeline();
+	const MVKVulkanComputeCommandEncoderState& vkCompute = getVkCompute();
+	std::vector<MVKMadeiraDumpTarget> targets;
+	if (pipeline && vkCompute._layout) {
+		const MVKPipelineStageResourceInfo& resources = pipeline->getStageResources();
+		bool used[kMVKMaxDescriptorSetCount] = {};
+		for (size_t idx : resources.resources.descriptorSetData) { if (idx < kMVKMaxDescriptorSetCount) { used[idx] = true; } }
+		for (const MVKDescriptorBindOperation& op : resources.bindScript.ops) { used[op.set] = true; }
+		MVKLiveResourceSet& live = getDevice()->getLiveResources();
+		size_t setCount = std::min<size_t>(vkCompute._layout->getDescriptorSetCount(), kMVKMaxDescriptorSetCount);
+		for (size_t setIdx = 0; setIdx < setCount; setIdx++) {
+			if ( !used[setIdx] ) { continue; }
+			MVKDescriptorSet* set = vkCompute._descriptorSets[setIdx];
+			const MVKDescriptorSetLayout* setLayout = vkCompute._layout->getDescriptorSetLayout(setIdx);
+			if ( !set || !set->cpuBuffer || !setLayout ) { continue; }
+			for (const MVKDescriptorBinding& binding : setLayout->bindings()) {
+				if (binding.descriptorType != VK_DESCRIPTOR_TYPE_STORAGE_IMAGE) { continue; }
+				if ( !mvkIsAnyFlagEnabled(binding.stageFlags, VK_SHADER_STAGE_COMPUTE_BIT) ) { continue; }
+				size_t stride = descriptorCPUSize(binding.cpuLayout);
+				if (stride < sizeof(id)) { continue; }
+				uint32_t count = std::min<uint32_t>(binding.isVariable() ? set->variableDescriptorCount : binding.descriptorCount, 8);
+				for (uint32_t i = 0; i < count; i++) {
+					id<MTLTexture> tex = *reinterpret_cast<const id*>(set->cpuBuffer + binding.cpuOffset + i * stride);
+					if ( !tex ) { continue; }
+					char slot[48];
+					snprintf(slot, sizeof(slot), "set%zu-binding%u-%u", setIdx, binding.binding, i);
+					if (live.enabled) {
+						auto isLive = live.isLive(tex);	// holds the live list's lock while retaining
+						if (isLive) { mvkMadeiraDumpAddTarget(targets, tex, 0, 0, 0, slot); }
+					} else {
+						mvkMadeiraDumpAddTarget(targets, tex, 0, 0, 0, slot);
+					}
+				}
+			}
+		}
+	}
+
+	std::string fields = "\"encoder\":";
+	mvkMadeiraJSON(fields, mvkMTLComputeCommandEncoderLabel(kMVKCommandUseDispatch));
+	fields += ",\"use\":";
+	mvkMadeiraJSON(fields, indirect ? "vkCmdDispatchIndirect" : "vkCmdDispatch");
+	std::vector<std::string> pipelines;
+	if (pipeline) {
+		id<MTLComputePipelineState> mtlPS = getMtlCompute()._pipeline;
+		pipelines.push_back(mvkMadeiraDumpPipelineJSON(pipeline, mtlPS, mtlPS.label, pipeline->getDebugName()));
+	}
+	mvkMadeiraDumpJoin(fields, "pipelines", pipelines);
+	char buf[160];
+	if (indirect) {
+		snprintf(buf, sizeof(buf), ",\"threadgroups\":\"indirect\"");
+	} else {
+		snprintf(buf, sizeof(buf), ",\"threadgroups\":[%lu,%lu,%lu]",
+				 (unsigned long)threadgroups.width, (unsigned long)threadgroups.height, (unsigned long)threadgroups.depth);
+	}
+	fields += buf;
+	snprintf(buf, sizeof(buf), ",\"threadsPerThreadgroup\":[%lu,%lu,%lu]",
+			 (unsigned long)threadsPerThreadgroup.width, (unsigned long)threadsPerThreadgroup.height, (unsigned long)threadsPerThreadgroup.depth);
+	fields += buf;
+
+	// End the compute encoder only when there is something to copy; MoltenVK rebinds on the next one.
+	if ( !targets.empty() ) { endCurrentMetalEncoding(); }
+	mvkMadeiraDumpEncode(_madeiraDump, _mtlCmdBuffer, "compute", fields, targets);
+}
