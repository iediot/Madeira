+	bytes += config.shaderInputs.capacity() * sizeof(MSLShaderInterfaceVariable);
+	bytes += config.shaderOutputs.capacity() * sizeof(MSLShaderInterfaceVariable);
+	bytes += config.resourceBindings.capacity() * sizeof(MSLResourceBinding);
+	bytes += config.discreteDescriptorSets.capacity() * sizeof(uint32_t);
+	bytes += config.dynamicBufferDescriptors.capacity() * sizeof(DescriptorBinding);
+	bytes += config.fragmentOutputTypes.capacity() * sizeof(SPIRV_CROSS_NAMESPACE::SPIRType::BaseType);
+	for (auto& macro : result.resultInfo.specializationMacros) {
+		bytes += sizeof(macro) + 64 + macro.second.name.capacity();
+	}
+	return bytes;
+}
