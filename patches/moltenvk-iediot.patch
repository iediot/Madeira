+bool MVKGraphicsPipeline::shouldSkipDraw(uint32_t vertexCount, uint32_t instanceCount,
+										 bool onlyDrawInSubpass, uint32_t drawCount) {
+	unique_lock<mutex> lock(_asyncPipelineLock);
+	if (_asyncPipelinePending) {
+		// Diagnostic correctness mode: keep async creation but never omit a draw
+		// because its shader is late. This intentionally trades pop-in for waits.
+		static bool noSkip = [] {
+			const char* value = getenv("MVK_MADEIRA_ASYNC_NO_SKIP");
+			return value && value[0] == '1';
+		}();
+		if (noSkip) {
+			uint64_t waitID = getDevice()->beginAsyncPipelineWait(_asyncPipelineKeys);
+			uint64_t start = mvkTimeNow();
+			_asyncPipelineCV.wait(lock, [&]{ return !_asyncPipelinePending; });
+			getDevice()->endAsyncPipelineWait(waitID);
+			uint64_t elapsed = mvkTimeNow() - start;
+			if (elapsed >= 5000000ull) {
+				fprintf(stderr, "[mvk-graphics-check] no-skip wait_ms=%.1f failed=%d draws=%u\n",
+					elapsed / 1e6, _asyncPipelineFailed, drawCount);
+			}
+		}
+	}
+	if (_asyncPipelinePending) {
+		// Madeira: a draw makes all of its queued variants urgent. The scheduler's
+		// deque gives newly needed work LIFO behavior without duplicating compiles.
+		for (const auto& key : _asyncPipelineKeys) { getDevice()->prioritizeAsyncPipeline(key); }
+
+		bool fullscreen = onlyDrawInSubpass ||
+			((_vkVertexBuffers.bits() == 0 || !_madeiraHasVertexInput) &&
+			 (vertexCount == 3 || vertexCount == 4) && instanceCount == 1);
+		uint32_t waitMS = 0;
+		uint32_t reservedBudgetMS = 0;
+		bool budgetWait = false;
+		if (fullscreen) {
+			waitMS = getDevice()->asyncPipelineFullscreenWaitMS();
+		} else {
+			waitMS = getDevice()->reserveAsyncPipelineFrameBudgetMS();
+			reservedBudgetMS = waitMS;
+			budgetWait = waitMS != 0;
+			// Madeira: preserve the old one-time wait knob as a minimum first wait.
+			if (!_asyncPipelineWaitAttempted) { waitMS = std::max(waitMS, getDevice()->asyncPipelineWaitMS()); }
+		}
+		_asyncPipelineWaitAttempted = true;
+		if (waitMS) {
+			// Madeira: reserve compiler throughput for a full-screen dependency and
+			// keep it urgent through completion even if this bounded wait expires.
+			uint64_t urgentWaitID = fullscreen ? getDevice()->beginAsyncPipelineWait(_asyncPipelineKeys) : 0;
+			uint64_t start = mvkTimeNow();
+			_asyncPipelineCV.wait_for(lock, chrono::milliseconds(waitMS), [&]{ return !_asyncPipelinePending; });
+			uint64_t elapsed = mvkTimeNow() - start;
+			if (fullscreen) {
+				MVKAsyncPipelineWaitInfo info = getDevice()->endAsyncPipelineWait(urgentWaitID);
+				mvkTimeAsyncFullscreenWait(elapsed);
+				if (elapsed > 100000000ull) {
+					fprintf(stderr, "[mvk-async] fullscreen-wait %llu ms (job queued %llu ms, compiled %llu ms, urgent-queued %llu ms, depth %u)\n",
+							(unsigned long long)(elapsed / 1000000ull),
+							(unsigned long long)(info.queuedNS / 1000000ull),
+							(unsigned long long)(info.compiledNS / 1000000ull),
+							(unsigned long long)(info.urgentQueuedNS / 1000000ull), info.queueDepth);
+				}
+			} else if (budgetWait) {
+				uint64_t reserved = (uint64_t)reservedBudgetMS * 1000000ull;
+				if (elapsed < reserved) { getDevice()->refundAsyncPipelineFrameBudgetNS(reserved - elapsed); }
+				mvkTimeAsyncBudgetWait(elapsed);
+			}
+		}
+	}
+	bool skip = _asyncPipelinePending || _asyncPipelineFailed;
+	lock.unlock();
+	if (skip) { mvkTimeAsyncSkippedDraw(drawCount); }
+	return skip;
+}
