+void MVKDevice::trackMemoryAllocation(MVKMemoryAllocationType type, uint64_t bytes) {
+	auto& counter = _memoryCounters[(size_t)type];
+	counter.count.fetch_add(1, std::memory_order_relaxed);
+	counter.bytes.fetch_add(bytes, std::memory_order_relaxed);
+}
+
+void MVKDevice::trackMemoryRelease(MVKMemoryAllocationType type, uint64_t bytes) {
+	auto& counter = _memoryCounters[(size_t)type];
+	counter.bytes.fetch_sub(bytes, std::memory_order_relaxed);
+	counter.count.fetch_sub(1, std::memory_order_relaxed);
+}
+
+void MVKDevice::trackPipeline(bool allocated) {
+	if (allocated) { _livePipelines.fetch_add(1, std::memory_order_relaxed); }
+	else { _livePipelines.fetch_sub(1, std::memory_order_relaxed); }
+}
+
+void MVKDevice::trackPipelineCache(bool allocated) {
+	if (allocated) { _livePipelineCaches.fetch_add(1, std::memory_order_relaxed); }
+	else { _livePipelineCaches.fetch_sub(1, std::memory_order_relaxed); }
+}
+
+static void mvkAddMemoryCount(std::atomic<uint64_t>& value, int64_t delta) {
+	if (delta >= 0) { value.fetch_add((uint64_t)delta, std::memory_order_relaxed); }
+	else { value.fetch_sub((uint64_t)-delta, std::memory_order_relaxed); }
+}
