+static bool mvkMadeiraUpdateMemoryPressure(uint64_t available) {
+	static std::mutex lock;
+	static MVKMadeiraMemoryPressurePolicy policy;
+	std::lock_guard<std::mutex> guard(lock);
+	uint64_t now = std::chrono::duration_cast<std::chrono::milliseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+	bool changed = policy.update(available, now);
+	g_mvkMemoryPressure.store(policy.active, std::memory_order_relaxed);
