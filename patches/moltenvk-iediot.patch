+void MVKDevice::startMemoryLogging() {
+	const char* enabled = getenv("MVK_MADEIRA_MEMORY_LOG");
+	_memoryLogEnabled = !enabled || strcmp(enabled, "0");
+	const char* pressure = getenv("MVK_MADEIRA_MEMORY_PRESSURE");
+	_memoryPressureEnabled = !pressure || strcmp(pressure, "0");
+	fprintf(stderr, "[mvk-memory] enabled=%d interval=30s (MVK_MADEIRA_MEMORY_LOG=0 disables)\n", _memoryLogEnabled);
+	fprintf(stderr, "[mvk-memory-pressure] enabled=%d low=512MiB recover=1024MiB/30s interval=2s conversion=%lluMiB malloc-relief=%s\n",
+		_memoryPressureEnabled, (unsigned long long)(mvkMadeiraConversionPressureBytes() >> 20),
+		mvkMadeiraMallocPressureReliefEnabled() ? "on" : "off");
+	if (!_memoryLogEnabled && !_memoryPressureEnabled) { return; }
+#if MVK_IOS
+	const char* source = getenv("MVK_MADEIRA_MEMORYPRESSURE_SOURCE");
+	if (_memoryPressureEnabled && (!source || strcmp(source, "0"))) {
+		_memoryPressureQueue = dispatch_queue_create("MoltenVK.memory-pressure", DISPATCH_QUEUE_SERIAL);
+		dispatch_set_target_queue(_memoryPressureQueue, dispatch_get_global_queue(QOS_CLASS_UTILITY, 0));
+		_memoryPressureSource = dispatch_source_create(DISPATCH_SOURCE_TYPE_MEMORYPRESSURE, 0,
+			DISPATCH_MEMORYPRESSURE_WARN | DISPATCH_MEMORYPRESSURE_CRITICAL, _memoryPressureQueue);
+		dispatch_source_set_event_handler(_memoryPressureSource, ^{
+			unsigned long event = dispatch_source_get_data(_memoryPressureSource);
+			g_mvkMemoryPressure.store(true, std::memory_order_relaxed);
+			trimMemoryCaches();
+			size_t relieved = mvkMadeiraRelieveMallocPressure();
+			fprintf(stderr, "[mvk-memory-pressure] dispatch=%s malloc_relief_bytes=%llu\n",
+				(event & DISPATCH_MEMORYPRESSURE_CRITICAL) ? "critical" : "warn", (unsigned long long)relieved);
+		});
+		dispatch_resume(_memoryPressureSource);
+	}
+#endif
+	_memoryLogThread = std::thread([this] {
+		pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+		unsigned ticks = 0;
+		std::unique_lock<std::mutex> lock(_memoryLogLock);
+		while (!_memoryLogCondition.wait_for(lock, std::chrono::seconds(2), [this] { return _memoryLogStop; })) {
+			lock.unlock();
+			@autoreleasepool {
+#if MVK_IOS
+				if (_memoryPressureEnabled) {
+					uint64_t available = os_proc_available_memory();
+					if (mvkMadeiraUpdateMemoryPressure(available)) {
+						fprintf(stderr, "[mvk-memory-pressure] active=%d available_mib=%llu (cache references only; disk preserved)\n",
+							mvkMadeiraMemoryPressureActive(), (unsigned long long)(available >> 20));
+						if (mvkMadeiraMemoryPressureActive()) {
+							if (mvkMadeiraMallocPressureReliefEnabled()) {
+								size_t bytes = mvkMadeiraRelieveMallocPressure();
+								fprintf(stderr, "[mvk-memory-pressure] malloc_relief_bytes=%llu\n", (unsigned long long)bytes);
+							}
+						}
+					}
+					if (mvkMadeiraMemoryPressureActive()) trimMemoryCaches();
+				}
+#endif
+				if (_memoryLogEnabled && ++ticks % 15 == 0) logMemoryBreakdown();
+			}
+			lock.lock();
+		}
+	});
+}
+
+void MVKDevice::stopMemoryLogging() {
+#if MVK_IOS
+	if (_memoryPressureSource) {
+		dispatch_source_set_event_handler(_memoryPressureSource, ^{});
+		dispatch_source_cancel(_memoryPressureSource);
+		dispatch_sync(_memoryPressureQueue, ^{});
+		dispatch_release(_memoryPressureSource);
+		dispatch_release(_memoryPressureQueue);
+		_memoryPressureSource = nullptr;
+		_memoryPressureQueue = nullptr;
+	}
+#endif
+	if (!_memoryLogThread.joinable()) { return; }
+	{
+		std::lock_guard<std::mutex> lock(_memoryLogLock);
+		_memoryLogStop = true;
+	}
+	_memoryLogCondition.notify_one();
+	if (_memoryLogThread.joinable()) { _memoryLogThread.join(); }
+}
+
+// Madeira: one device-wide scheduler owns each queued descriptor and compiles a PSO
+// key once. Re-created Vulkan pipelines subscribe to the same job, and a draw can
+// move a queued job to the front without consuming another worker.
+class MVKAsyncPipelineScheduler {
+public:
+	typedef void (^RenderCompletion)(id<MTLRenderPipelineState>);
+	typedef void (^ComputeCompletion)(id<MTLComputePipelineState>);
+	struct Job {
+		std::string key;
+		id descriptor;
+		bool compute;
+		std::vector<RenderCompletion> renderCompletions;
+		std::vector<ComputeCompletion> computeCompletions;
+		bool running = false;
+		uint64_t queuedAt = 0;
+		uint64_t compileStartedAt = 0;
+		pthread_t worker = nullptr;
+		pthread_override_t qosOverride = nullptr;
+		std::unordered_set<uint64_t> urgentWaits;
+		uint64_t ownedMinBytes = 0;
+	};
+	struct WaitRecord {
+		std::vector<std::string> keys;
+		MVKAsyncPipelineWaitInfo info;
+		uint64_t requestedAt = 0;
+	};
+
+	MVKAsyncPipelineScheduler(MVKDevice* device, uint32_t threadCount) : _device(device) {
+		for (uint32_t i = 0; i < threadCount; ++i) { _workers.emplace_back([this]{ worker(); }); }
+		// One bounded, normally idle lane stays available for a blocking dependency.
+		_workers.emplace_back([this]{ worker(true); });
+		fprintf(stderr, "[mvk-async] workers=%u background + 1 urgent-only\n", threadCount);
+		fprintf(stderr, "[mvk-async-admission] enabled=%d max_jobs=%zu pressure_jobs=%zu (experimental blocking admission)\n",
+			mvkMadeiraAdmissionEnabled(), mvkMadeiraAdmissionCapacity(false), mvkMadeiraAdmissionCapacity(true));
+	}
+
+	~MVKAsyncPipelineScheduler() {
+		{
+			std::lock_guard<std::mutex> lock(_lock);
+			_stopping = true;
+		}
+		_cv.notify_all();
+		for (auto& worker : _workers) { worker.join(); }
+	}
+
+	bool enqueue(const std::string& key, MTLRenderPipelineDescriptor* descriptor,
+				 bool highPriority, RenderCompletion completion) {
+		std::unique_lock<std::mutex> lock(_lock);
+		waitForAdmission(lock, key);
+		auto found = _jobs.find(key);
+		if (found != _jobs.end()) {
+			RenderCompletion copied = [completion copy];
+			found->second->renderCompletions.push_back(copied);
+			uint64_t bytes = mvkMadeiraMallocSize(copied);
+			found->second->ownedMinBytes += bytes;
+			g_mvkAsyncOwnedMinBytes.fetch_add(bytes, std::memory_order_relaxed);
+			g_mvkAsyncCompletions.fetch_add(1, std::memory_order_relaxed);
+			mvkTimeAsyncDedupeHit();
+			if (highPriority) { prioritizeLocked(found->second); }
+			return false;
+		}
+		Job* job = new Job;
+		job->key = key;
+		job->descriptor = [descriptor copy];
+		job->compute = false;
+		job->queuedAt = mvkTimeNow();
+		RenderCompletion copied = [completion copy];
+		job->renderCompletions.push_back(copied);
+		job->ownedMinBytes = sizeof(Job) + job->key.capacity() + mvkMadeiraMallocSize(job->descriptor) + mvkMadeiraMallocSize(copied);
+		_jobs.emplace(key, job);
+		if (highPriority) { _queue.push_front(job); } else { _queue.push_back(job); }
+		g_mvkAsyncJobs.fetch_add(1, std::memory_order_relaxed);
+		g_mvkAsyncQueued.fetch_add(1, std::memory_order_relaxed);
+		g_mvkAsyncCompletions.fetch_add(1, std::memory_order_relaxed);
+		g_mvkAsyncOwnedMinBytes.fetch_add(job->ownedMinBytes, std::memory_order_relaxed);
+		mvkTimeAsyncStarted();
+		mvkTimeAsyncQueueDepth((uint32_t)_queue.size());
+		_cv.notify_all();
+		return true;
+	}
+
+	bool enqueue(const std::string& key, MTLComputePipelineDescriptor* descriptor, ComputeCompletion completion) {
+		std::unique_lock<std::mutex> lock(_lock);
+		waitForAdmission(lock, key);
+		auto found = _jobs.find(key);
+		if (found != _jobs.end()) {
+			ComputeCompletion copied = [completion copy];
+			found->second->computeCompletions.push_back(copied);
+			uint64_t bytes = mvkMadeiraMallocSize(copied);
+			found->second->ownedMinBytes += bytes;
+			g_mvkAsyncOwnedMinBytes.fetch_add(bytes, std::memory_order_relaxed);
+			g_mvkAsyncCompletions.fetch_add(1, std::memory_order_relaxed);
+			mvkTimeAsyncDedupeHit();
+			return false;
+		}
+		Job* job = new Job;
+		job->key = key;
+		job->descriptor = [descriptor copy];
+		job->compute = true;
+		job->queuedAt = mvkTimeNow();
+		ComputeCompletion copied = [completion copy];
+		job->computeCompletions.push_back(copied);
+		job->ownedMinBytes = sizeof(Job) + job->key.capacity() + mvkMadeiraMallocSize(job->descriptor) + mvkMadeiraMallocSize(copied);
+		_jobs.emplace(key, job);
+		_queue.push_back(job);
+		g_mvkAsyncJobs.fetch_add(1, std::memory_order_relaxed);
+		g_mvkAsyncQueued.fetch_add(1, std::memory_order_relaxed);
+		g_mvkAsyncCompletions.fetch_add(1, std::memory_order_relaxed);
+		g_mvkAsyncOwnedMinBytes.fetch_add(job->ownedMinBytes, std::memory_order_relaxed);
+		mvkTimeAsyncStarted();
+		mvkTimeAsyncQueueDepth((uint32_t)_queue.size());
+		_cv.notify_all();
+		return true;
+	}
+
+	void prioritize(const std::string& key) {
+		std::lock_guard<std::mutex> lock(_lock);
+		auto found = _jobs.find(key);
+		if (found != _jobs.end()) { prioritizeLocked(found->second); }
+	}
+
+	uint64_t beginWait(const std::vector<std::string>& keys) {
+		std::lock_guard<std::mutex> lock(_lock);
+		uint64_t waitID = ++_nextWaitID;
+		WaitRecord& wait = _waits[waitID];
+		wait.keys = keys;
+		wait.requestedAt = mvkTimeNow();
+		wait.info.queueDepth = (uint32_t)_queue.size();
+		for (const auto& key : keys) {
+			auto found = _jobs.find(key);
+			if (found == _jobs.end()) { continue; }
+			Job* job = found->second;
+			if (job->urgentWaits.empty()) { ++_urgentJobCount; }
+			job->urgentWaits.insert(waitID);
+			prioritizeLocked(job);
+			boostLocked(job);
+		}
+		_cv.notify_all();
+		return waitID;
+	}
+
+	MVKAsyncPipelineWaitInfo endWait(uint64_t waitID) {
+		std::lock_guard<std::mutex> lock(_lock);
+		auto waitPos = _waits.find(waitID);
+		if (waitPos == _waits.end()) { return {}; }
+		WaitRecord& wait = waitPos->second;
+		uint64_t now = mvkTimeNow();
+		for (const auto& key : wait.keys) {
+			auto found = _jobs.find(key);
+			if (found == _jobs.end()) { continue; }
+			Job* job = found->second;
+			uint64_t queuedNS = job->compileStartedAt ? job->compileStartedAt - job->queuedAt : now - job->queuedAt;
+			uint64_t compiledNS = job->compileStartedAt ? now - job->compileStartedAt : 0;
+			wait.info.queuedNS = std::max(wait.info.queuedNS, queuedNS);
+			wait.info.compiledNS = std::max(wait.info.compiledNS, compiledNS);
+			uint64_t queueEnd = job->compileStartedAt ? job->compileStartedAt : now;
+			wait.info.urgentQueuedNS = std::max(wait.info.urgentQueuedNS,
+				queueEnd > wait.requestedAt ? queueEnd - wait.requestedAt : 0);
+		}
+		// Madeira: a timed-out draw stops observing the job, but the job remains
+		// urgent until completion so background dequeuing cannot prolong the stall.
+		MVKAsyncPipelineWaitInfo info = wait.info;
+		_waits.erase(waitPos);
+		return info;
+	}
+
+private:
+	void boostLocked(Job* job) {
+		if (job->running && !job->qosOverride && !job->urgentWaits.empty()) {
+			job->qosOverride = pthread_override_qos_class_start_np(job->worker, QOS_CLASS_USER_INTERACTIVE, 0);
+		}
+	}
+
+	void unboostLocked(Job* job) {
+		if (job->qosOverride) {
+			pthread_override_qos_class_end_np(job->qosOverride);
+			job->qosOverride = nullptr;
+		}
+	}
+
+	void prioritizeLocked(Job* job) {
+		if (job->running) { return; }
+		auto pos = std::find(_queue.begin(), _queue.end(), job);
+		if (pos != _queue.end() && pos != _queue.begin()) {
+			_queue.erase(pos);
+			_queue.push_front(job);
+			mvkTimeAsyncPriorityBump();
+		}
+	}
+
+	void worker(bool urgentOnly = false) {
+		// Madeira: background compiles yield CPU priority to the game's own threads.
+		pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+		for (;;) {
+			Job* job = nullptr;
+			{
+				std::unique_lock<std::mutex> lock(_lock);
+				auto nextJob = [&] { return mvkMadeiraNextJob(_queue, urgentOnly, _urgentJobCount != 0, _stopping); };
+				_cv.wait(lock, [&]{
+					return _stopping || nextJob() != _queue.end();
+				});
+				auto next = nextJob();
+				if (next == _queue.end()) { return; }
+				job = *next;
+				_queue.erase(next);
+				job->running = true;
+				g_mvkAsyncQueued.fetch_sub(1, std::memory_order_relaxed);
+				g_mvkAsyncRunning.fetch_add(1, std::memory_order_relaxed);
+				job->worker = pthread_self();
+				job->compileStartedAt = mvkTimeNow();
+				boostLocked(job);
+				mvkTimeAsyncQueueDepth((uint32_t)_queue.size());
+			}
+
+			id state = nil;
+			uint64_t compileStart = mvkTimeNow();
+			@autoreleasepool {
+				if (job->compute) {
+					auto descriptor = (MTLComputePipelineDescriptor*)job->descriptor;
+					state = _device->getCachedPipeline(descriptor); // retained
+					if (!state) { state = _device->newArchivedPipeline(descriptor, kMVKArchiveCompute, false); }
+					if (!state) {
+						NSError* error = nil;
+						uint64_t start = mvkTimeNow();
+						id<MTLDevice> mtlDevice = _device->getPhysicalDevice()->getMTLDevice();
+						uint64_t lockNS = 0, submitNS = 0, waitNS = 0;
+						state = mvkMadeiraCompilePipeline(mtlDevice, descriptor, true, &error, lockNS, submitNS, waitNS);
+						if (mvkShaderPrepLogThresholdNS() && lockNS + submitNS + waitNS >= mvkShaderPrepLogThresholdNS()) {
+							fprintf(stderr, "[mvk-compile] compute device-lock=%.1fms submit=%.1fms completion=%.1fms\n", lockNS / 1e6, submitNS / 1e6, waitNS / 1e6);
+						}
+						mvkTimeAdd(4, start);
+						if (!state && error) { fprintf(stderr, "[mvk-async] compute pipeline compile failed: %s\n", error.localizedDescription.UTF8String); }
+						[error release];
+					}
+					if (state) { _device->cachePipeline(descriptor, state); }
+				} else {
+					auto descriptor = (MTLRenderPipelineDescriptor*)job->descriptor;
+					state = _device->getCachedPipeline(descriptor); // retained
+					// Madeira: archive probing and miss compilation both stay off the creation thread.
+					if (!state) { state = _device->newArchivedPipeline(descriptor, kMVKArchiveGraphicsAsync, false); }
+					if (!state) {
+					NSError* error = nil;
+					uint64_t start = mvkTimeNow();
+					id<MTLDevice> mtlDevice = _device->getPhysicalDevice()->getMTLDevice();
+					uint64_t lockNS = 0, submitNS = 0, waitNS = 0;
+					state = mvkMadeiraCompilePipeline(mtlDevice, descriptor, false, &error, lockNS, submitNS, waitNS);
+					if (mvkShaderPrepLogThresholdNS() && lockNS + submitNS + waitNS >= mvkShaderPrepLogThresholdNS()) {
+						fprintf(stderr, "[mvk-compile] graphics device-lock=%.1fms submit=%.1fms completion=%.1fms\n", lockNS / 1e6, submitNS / 1e6, waitNS / 1e6);
+					}
+					mvkTimeAdd(4, start);
+					if (!state && error) {
+						fprintf(stderr, "[mvk-async] graphics pipeline compile failed: %s\n", error.localizedDescription.UTF8String);
+					}
+					[error release];
+					}
+					if (state) { _device->cachePipeline(descriptor, state); }
+				}
+			}
+			uint64_t compileElapsed = mvkTimeNow() - compileStart;
+			if (compileElapsed > 500000000ull) {
+				fprintf(stderr, "[mvk-async] slow-compile %.1fms success=%d\n",
+						compileElapsed / 1e6, state != nil);
+			}
+			if (state) { mvkTimeAsyncCompleted(); } else { mvkTimeAsyncFailed(); }
+
+			std::vector<RenderCompletion> renderCompletions;
+			std::vector<ComputeCompletion> computeCompletions;
+			{
+				std::lock_guard<std::mutex> lock(_lock);
+				uint64_t queuedNS = job->compileStartedAt - job->queuedAt;
+				for (uint64_t waitID : job->urgentWaits) {
+					auto wait = _waits.find(waitID);
+					if (wait == _waits.end()) { continue; }
+					wait->second.info.queuedNS = std::max(wait->second.info.queuedNS, queuedNS);
+					wait->second.info.compiledNS = std::max(wait->second.info.compiledNS, compileElapsed);
+					uint64_t requestedAt = wait->second.requestedAt;
+					wait->second.info.urgentQueuedNS = std::max(wait->second.info.urgentQueuedNS,
+						job->compileStartedAt > requestedAt ? job->compileStartedAt - requestedAt : 0);
+				}
+				if (!job->urgentWaits.empty()) { --_urgentJobCount; }
+				unboostLocked(job);
+				renderCompletions.swap(job->renderCompletions);
+				computeCompletions.swap(job->computeCompletions);
+				_jobs.erase(job->key);
+			}
+			_cv.notify_all();
+			for (RenderCompletion completion : renderCompletions) {
+				completion(state);
+				[completion release];
+			}
+			for (ComputeCompletion completion : computeCompletions) {
+				completion(state);
+				[completion release];
+			}
+			[state release];
+			[job->descriptor release];
+			g_mvkAsyncCompletions.fetch_sub(renderCompletions.size() + computeCompletions.size(), std::memory_order_relaxed);
+			g_mvkAsyncOwnedMinBytes.fetch_sub(job->ownedMinBytes, std::memory_order_relaxed);
+			g_mvkAsyncRunning.fetch_sub(1, std::memory_order_relaxed);
+			g_mvkAsyncJobs.fetch_sub(1, std::memory_order_relaxed);
+			delete job;
+		}
+	}
+
+	// Do not retain descriptors/owners before obtaining a slot. Existing-key
+	// subscribers remain admissible, including if another producer won a slot.
+	void waitForAdmission(std::unique_lock<std::mutex>& lock, const std::string& key) {
+		if (!mvkMadeiraAdmissionEnabled()) { return; }
+		uint64_t start = mvkTimeNow();
+		_cv.wait(lock, [&] {
+			return _jobs.find(key) != _jobs.end() ||
+				_jobs.size() < mvkMadeiraAdmissionCapacity(mvkMadeiraMemoryPressureActive());
+		});
+		uint64_t elapsed = mvkTimeNow() - start;
+		if (elapsed >= 5000000ull) {
+			fprintf(stderr, "[mvk-async-admission] producer_wait_ms=%.1f jobs=%zu cap=%zu pressure=%d\n",
+				elapsed / 1e6, _jobs.size(), mvkMadeiraAdmissionCapacity(mvkMadeiraMemoryPressureActive()),
+				mvkMadeiraMemoryPressureActive());
+		}
+	}
+
+	MVKDevice* _device;
+	std::mutex _lock;
+	std::condition_variable _cv;
+	std::deque<Job*> _queue;
+	std::unordered_map<std::string, Job*> _jobs;
+	std::unordered_map<uint64_t, WaitRecord> _waits;
+	std::vector<std::thread> _workers;
+	bool _stopping = false;
+	uint32_t _urgentJobCount = 0;
+	uint64_t _nextWaitID = 0;
+};
+
+const MVKMadeiraCPUOptions& mvkMadeiraCPUOptions() {
+	static const MVKMadeiraCPUOptions options = [] {
+		auto on = [](const char* name) { const char* v = getenv(name); return !(v && v[0] == '0'); };
+		MVKMadeiraCPUOptions o;
+		o.lazyResidency = on("MVK_MADEIRA_LAZY_RESIDENCY");
+		o.batchTempRelease = on("MVK_MADEIRA_BATCH_TEMP_RELEASE");
+		o.skipEmptySubmit = on("MVK_MADEIRA_SKIP_EMPTY_SUBMIT");
+		fprintf(stderr, "[mvk-cpu] lazy-residency=%d batch-temp-release=%d skip-empty-submit=%d\n",
+				o.lazyResidency, o.batchTempRelease, o.skipEmptySubmit);
+		return o;
+	}();
+	return options;
+}
+
+uint32_t mvkMadeiraFullBarriersMode() {
+	static const uint32_t mode = [] {
+		// Madeira: values above 2 select the strongest documented mode.
+		const char* value = getenv("MVK_MADEIRA_FULL_BARRIERS");
+		return value ? std::min<uint32_t>((uint32_t)strtoul(value, nullptr, 10), 2) : 0;
+	}();
+	return mode;
+}
+
+static NSString* mvkMadeiraGameCacheDirectoryUncached(id<MTLDevice> device);
+
+NSString* mvkMadeiraGameCacheDirectory(id<MTLDevice> device) {
+	// Called for every pipeline: the environment dictionary and the Caches path
+	// lookup (a stat per call) only change with the device, so remember the result.
+	static std::mutex lock;
+	static uint64_t cachedID = 0;
+	static NSString* cached = nil;
+	{
+		std::lock_guard<std::mutex> guard(lock);
+		if (cached && cachedID == device.registryID) { return cached; }
+	}
+	NSString* result = mvkMadeiraGameCacheDirectoryUncached(device);
+	std::lock_guard<std::mutex> guard(lock);
+	[cached release];
+	cached = [result retain];
+	cachedID = device.registryID;
+	return cached;
+}
+
+static NSString* mvkMadeiraGameCacheDirectoryUncached(id<MTLDevice> device) {
+	NSString* root = NSProcessInfo.processInfo.environment[@"MVK_CONFIG_IOS_BINARY_ARCHIVE_DIR"];
+	if (!root.length) { root = [NSSearchPathForDirectoriesInDomains(NSCachesDirectory, NSUserDomainMask, YES).firstObject stringByAppendingPathComponent:@"mvk-binary-archive"]; }
+	NSString* game = NSProcessInfo.processInfo.environment[@"MADEIRA_GAME_KEY"];
+	if (!game.length) { game = NSProcessInfo.processInfo.processName; }
+	NSString* identity = [NSString stringWithFormat:@"v1-%llu-%@-%@", device.registryID, device.name, game];
+	// Stable path component; never interpret a game key as a relative path.
+	uint64_t hash = 14695981039346656037ull;
+	for (const unsigned char* p = (const unsigned char*)identity.UTF8String; *p; ++p) { hash = (hash ^ *p) * 1099511628211ull; }
+	return [root stringByAppendingPathComponent:[NSString stringWithFormat:@"%016llx", (unsigned long long)hash]];
+}
+
+class MVKBinaryArchiveCache {
+public:
+	MVKBinaryArchiveCache(id<MTLDevice> device) : _device(device) {
+		const char* mb = getenv("MVK_MADEIRA_ARCHIVE_MB");
+		char* end = nullptr;
+		unsigned long long configured = mb ? strtoull(mb, &end, 10) : 1536;
+		_budget = ((mb && (*mb == '-' || !*mb || !end || *end || configured > 65536)) ? 1536 : configured) << 20;
+		g_mvkArchiveBudgetFileBytes.store(_budget, std::memory_order_relaxed);
+		_queue = dispatch_queue_create("MoltenVK.binary-archive", DISPATCH_QUEUE_SERIAL);
+		_directory = [mvkMadeiraGameCacheDirectory(device) retain];
+		NSError* error = nil;
+		_enabled = [NSFileManager.defaultManager createDirectoryAtPath:_directory withIntermediateDirectories:YES attributes:nil error:&error];
+		NSUInteger loaded = 0, pruned = 0;
+		unsigned long long loadedBytes = 0, prunedBytes = 0;
+		if (_enabled) {
+			NSArray* files = [NSFileManager.defaultManager contentsOfDirectoryAtPath:_directory error:nil];
+			// Madeira: a budget for the pages kept open. Metal reads and hashes an opened
+			// archive into the process (it is not mapped from the file as assumed below):
+			// Detroit: Become Human's cache grew to 310 pages, 5.7 GB, and opening them
+			// took the iPad from 2 GB to its 12 GB limit before the first frame (220 pages
+			// had just fitted). Newest pages are kept up to MVK_MADEIRA_ARCHIVE_MB
+			// (default 1536; 0 = no limit); older ones are deleted, since a page that is
+			// never opened is never searched, and their pipelines are rebuilt into new
+			// pages when the game asks for them again.
+			NSMutableSet* keep = nil;
+			{
+				unsigned long long budget = _budget;
+				if (budget) {
+					NSMutableArray* entries = [NSMutableArray array];
+					for (NSString* file in files) {
+						if (![file hasSuffix:@".metalarc"]) { continue; }
+						NSDictionary* attrs = [NSFileManager.defaultManager attributesOfItemAtPath:[_directory stringByAppendingPathComponent:file] error:nil];
+						if (attrs) { [entries addObject:@[attrs.fileModificationDate ?: NSDate.distantPast, @(attrs.fileSize), file]]; }
+					}
+					[entries sortUsingComparator:^NSComparisonResult(NSArray* a, NSArray* b) { return [b[0] compare:a[0]]; }];
+					keep = [NSMutableSet set];
+					unsigned long long used = 0;
+					for (NSArray* e in entries) {
+						unsigned long long size = [e[1] unsignedLongLongValue];
+						if (used + size <= budget) { used += size; [keep addObject:e[2]]; continue; }
+						if ([NSFileManager.defaultManager removeItemAtPath:[_directory stringByAppendingPathComponent:e[2]] error:nil]) { ++pruned; prunedBytes += size; }
+					}
+					loadedBytes = used;
+				}
+			}
+			for (unsigned i = 0; i < kShardCount; ++i) {
+				auto& shard = _shards[i];
+				NSString* prefix = [NSString stringWithFormat:@"%02u-", i];
+				for (NSString* file in [files sortedArrayUsingSelector:@selector(compare:)]) {
+					if (keep && ![keep containsObject:file]) { continue; }
+					if ([file hasPrefix:prefix] && [file hasSuffix:@".metalarc"]) {
+						shard.pages.push_back([[NSURL fileURLWithPath:[_directory stringByAppendingPathComponent:file]] retain]);
+						// Kept open (within the budget above: an open page costs memory), so one
+						// lookup searches every page in a single pipeline creation instead of
+						// reopening and probing them one at a time (hundreds of pages for a game
+						// with ~100k pipelines, under the shard lock).
+						id<MTLBinaryArchive> archive = load(shard.pages.back());
+						if (archive) { ++loaded; freeze(shard, archive, shard.pages.back()); [archive release]; }
+					}
+				}
+				appendPage(shard, i); // Existing pages are immutable across processes.
+			}
+		}
+		fprintf(stderr, "[mvk-archive] load enabled=%d pages=%lu (%llu MB) pruned=%lu (%llu MB, MVK_MADEIRA_ARCHIVE_MB) hits=0 misses=0 dir=%s error=%s\n", _enabled, (unsigned long)loaded, loadedBytes >> 20, (unsigned long)pruned, prunedBytes >> 20, _directory.UTF8String, error ? error.localizedDescription.UTF8String : "none");
+	}
+
+	~MVKBinaryArchiveCache() {
+		// Drain queued writes before releasing Metal objects or the device.
+		dispatch_sync(_queue, ^{});
+		for (unsigned i = 0; i < kShardCount; ++i) {
+			auto& shard = _shards[i];
+			std::lock_guard<std::mutex> lock(shard.lock);
+			flush(shard, i);
+			[shard.archive release];
+			for (NSURL* url : shard.pages) { [url release]; }
+			for (auto& page : shard.frozen) {
+				g_mvkArchiveFrozenFileBytes.fetch_sub(page.bytes, std::memory_order_relaxed);
+				g_mvkArchiveFrozenPages.fetch_sub(1, std::memory_order_relaxed);
+				[page.archive release];
+			}
+		}
+		fprintf(stderr, "[mvk-archive] close hits=%llu misses=%llu\n", (unsigned long long)_hits.load(), (unsigned long long)_misses.load());
+		dispatch_release(_queue);
+		[_directory release];
+	}
+
+	template<class Descriptor> id newPipeline(Descriptor* descriptor, id<MTLFunction> function,
+										 MVKArchivePipelineKind kind, bool synchronous) {
+		if (!_enabled) { return nil; }
+		uint64_t entireStart = mvkTimeNow();
+		uint64_t creation = ++_creations;
+		bool verify = archiveVerificationEnabled();
+		size_t descriptorHash = verify ? std::hash<std::string>()(mvkPSOKey(_device, descriptor)) : 0;
+		uint64_t lookupStart = mvkTimeNow();
+		uint64_t hash = 0;
+		@autoreleasepool {   // an atomic association is returned retained and autoreleased
+			hash = [objc_getAssociatedObject(function, &kMVKArchiveShaderKey) unsignedLongLongValue];
+		}
+		hash ^= hash >> 32;
+		unsigned index = hash % kShardCount;
+		auto& shard = _shards[index];
+		std::lock_guard<std::mutex> lock(shard.lock);
+		// Finished pages stay open within the runtime budget; the current page is this
+		// process's writer, reopened from its file after a flush released it. One
+		// pipeline creation searches them all.
+		if (!shard.archive && !shard.pages.empty()) { shard.archive = load(shard.pages.back()); }
+		if (!shard.frozen.empty() || shard.archive) { @autoreleasepool {
+			NSMutableArray* archives = [NSMutableArray array];
+			for (auto& page : shard.frozen) { [archives addObject:page.archive]; }
+			if (shard.archive) { [archives addObject:shard.archive]; }
+			descriptor.binaryArchives = archives;
+			NSError* error = nil;
+			uint64_t stateStart = mvkTimeNow();
+			id state = compile(descriptor, MTLPipelineOptionFailOnBinaryArchiveMiss, &error);
+			mvkTimeAdd(4, stateStart);
+			descriptor.binaryArchives = nil;
+			if (state) {
+				++_hits;
+				uint64_t elapsed = mvkTimeNow() - lookupStart;
+				mvkTimeAddElapsed(5, elapsed);
+				mvkTimeArchiveResult(true, verify, elapsed, kind);
+				if (verify) { fprintf(stderr, "[mvk-archive] create=%llu descriptor=%016llx real-hit=1 fail-on-miss=success\n", (unsigned long long)creation, (unsigned long long)descriptorHash); }
+				return state;
+			}
+		} }
+		++_misses;
+		uint64_t lookupElapsed = mvkTimeNow() - lookupStart;
+		mvkTimeAddElapsed(5, lookupElapsed);
+		mvkTimeArchiveResult(false, false, lookupElapsed, kind);
+		if (verify) { fprintf(stderr, "[mvk-archive] create=%llu descriptor=%016llx real-hit=0 fail-on-miss=miss\n", (unsigned long long)creation, (unsigned long long)descriptorHash); }
+		auto finishMiss = [&](id state) {
+			if (synchronous) { mvkTimeArchiveSyncMiss(kind, mvkTimeNow() - entireStart); }
+			return state;
+		};
+		if (shard.dirty >= 128) { return finishMiss(nil); } // Bound pending additions while the writer catches up.
+		if (!shard.archive) {
+			if (!shard.pages.empty()) {
+				shard.archive = load(shard.pages.back());
+			}
+			if (!shard.archive) {
+				MTLBinaryArchiveDescriptor* desc = [MTLBinaryArchiveDescriptor new];
+				shard.archive = [_device newBinaryArchiveWithDescriptor:desc error:nil];
+				[desc release];
+				if (shard.pages.empty()) { appendPage(shard, index); }
+			}
+		}
+		if (!shard.archive) { return finishMiss(nil); }
+		NSError* error = nil;
+		if (!add(shard.archive, descriptor, &error)) {
+			if (_errors.fetch_add(1) < 8) { fprintf(stderr, "[mvk-archive] add failed: %s\n", error.localizedDescription.UTF8String); }
+			return finishMiss(nil);
+		}
+		++shard.dirty;
+		descriptor.binaryArchives = @[shard.archive];
+		uint64_t stateStart = mvkTimeNow();
+		id state = compile(descriptor, MTLPipelineOptionNone, &error);
+		mvkTimeAdd(4, stateStart);
+		descriptor.binaryArchives = nil;
+		if (shard.dirty >= 128 && !shard.queued) {
+			shard.queued = true;
+			dispatch_async(_queue, ^{ @autoreleasepool {
+				auto& pending = _shards[index];
+				{
+					std::lock_guard<std::mutex> writeLock(pending.lock);
+					flush(pending, index);
+					pending.queued = false;
+				}
+				// Never hold one shard while locking another: pipeline creation can be
+				// running on every shard. Only this serial writer changes frozen pages.
+				trimFrozenPages();
+			} });
+		}
+		return finishMiss(state); // retained, or nil to let the existing compiler report the error
+	}
+
+public:
+	void trimForPressure() {
+		bool expected = false;
+		if (!_pressureTrimQueued.compare_exchange_strong(expected, true)) return;
+		dispatch_async(_queue, ^{ @autoreleasepool {
+			trimFrozenPages();
+			_pressureTrimQueued.store(false);
+		} });
+	}
+	void logMemory() {
+		fprintf(stderr, "[mvk-archive-memory] frozen_pages=%llu frozen_file_bytes=%llu budget_file_bytes=%llu evictions=%llu metal_resident_bytes=unknown active_writers_excluded=1\n",
+			(unsigned long long)_frozenCount.load(), (unsigned long long)_frozenBytes.load(),
+			(unsigned long long)mvkMadeiraPressureCapacity(_budget, 128 * 1024 * 1024, 2), (unsigned long long)_evictions.load());
+	}
+
+private:
+	static constexpr unsigned kShardCount = 16;
+	struct FrozenPage {
+		id<MTLBinaryArchive> archive;
+		uint64_t bytes, age;
+	};
+	struct Shard {
+		std::mutex lock;
+		std::vector<NSURL*> pages;
+		std::vector<FrozenPage> frozen;
+		id<MTLBinaryArchive> archive = nil;
+		unsigned dirty = 0;
+		bool queued = false;
+	};
+	Shard _shards[kShardCount];
+	id<MTLDevice> _device;
+	NSString* _directory;
+	dispatch_queue_t _queue;
+	bool _enabled = false;
+	std::atomic<uint64_t> _hits{0}, _misses{0}, _errors{0}, _creations{0};
+	std::atomic<uint64_t> _frozenCount{0}, _frozenBytes{0}, _evictions{0};
+	uint64_t _budget = 0, _nextAge = 0;
+	std::atomic<bool> _pressureTrimQueued{false};
+
+	void freeze(Shard& shard, id<MTLBinaryArchive> archive, NSURL* url) {
+		NSDictionary* attrs = [NSFileManager.defaultManager attributesOfItemAtPath:url.path error:nil];
+		uint64_t bytes = attrs ? attrs.fileSize : 8 * 1024 * 1024;
+		uint64_t age = attrs.fileModificationDate ? uint64_t(attrs.fileModificationDate.timeIntervalSince1970 * 1000000) : ++_nextAge;
+		_nextAge = std::max(_nextAge, age);
+		auto position = std::upper_bound(shard.frozen.begin(), shard.frozen.end(), age,
+			[](uint64_t value, const FrozenPage& page) { return value < page.age; });
+		shard.frozen.insert(position, {[archive retain], bytes, age});
+		_frozenBytes.fetch_add(bytes);
+		_frozenCount.fetch_add(1);
+		g_mvkArchiveFrozenFileBytes.fetch_add(bytes, std::memory_order_relaxed);
+		g_mvkArchiveFrozenPages.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	void trimFrozenPages() {
+		// File bytes are a proxy, not Metal's measured CPU allocation. Allow the
+		// current 16 writers and one just-finished batch outside this budget.
+		uint64_t budget = mvkMadeiraPressureCapacity(_budget, 128 * 1024 * 1024, 2);
+		while (budget && _frozenBytes.load() > budget) {
+			unsigned victim = kShardCount;
+			uint64_t oldest = UINT64_MAX;
+			for (unsigned i = 0; i < kShardCount; ++i) {
+				std::lock_guard<std::mutex> lock(_shards[i].lock);
+				if (!_shards[i].frozen.empty() && _shards[i].frozen.front().age < oldest) {
+					victim = i;
+					oldest = _shards[i].frozen.front().age;
+				}
+			}
+			if (victim == kShardCount) { break; }
+			std::lock_guard<std::mutex> lock(_shards[victim].lock);
+			auto& pages = _shards[victim].frozen;
+			auto page = pages.front();
+			pages.erase(pages.begin());
+			_frozenBytes.fetch_sub(page.bytes);
+			_frozenCount.fetch_sub(1);
+			g_mvkArchiveFrozenFileBytes.fetch_sub(page.bytes, std::memory_order_relaxed);
+			g_mvkArchiveFrozenPages.fetch_sub(1, std::memory_order_relaxed);
+			++_evictions;
+			[page.archive release];
+			// Keep the disk file. A miss can rebuild its pipeline; evicting the
+			// archive must never invalidate live pipeline states or shader modules.
+		}
+	}
+
+	static bool archiveVerificationEnabled() {
+		static bool enabled = [] { const char* value = getenv("MVK_MADEIRA_ARCHIVE_VERIFY"); return value && !strcmp(value, "1"); }();
+		return enabled;
+	}
+
+	void appendPage(Shard& shard, unsigned index) {
+		// UUID avoids replacing another process's page. Concurrent processes may
+		// duplicate cache entries, but cannot truncate each other's archive files.
+		NSString* file = [NSString stringWithFormat:@"%02u-%@.metalarc", index, NSUUID.UUID.UUIDString];
+		shard.pages.push_back([[NSURL fileURLWithPath:[_directory stringByAppendingPathComponent:file]] retain]);
+	}
+
+	id<MTLBinaryArchive> load(NSURL* url) {
+		if (![NSFileManager.defaultManager fileExistsAtPath:url.path]) { return nil; }
+		MTLBinaryArchiveDescriptor* desc = [MTLBinaryArchiveDescriptor new];
+		desc.url = url;
+		NSError* error = nil;
+		id<MTLBinaryArchive> archive = [_device newBinaryArchiveWithDescriptor:desc error:&error];
+		[desc release];
+		if (!archive) {
+			fprintf(stderr, "[mvk-archive] discard file=%s error=%s\n", url.path.UTF8String, error.localizedDescription.UTF8String);
+			[NSFileManager.defaultManager removeItemAtURL:url error:nil];
+		}
+		return archive;
+	}
+
+	void flush(Shard& shard, unsigned index) {
+		if (!shard.dirty) { return; }
+		NSURL* url = shard.pages.back();
+		NSURL* temp = [NSURL fileURLWithPath:[url.path stringByAppendingString:@".tmp"]];
+		NSError* error = nil;
+		bool ok = [shard.archive serializeToURL:temp error:&error];
+		// Rename on the same filesystem leaves the last good archive intact on failure.
+		if (ok) { ok = rename(temp.path.fileSystemRepresentation, url.path.fileSystemRepresentation) == 0; }
+		fprintf(stderr, "[mvk-archive] serialize shard=%u additions=%u hits=%llu misses=%llu ok=%d file=%s error=%s\n", index, shard.dirty, (unsigned long long)_hits.load(), (unsigned long long)_misses.load(), ok, url.path.UTF8String, error ? error.localizedDescription.UTF8String : (ok ? "none" : strerror(errno)));
+		if (!ok) {
+			// Do not grow memory indefinitely if storage is full or unavailable.
+			[NSFileManager.defaultManager removeItemAtURL:temp error:nil];
+			shard.dirty = 0;
+			[shard.archive release];
+			shard.archive = nil;
+			return;
+		}
+		shard.dirty = 0;
+		[shard.archive release];
+		shard.archive = nil;
+		// Bound the size of a resident page, allowing one batch of overshoot. Disk
+		// storage is pruned at startup; runtime eviction releases only Metal objects.
+		if ([[NSFileManager.defaultManager attributesOfItemAtPath:url.path error:nil] fileSize] >= 8 * 1024 * 1024) {
+			id<MTLBinaryArchive> done = load(url);   // finished: searched from now on
+			if (done) { freeze(shard, done, url); [done release]; }
+			appendPage(shard, index);
+		}
+	}
+
+	id compile(MTLRenderPipelineDescriptor* d, MTLPipelineOption options, NSError** error) {
+		return [_device newRenderPipelineStateWithDescriptor:d options:options reflection:nil error:error];
+	}
+	id compile(MTLComputePipelineDescriptor* d, MTLPipelineOption options, NSError** error) {
+		return [_device newComputePipelineStateWithDescriptor:d options:options reflection:nil error:error];
+	}
+	bool add(id<MTLBinaryArchive> archive, MTLRenderPipelineDescriptor* d, NSError** error) {
+		return [archive addRenderPipelineFunctionsWithDescriptor:d error:error];
+	}
+	bool add(id<MTLBinaryArchive> archive, MTLComputePipelineDescriptor* d, NSError** error) {
+		return [archive addComputePipelineFunctionsWithDescriptor:d error:error];
+	}
+};
