+// Desktop drivers tolerate undeclared vertex inputs. Metal requires a descriptor
+// for every active stage-in attribute, including when Vulkan provides no inputs.
+template<class T>
+bool MVKGraphicsPipeline::addMissingVertexAttributes(T* inputDesc, id<MTLFunction> function) {
+	for (MTLAttribute* attr in function.stageInputAttributes) {
+		if (!attr.active) { continue; }
+		NSUInteger location = attr.attributeIndex;
+		if (location >= 31 || (NSUInteger)inputDesc.attributes[location].format != MTLVertexFormatInvalid) { continue; }
+		if (!_dummyVertexBuffer) {
+			// Descriptor buffers occupy the low indices, vertex buffers the high
+			// indices. Exclude implicit shader buffers as well as translated inputs.
+			auto used = _mtlVertexBuffers;
+			const auto& resources = _stageResources[kMVKShaderStageVertex];
+			for (auto buffer : resources.implicitBuffers.needed) { used.set(resources.implicitBuffers.ids[buffer]); }
+			for (uint32_t i = _descriptorBufferCounts.stages[kMVKShaderStageVertex]; i < 31; ++i) {
+				if (!used.get(i)) { _dummyVertexBufferIndex = i; break; }
+			}
+			if (_dummyVertexBufferIndex == UINT32_MAX) {
+				setConfigurationResult(reportError(VK_ERROR_INITIALIZATION_FAILED, "No spare Metal buffer index for missing vertex attributes."));
+				return false;
+			}
+			uint32_t zeros[4] = {};
+			_dummyVertexBuffer = [getMTLDevice() newBufferWithBytes:zeros length:sizeof(zeros) options:MTLResourceStorageModeShared];
+			if (!_dummyVertexBuffer) {
+				setConfigurationResult(reportError(VK_ERROR_OUT_OF_DEVICE_MEMORY, "Could not allocate missing vertex attribute buffer."));
+				return false;
+			}
+			_trackedDummyVertexBufferBytes = _dummyVertexBuffer.allocatedSize;
+			getDevice()->trackMemoryAllocation(MVKMemoryAllocationType::MetalBuffer, _trackedDummyVertexBufferBytes);
+		}
+		// Supply four components so the usual missing-component default (w=1)
+		// cannot leak into an input that must read entirely as zero.
+		MTLVertexFormat format;
+		switch (attr.attributeType) {
+			case MTLDataTypeFloat: case MTLDataTypeFloat2: case MTLDataTypeFloat3: case MTLDataTypeFloat4: format = MTLVertexFormatFloat4; break;
+			case MTLDataTypeHalf: case MTLDataTypeHalf2: case MTLDataTypeHalf3: case MTLDataTypeHalf4: format = MTLVertexFormatHalf4; break;
+			case MTLDataTypeInt: case MTLDataTypeInt2: case MTLDataTypeInt3: case MTLDataTypeInt4: format = MTLVertexFormatInt4; break;
+			case MTLDataTypeUInt: case MTLDataTypeUInt2: case MTLDataTypeUInt3: case MTLDataTypeUInt4: format = MTLVertexFormatUInt4; break;
+			case MTLDataTypeShort: case MTLDataTypeShort2: case MTLDataTypeShort3: case MTLDataTypeShort4: format = MTLVertexFormatShort4; break;
+			case MTLDataTypeUShort: case MTLDataTypeUShort2: case MTLDataTypeUShort3: case MTLDataTypeUShort4: format = MTLVertexFormatUShort4; break;
+			case MTLDataTypeChar: case MTLDataTypeChar2: case MTLDataTypeChar3: case MTLDataTypeChar4: format = MTLVertexFormatChar4; break;
+			case MTLDataTypeUChar: case MTLDataTypeUChar2: case MTLDataTypeUChar3: case MTLDataTypeUChar4: format = MTLVertexFormatUChar4; break;
+			default:
+				setConfigurationResult(reportError(VK_ERROR_INITIALIZATION_FAILED, "Unsupported missing vertex attribute type %lu.", (unsigned long)attr.attributeType));
+				return false;
+		}
+		auto desc = inputDesc.attributes[location];
+		desc.format = (decltype(desc.format))format;
+		desc.offset = 0;
+		desc.bufferIndex = _dummyVertexBufferIndex;
+		auto layout = inputDesc.layouts[_dummyVertexBufferIndex];
+		layout.stepFunction = (decltype(layout.stepFunction))MTLStepFunctionConstant;
+		layout.stepRate = 0;
+		// Metal requires a nonzero stride even for constant stepping; no draw
+		// index ever advances this buffer (same convention as Vulkan stride 0).
+		layout.stride = 16;
+		static std::atomic<unsigned> logged{0};
+		if (logged.fetch_add(1) < 8) {
+			fprintf(stderr, "[mvk-dummy-attr] location=%lu type=%lu buffer=%u zero-filled\n", (unsigned long)location, (unsigned long)attr.attributeType, _dummyVertexBufferIndex);
+		}
+	}
+	return true;
+}
