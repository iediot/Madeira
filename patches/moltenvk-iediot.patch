+// Madeira: serialize every Metal input MoltenVK can put in these descriptors.
+// The unordered map hashes this byte string; retaining the complete key also makes
+// hash collisions harmless. Binary archives are acceleration inputs, not PSO state.
+template<class T> void mvkPSOKeyAdd(std::string& key, const T& value) {
+	key.append((const char*)&value, sizeof(value));
+}
+void mvkPSOKeyAddString(std::string& key, NSString* value) {
+	const char* text = value.UTF8String;
+	size_t length = text ? strlen(text) : 0;
+	mvkPSOKeyAdd(key, length);
+	if (length) { key.append(text, length); }
+}
+void mvkPSOKeyAddObject(std::string& key, id value) {
+	uintptr_t identity = (uintptr_t)value;
+	mvkPSOKeyAdd(key, identity);
+}
+void mvkPSOKeyAddFunction(std::string& key, id<MTLFunction> function) {
+	uint64_t identity = [objc_getAssociatedObject(function, &kMVKPipelineFunctionKey) unsignedLongLongValue];
+	mvkPSOKeyAdd(key, identity);
+	mvkPSOKeyAddString(key, function.name);
+	if (!identity) { mvkPSOKeyAddObject(key, function); }
+}
+void mvkPSOKeyAddFunctions(std::string& key, NSArray<id<MTLFunction>>* functions) {
+	NSUInteger count = functions.count;
+	mvkPSOKeyAdd(key, count);
+	for (id<MTLFunction> function in functions) { mvkPSOKeyAddFunction(key, function); }
+}
+void mvkPSOKeyAddLinkedFunctions(std::string& key, MTLLinkedFunctions* linked) {
+	mvkPSOKeyAddFunctions(key, linked.functions);
+	mvkPSOKeyAddFunctions(key, linked.binaryFunctions);
+	mvkPSOKeyAddFunctions(key, linked.privateFunctions);
+	NSArray<NSString*>* names = [[linked.groups allKeys] sortedArrayUsingSelector:@selector(compare:)];
+	mvkPSOKeyAdd(key, names.count);
+	for (NSString* name in names) {
+		mvkPSOKeyAddString(key, name);
+		mvkPSOKeyAddFunctions(key, linked.groups[name]);
+	}
+}
+void mvkPSOKeyAddStageInput(std::string& key, MTLStageInputOutputDescriptor* input) {
+	bool present = input != nil;
+	mvkPSOKeyAdd(key, present);
+	if (!present) { return; }
+	mvkPSOKeyAdd(key, input.indexType);
+	mvkPSOKeyAdd(key, input.indexBufferIndex);
+	for (NSUInteger idx = 0; idx < 31; ++idx) {
+		auto layout = input.layouts[idx];
+		mvkPSOKeyAdd(key, layout.stride);
+		mvkPSOKeyAdd(key, layout.stepFunction);
+		mvkPSOKeyAdd(key, layout.stepRate);
+		auto attribute = input.attributes[idx];
+		mvkPSOKeyAdd(key, attribute.format);
+		mvkPSOKeyAdd(key, attribute.offset);
+		mvkPSOKeyAdd(key, attribute.bufferIndex);
+	}
+}
+void mvkPSOKeyAddLibraries(std::string& key, NSArray* libraries) {
+	mvkPSOKeyAdd(key, libraries.count);
+	for (id library in libraries) { mvkPSOKeyAddObject(key, library); }
+}
+
+std::string mvkPSOKey(id<MTLDevice> device, MTLRenderPipelineDescriptor* desc) {
+	std::string key("R", 1);
+	mvkPSOKeyAddObject(key, device);
+	mvkPSOKeyAddString(key, desc.label);
+	mvkPSOKeyAddFunction(key, desc.vertexFunction);
+	mvkPSOKeyAddFunction(key, desc.fragmentFunction);
+	bool hasVertex = desc.vertexDescriptor != nil;
+	mvkPSOKeyAdd(key, hasVertex);
+	if (hasVertex) {
+		for (NSUInteger idx = 0; idx < 31; ++idx) {
+			auto layout = desc.vertexDescriptor.layouts[idx];
+			mvkPSOKeyAdd(key, layout.stride);
+			mvkPSOKeyAdd(key, layout.stepFunction);
+			mvkPSOKeyAdd(key, layout.stepRate);
+			auto attribute = desc.vertexDescriptor.attributes[idx];
+			mvkPSOKeyAdd(key, attribute.format);
+			mvkPSOKeyAdd(key, attribute.offset);
+			mvkPSOKeyAdd(key, attribute.bufferIndex);
+		}
+	}
+	mvkPSOKeyAdd(key, desc.rasterSampleCount);
+	mvkPSOKeyAdd(key, desc.alphaToCoverageEnabled);
+	mvkPSOKeyAdd(key, desc.alphaToOneEnabled);
+	mvkPSOKeyAdd(key, desc.rasterizationEnabled);
+	mvkPSOKeyAdd(key, desc.maxVertexAmplificationCount);
+	for (NSUInteger idx = 0; idx < 8; ++idx) {
