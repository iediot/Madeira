+class MVKPipelineStateCache {
+public:
+	template<class Descriptor, class State> State get(id<MTLDevice> device, Descriptor* desc) {
+		if (!capacity()) { return nil; }
+		auto key = mvkPSOKey(device, desc);
+		std::lock_guard<std::mutex> lock(_lock);
+		auto it = _entries.find(key);
+		if (it == _entries.end()) { mvkTimePSOCacheResult(false); return nil; }
+		_lru.splice(_lru.begin(), _lru, it->second.lru);
+		mvkTimePSOCacheResult(true);
+		return (State)[it->second.state retain];
+	}
+	template<class Descriptor> void put(id<MTLDevice> device, Descriptor* desc, id state) {
+		if (!state || !capacity()) { return; }
+		auto key = mvkPSOKey(device, desc);
+		std::lock_guard<std::mutex> lock(_lock);
+		auto found = _entries.find(key);
+		if (found != _entries.end()) {
+			_lru.splice(_lru.begin(), _lru, found->second.lru);
+			return;
+		}
+		_lru.push_front(key);
+		_entries.emplace(key, Entry{ [state retain], _lru.begin() });
+		while (_entries.size() > capacity()) {
+			auto old = _entries.find(_lru.back());
+			[old->second.state release];
+			_entries.erase(old);
+			_lru.pop_back();
+		}
+	}
+	std::pair<size_t, size_t> occupancy() {
+		std::lock_guard<std::mutex> lock(_lock);
+		return { _entries.size(), capacity() };
+	}
+	void trim() {
+		std::lock_guard<std::mutex> lock(_lock);
+		while (_entries.size() > capacity()) {
+			auto old = _entries.find(_lru.back());
+			[old->second.state release];
+			_entries.erase(old);
+			_lru.pop_back();
+		}
+	}
+private:
+	struct Entry { id state; std::list<std::string>::iterator lru; };
+	static size_t capacity() {
+		static size_t cap = [] {
+			const char* value = getenv("MVK_MADEIRA_PSO_CACHE");
+			return (value && *value) ? (size_t)strtoull(value, nullptr, 10) : (size_t)4096;
+		}();
+		return mvkMadeiraPressureCapacity(cap, 128);
+	}
+	std::mutex _lock;
+	std::list<std::string> _lru;
+	std::unordered_map<std::string, Entry> _entries;
+};
+
+MVKPipelineStateCache& mvkPipelineStateCache() {
+	static MVKPipelineStateCache* cache = new MVKPipelineStateCache();
+	return *cache;
+}
