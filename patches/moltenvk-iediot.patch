+		mvkPSOKeyAdd(key, color.writeMask);
+	}
+	mvkPSOKeyAdd(key, desc.depthAttachmentPixelFormat);
+	mvkPSOKeyAdd(key, desc.stencilAttachmentPixelFormat);
+	mvkPSOKeyAdd(key, desc.inputPrimitiveTopology);
+	mvkPSOKeyAdd(key, desc.tessellationPartitionMode);
+	mvkPSOKeyAdd(key, desc.maxTessellationFactor);
+	mvkPSOKeyAdd(key, desc.tessellationFactorScaleEnabled);
+	mvkPSOKeyAdd(key, desc.tessellationFactorFormat);
+	mvkPSOKeyAdd(key, desc.tessellationControlPointIndexType);
+	mvkPSOKeyAdd(key, desc.tessellationFactorStepFunction);
+	mvkPSOKeyAdd(key, desc.tessellationOutputWindingOrder);
+	for (NSUInteger idx = 0; idx < 31; ++idx) {
+		mvkPSOKeyAdd(key, desc.vertexBuffers[idx].mutability);
+		mvkPSOKeyAdd(key, desc.fragmentBuffers[idx].mutability);
+	}
+	mvkPSOKeyAdd(key, desc.supportIndirectCommandBuffers);
+	mvkPSOKeyAddLibraries(key, desc.vertexPreloadedLibraries);
+	mvkPSOKeyAddLibraries(key, desc.fragmentPreloadedLibraries);
+	mvkPSOKeyAddLinkedFunctions(key, desc.vertexLinkedFunctions);
+	mvkPSOKeyAddLinkedFunctions(key, desc.fragmentLinkedFunctions);
+	mvkPSOKeyAdd(key, desc.supportAddingVertexBinaryFunctions);
+	mvkPSOKeyAdd(key, desc.supportAddingFragmentBinaryFunctions);
+	mvkPSOKeyAdd(key, desc.maxVertexCallStackDepth);
+	mvkPSOKeyAdd(key, desc.maxFragmentCallStackDepth);
+	mvkPSOKeyAdd(key, desc.sampleMaskMVK);
+	mvkPSOKeyAdd(key, desc.logicOperationEnabledMVK);
+	mvkPSOKeyAdd(key, desc.logicOperationMVK);
+#if MVK_XCODE_16
+	if (@available(iOS 18.0, macOS 15.0, *)) { mvkPSOKeyAdd(key, desc.shaderValidation); }
+#endif
+	return key;
+}
