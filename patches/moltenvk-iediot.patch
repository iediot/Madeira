+		while ( !_madeiraParkedFences.empty() && _madeiraParkedFences.front().first <= oldest ) {
+			ready.push_back(_madeiraParkedFences.front().second);
+			_madeiraParkedFences.pop_front();
+		}
+	}
+	for (auto* fence : ready) {
+		fence->signal();
+		fence->release();
+	}
+}
