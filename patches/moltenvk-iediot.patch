+	void appendPage(Shard& shard, unsigned index) {
+		// UUID avoids replacing another process's page. Concurrent processes may
+		// duplicate cache entries, but cannot truncate each other's archive files.
+		NSString* file = [NSString stringWithFormat:@"%02u-%@.metalarc", index, NSUUID.UUID.UUIDString];
+		shard.pages.push_back([[NSURL fileURLWithPath:[_directory stringByAppendingPathComponent:file]] retain]);
+	}
+
+	id<MTLBinaryArchive> load(NSURL* url) {
+		if (![NSFileManager.defaultManager fileExistsAtPath:url.path]) { return nil; }
+		MTLBinaryArchiveDescriptor* desc = [MTLBinaryArchiveDescriptor new];
+		desc.url = url;
+		NSError* error = nil;
+		id<MTLBinaryArchive> archive = [_device newBinaryArchiveWithDescriptor:desc error:&error];
+		[desc release];
+		if (!archive) {
+			fprintf(stderr, "[mvk-archive] discard file=%s error=%s\n", url.path.UTF8String, error.localizedDescription.UTF8String);
+			[NSFileManager.defaultManager removeItemAtURL:url error:nil];
+		}
+		return archive;
+	}
+
+	void flush(Shard& shard, unsigned index) {
+		if (!shard.dirty) { return; }
+		NSURL* url = shard.pages.back();
+		NSURL* temp = [NSURL fileURLWithPath:[url.path stringByAppendingString:@".tmp"]];
+		NSError* error = nil;
+		bool ok = [shard.archive serializeToURL:temp error:&error];
+		// Rename on the same filesystem leaves the last good archive intact on failure.
+		if (ok) { ok = rename(temp.path.fileSystemRepresentation, url.path.fileSystemRepresentation) == 0; }
+		fprintf(stderr, "[mvk-archive] serialize shard=%u additions=%u hits=%llu misses=%llu ok=%d file=%s error=%s\n", index, shard.dirty, (unsigned long long)_hits.load(), (unsigned long long)_misses.load(), ok, url.path.UTF8String, error ? error.localizedDescription.UTF8String : (ok ? "none" : strerror(errno)));
+		if (!ok) {
+			// Do not grow memory indefinitely if storage is full or unavailable.
+			[NSFileManager.defaultManager removeItemAtURL:temp error:nil];
+			shard.dirty = 0;
+			[shard.archive release];
+			shard.archive = nil;
+			return;
+		}
+		shard.dirty = 0;
+		[shard.archive release];
+		shard.archive = nil;
+		// Bound the size of a resident page, allowing one batch of overshoot. Disk
+		// storage has no total size limit; old pages remain available for lookup.
+		if ([[NSFileManager.defaultManager attributesOfItemAtPath:url.path error:nil] fileSize] >= 8 * 1024 * 1024) {
+			id<MTLBinaryArchive> done = load(url);   // finished: searched from now on
+			if (done) { [shard.frozen addObject:done]; [done release]; }
+			appendPage(shard, index);
+		}
+	}
+
+	id compile(MTLRenderPipelineDescriptor* d, MTLPipelineOption options, NSError** error) {
+		return [_device newRenderPipelineStateWithDescriptor:d options:options reflection:nil error:error];
+	}
+	id compile(MTLComputePipelineDescriptor* d, MTLPipelineOption options, NSError** error) {
+		return [_device newComputePipelineStateWithDescriptor:d options:options reflection:nil error:error];
+	}
+	bool add(id<MTLBinaryArchive> archive, MTLRenderPipelineDescriptor* d, NSError** error) {
+		return [archive addRenderPipelineFunctionsWithDescriptor:d error:error];
+	}
+	bool add(id<MTLBinaryArchive> archive, MTLComputePipelineDescriptor* d, NSError** error) {
+		return [archive addComputePipelineFunctionsWithDescriptor:d error:error];
+	}
+};
