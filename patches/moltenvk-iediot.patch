+void MVKDevice::registerStoreElisionTexture(id<MTLTexture> texture, MVKImage* image) {
+	if (!_madeiraStoreElision.enabled() || !texture || !image) { return; }
+	std::lock_guard<std::mutex> lock(_madeiraStoreElisionTextureLock);
+	auto& images = _madeiraStoreElisionTextures[texture];
+	if (std::find(images.begin(), images.end(), image) == images.end()) { images.push_back(image); }
+}
+
+void MVKDevice::unregisterStoreElisionTexture(id<MTLTexture> texture, MVKImage* image) {
+	if (!_madeiraStoreElision.enabled() || !texture || !image) { return; }
+	std::lock_guard<std::mutex> lock(_madeiraStoreElisionTextureLock);
+	auto it = _madeiraStoreElisionTextures.find(texture);
+	if (it == _madeiraStoreElisionTextures.end()) { return; }
+	auto& images = it->second;
+	images.erase(std::remove(images.begin(), images.end(), image), images.end());
+	if (images.empty()) { _madeiraStoreElisionTextures.erase(it); }
+}
+
+void MVKDevice::markStoreElisionTextureConsumed(id<MTLTexture> texture, const char* reason) {
+	if (!_madeiraStoreElision.enabled() || !texture) { return; }
+	std::lock_guard<std::mutex> lock(_madeiraStoreElisionTextureLock);
+	auto it = _madeiraStoreElisionTextures.find(texture);
+	if (it == _madeiraStoreElisionTextures.end()) { return; }
+	for (MVKImage* image : it->second) { image->markStoreElisionConsumed(reason); }
+}
