diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraAdmission.h b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraAdmission.h
new file mode 100644
index 0000000..36030f9
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraAdmission.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <algorithm>
+#include <cerrno>
+#include <cstdlib>
+#include <cstddef>
+
+// Count bounds, not byte estimates: Metal descriptors retain opaque driver data.
+// User requested a retest after discovering the previous run used reset High
+// graphics settings. Keep an explicit off switch: producer waits remain real,
+// and corrected-settings device validation is still required.
+inline bool mvkMadeiraAdmissionEnabled() {
+    static const bool enabled = [] {
+        const char* value = getenv("MVK_MADEIRA_ASYNC_ADMISSION");
+        // Off unless =1: blocking admission froze Detroit for 9-12 s at a time
+        // (hundreds of producer waits up to 1.9 s; Oct 14 and Oct 16 runs).
+        return value && value[0] == '1' && !value[1];
+    }();
+    return enabled;
+}
+inline size_t mvkMadeiraAdmissionLimit(const char* value, size_t fallback) {
+    if (!value || !*value || *value < '0' || *value > '9') return fallback;
+    char* end = nullptr;
+    errno = 0;
+    unsigned long parsed = strtoul(value, &end, 10);
+    return !errno && end && !*end && parsed >= 1 && parsed <= 4096 ? parsed : fallback;
+}
+inline size_t mvkMadeiraAdmissionCapacity(bool pressure) {
+    static const size_t normal = mvkMadeiraAdmissionLimit(getenv("MVK_MADEIRA_ASYNC_MAX_JOBS"), 256);
+    static const size_t low = mvkMadeiraAdmissionLimit(getenv("MVK_MADEIRA_ASYNC_PRESSURE_JOBS"), 64);
+    return pressure ? std::min(normal, low) : normal;
+}
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraCompiler.h b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraCompiler.h
new file mode 100644
index 0000000..0d4e6a8
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraCompiler.h
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#import <Metal/Metal.h>
+#include <chrono>
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+
+// Keep only API submission under the device monitor. Waiting for Metal's
+// compiler while holding it prevented game threads from submitting libraries.
+struct MVKMadeiraCompileResult {
+	std::mutex lock;
+	std::condition_variable cv;
+	bool done = false;
+	id state = nil;
+	NSError* error = nil;
+	void complete(id compiled, NSError* failure) {
+		{
+			std::lock_guard<std::mutex> guard(lock);
+			state = [compiled retain];
+			error = [failure retain];
+			done = true;
+		}
+		cv.notify_one();
+	}
+	~MVKMadeiraCompileResult() { [state release]; [error release]; }
+};
+
+inline uint64_t mvkMadeiraCompilerNow() {
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// Returns retained state/error, as the synchronous Metal APIs do for state.
+inline id mvkMadeiraCompilePipeline(id<MTLDevice> device, id descriptor, bool compute,
+								 NSError** error, uint64_t& lockNS, uint64_t& submitNS, uint64_t& waitNS) {
+	auto result = std::make_shared<MVKMadeiraCompileResult>();
+	uint64_t start = mvkMadeiraCompilerNow();
+	@synchronized(device) {
+		lockNS = mvkMadeiraCompilerNow() - start;
+		start = mvkMadeiraCompilerNow();
+		if (compute) {
+			[device newComputePipelineStateWithDescriptor:(MTLComputePipelineDescriptor*)descriptor
+				options:MTLPipelineOptionNone completionHandler:^(id<MTLComputePipelineState> state,
+					MTLComputePipelineReflection*, NSError* failure) { result->complete(state, failure); }];
+		} else {
+			[device newRenderPipelineStateWithDescriptor:(MTLRenderPipelineDescriptor*)descriptor
+				completionHandler:^(id<MTLRenderPipelineState> state, NSError* failure) {
+					result->complete(state, failure);
+				}];
+		}
+		submitNS = mvkMadeiraCompilerNow() - start;
+	}
+	start = mvkMadeiraCompilerNow();
+	std::unique_lock<std::mutex> guard(result->lock);
+	result->cv.wait(guard, [&] { return result->done; });
+	waitNS = mvkMadeiraCompilerNow() - start;
+	if (error) { *error = [result->error retain]; }
+	return [result->state retain];
+}
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraConversionCache.h b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraConversionCache.h
new file mode 100644
index 0000000..6d31f83
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraConversionCache.h
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdint>
+#include <list>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+#include <algorithm>
+
+struct MVKMadeiraConversionStats {
+	uint64_t entries = 0, bytes = 0, cap = 0, hits = 0, misses = 0, evictions = 0;
+};
+
+// Pure conversion data only: no Metal objects or shader-module references.
+// A hash selects candidates; complete SPIR-V and the converter configuration
+// determine a hit. The payload budget and entry limit independently bound retention.
+template<class Config, class Result>
+class MVKMadeiraConversionCache {
+	struct Entry { uint64_t hash, bytes; std::vector<uint32_t> spirv; Config config; Result result; };
+	using Iterator = typename std::list<Entry>::iterator;
+	std::mutex _lock;
+	std::list<Entry> _lru;
+	std::unordered_map<uint64_t, std::vector<Iterator>> _index;
+	MVKMadeiraConversionStats _stats;
+	size_t _entryLimit;
+public:
+	explicit MVKMadeiraConversionCache(uint64_t cap, size_t entryLimit = 512) : _entryLimit(entryLimit) { _stats.cap = cap; }
+	bool get(uint64_t hash, const std::vector<uint32_t>& spirv, Config& config, Result& result) {
+		std::lock_guard<std::mutex> guard(_lock);
+		auto found = _index.find(hash);
+		if (found != _index.end()) {
+			for (auto entry : found->second) {
+				if (entry->spirv == spirv && entry->config.matches(config)) {
+					result = entry->result;
+					config.alignWith(entry->config);
+					_lru.splice(_lru.begin(), _lru, entry);
+					++_stats.hits;
+					return true;
+				}
+			}
+		}
+		++_stats.misses;
+		return false;
+	}
+	void put(uint64_t hash, const std::vector<uint32_t>& spirv, const Config& config,
+			 const Result& result, uint64_t bytes) {
+		std::lock_guard<std::mutex> guard(_lock);
+		if (!_stats.cap || !_entryLimit || bytes > _stats.cap) { return; }
+		auto found = _index.find(hash);
+		if (found != _index.end()) {
+			for (auto entry : found->second) {
+				if (entry->spirv == spirv && entry->config.matches(config)) { return; }
+			}
+		}
+		while (!_lru.empty() && (_stats.bytes > _stats.cap - bytes || _lru.size() >= _entryLimit)) {
+			auto old = std::prev(_lru.end());
+			auto bucket = _index.find(old->hash);
+			auto& items = bucket->second;
+			items.erase(std::find(items.begin(), items.end(), old));
+			if (items.empty()) { _index.erase(bucket); }
+			_stats.bytes -= old->bytes;
+			_lru.erase(old);
+			++_stats.evictions;
+		}
+		_lru.push_front({hash, bytes, spirv, config, result});
+		_index[hash].push_back(_lru.begin());
+		_stats.bytes += bytes;
+	}
+	MVKMadeiraConversionStats snapshot() {
+		std::lock_guard<std::mutex> guard(_lock);
+		auto stats = _stats;
+		stats.entries = _lru.size();
+		return stats;
+	}
+	void trim(uint64_t targetBytes) {
+		std::lock_guard<std::mutex> guard(_lock);
+		while (!_lru.empty() && _stats.bytes > targetBytes) {
+			auto old = std::prev(_lru.end());
+			auto bucket = _index.find(old->hash);
+			auto& items = bucket->second;
+			items.erase(std::find(items.begin(), items.end(), old));
+			if (items.empty()) { _index.erase(bucket); }
+			_stats.bytes -= old->bytes;
+			_lru.erase(old);
+			++_stats.evictions;
+		}
+	}
+};
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraJobQueue.h b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraJobQueue.h
new file mode 100644
index 0000000..37c63c2
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraJobQueue.h
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <algorithm>
+
+// Called with the scheduler mutex held. A needed job need not be at the head:
+// ordinary on-screen draws can reprioritize the deque while a full-screen wait runs.
+template<class Queue>
+auto mvkMadeiraNextJob(Queue& queue, bool urgentOnly, bool hasUrgent, bool stopping) {
+	if (urgentOnly || (hasUrgent && !stopping)) {
+		return std::find_if(queue.begin(), queue.end(), [](auto job) { return !job->urgentWaits.empty(); });
+	}
+	return queue.begin();
+}
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraMemoryPressure.h b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraMemoryPressure.h
new file mode 100644
index 0000000..7753498
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraMemoryPressure.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+bool mvkMadeiraMemoryPressureActive();
+void mvkMadeiraTrimLibraryCache();
+inline size_t mvkMadeiraPressureCapacity(size_t cap, size_t floor, unsigned divisor = 4) {
+    return mvkMadeiraMemoryPressureActive() ? std::min(cap, std::max(floor, cap / divisor)) : cap;
+}
+
+// Ignore unknown headroom; enter below 512 MiB, recover only after 30 seconds
+// continuously above 1 GiB. This avoids repeatedly shrinking/growing caches.
+struct MVKMadeiraMemoryPressurePolicy {
+    bool active = false;
+    uint64_t healthySince = 0;
+    bool update(uint64_t available, uint64_t nowMillis) {
+        bool before = active;
+        if (!available) { healthySince = 0; return false; }
+        if (available < 512ull * 1024 * 1024) {
+            active = true;
+            healthySince = 0;
+        } else if (available > 1024ull * 1024 * 1024 && active) {
+            if (!healthySince) healthySince = nowMillis;
+            if (nowMillis - healthySince >= 30000) { active = false; healthySince = 0; }
+        } else { healthySince = 0; }
+        return before != active;
+    }
+};
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraShaderPrewarm.h b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraShaderPrewarm.h
new file mode 100644
index 0000000..d2f13c3
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraShaderPrewarm.h
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: Apache-2.0
+// Included beside the disk-library helpers, inside their anonymous namespace.
+// Hints only: the normal converter/cache key still selects the actual library.
+std::atomic<uint64_t> g_mvkWarmPending{0}, g_mvkWarmRequests{0}, g_mvkWarmLoaded{0};
+std::atomic<uint64_t> g_mvkWarmLearned{0}, g_mvkWarmDropped{0}, g_mvkWarmWritesFailed{0};
+std::atomic<uint64_t> g_mvkWarmNoHint{0}, g_mvkWarmCached{0}, g_mvkWarmDiskMiss{0};
+std::atomic<uint64_t> g_mvkWarmPressureSkipped{0}, g_mvkWarmRequestDropped{0}, g_mvkWarmLearnDropped{0};
+
+bool mvkShaderPrewarmEnabled() {
+	const char* value = getenv("MVK_MADEIRA_SHADER_PREWARM");
+	return (!value || strcmp(value, "0")) && mvkLibCacheCap();
+}
+
+dispatch_queue_t mvkShaderPrewarmQueue() {
+	static dispatch_queue_t queue = [] {
+		auto q = dispatch_queue_create("MoltenVK.shader-prefetch", DISPATCH_QUEUE_SERIAL);
+		dispatch_set_target_queue(q, dispatch_get_global_queue(QOS_CLASS_UTILITY, 0));
+		return q;
+	}();
+	return queue;
+}
+
+bool mvkShaderPrewarmReserve() {
+	uint64_t pending = g_mvkWarmPending.load();
+	while (pending < 32) {
+		if (g_mvkWarmPending.compare_exchange_weak(pending, pending + 1)) { return true; }
+	}
+	++g_mvkWarmDropped;
+	return false;
+}
+
+NSString* mvkShaderPrewarmModuleKey(const MVKShaderModuleKey& key) {
+	return [NSString stringWithFormat:@"%016zx-%zx", key.codeHash, key.codeSize];
+}
+
+bool mvkShaderPrewarmValidRecipe(id recipe) {
+	if (![recipe isKindOfClass:NSDictionary.class]) { return false; }
+	id key = recipe[@"key"], length = recipe[@"length"], entry = recipe[@"entry"];
+	if (![key isKindOfClass:NSString.class] || [key length] != 16 ||
+		![length isKindOfClass:NSNumber.class] || ![length unsignedLongLongValue] || [length unsignedLongLongValue] > 8 * 1024 * 1024 ||
+		![entry isKindOfClass:NSString.class] || ![entry length] || [entry length] > 256) { return false; }
+	for (NSUInteger i = 0; i < 16; ++i) {
+		unichar c = [key characterAtIndex:i];
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { return false; }
+	}
+	return true;
+}
+
+// Queue-confined metadata: at most four game/device namespaces, 512 modules
+// per namespace, two observed variants per module and 256 KiB on disk.
+NSMutableDictionary* mvkShaderPrewarmContexts() {
+	static NSMutableDictionary* contexts = [NSMutableDictionary new];
+	return contexts;
+}
+
+NSMutableDictionary* mvkShaderPrewarmContext(NSString* directory) {
+	auto contexts = mvkShaderPrewarmContexts();
+	NSMutableDictionary* context = contexts[directory];
+	if (context) { return context; }
+	if (contexts.count >= 4) {
+		NSString* victim = nil;
+		for (NSString* name in contexts) {
+			if (![contexts[name][@"writeQueued"] boolValue]) { victim = name; break; }
+		}
+		if (!victim) { ++g_mvkWarmDropped; return nil; }
+		[contexts removeObjectForKey:victim];
+	}
+	NSMutableDictionary* modules = [NSMutableDictionary dictionary];
+	NSString* path = [directory stringByAppendingPathComponent:@"module-prefetch-v1.plist"];
+	NSDictionary* attrs = [NSFileManager.defaultManager attributesOfItemAtPath:path error:nil];
+	if (attrs && attrs.fileSize <= 256 * 1024) {
+		NSData* data = nil;
+		@try {
+			NSFileHandle* file = [NSFileHandle fileHandleForReadingAtPath:path];
+			data = [file readDataOfLength:256 * 1024 + 1];
+			[file closeFile];
+		} @catch (NSException*) { /* A cache I/O failure must not fail a shader. */ }
+		id saved = data && data.length <= 256 * 1024 ? [NSPropertyListSerialization propertyListWithData:data options:NSPropertyListImmutable format:nil error:nil] : nil;
+		if ([saved isKindOfClass:NSDictionary.class]) {
+			for (id module in saved) {
+				if (modules.count >= 512) { break; }
+				id recipes = saved[module];
+				if (![module isKindOfClass:NSString.class] || [module length] > 40 || ![recipes isKindOfClass:NSArray.class]) { continue; }
+				NSMutableArray* valid = [NSMutableArray array];
+				for (id recipe in recipes) {
+					if (valid.count >= 2) { break; }
+					if (mvkShaderPrewarmValidRecipe(recipe)) { [valid addObject:recipe]; }
+				}
+				if (valid.count) { modules[module] = valid; }
+			}
+		}
+	}
+	context = [NSMutableDictionary dictionaryWithDictionary:@{
+		@"modules": modules, @"order": [NSMutableArray arrayWithArray:modules.allKeys], @"writeQueued": @NO }];
+	contexts[directory] = context;
+	return context;
+}
+
+void mvkShaderPrewarmScheduleWrite(NSString* directory, NSMutableDictionary* context) {
+	if ([context[@"writeQueued"] boolValue]) { return; }
+	context[@"writeQueued"] = @YES;
+	// One delayed write per context, rather than one disk write per function.
+	dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), mvkShaderPrewarmQueue(), ^{ @autoreleasepool {
+		NSData* data = [NSPropertyListSerialization dataWithPropertyList:context[@"modules"] format:NSPropertyListBinaryFormat_v1_0 options:0 error:nil];
+		if (!data || data.length > 256 * 1024 ||
+			![NSFileManager.defaultManager createDirectoryAtPath:directory withIntermediateDirectories:YES attributes:nil error:nil] ||
+			![data writeToFile:[directory stringByAppendingPathComponent:@"module-prefetch-v1.plist"] options:NSDataWritingAtomic error:nil]) { ++g_mvkWarmWritesFailed; }
+		context[@"writeQueued"] = @NO;
+	} });
+}
+
+void mvkShaderPrewarmRemember(id<MTLDevice> device, const MVKShaderModuleKey& module,
+							uint64_t key, size_t length, const std::string& entry) {
+	if (!mvkShaderPrewarmEnabled() || !key || !length || length > 8 * 1024 * 1024 || entry.empty() || entry.size() > 256) { return; }
+	if (!mvkShaderPrewarmReserve()) { ++g_mvkWarmLearnDropped; return; }
+	// Queue owns Foundation copies only: no shader-module or Vulkan-device pointer.
+	NSString* directory = [mvkPrecompDirectory(device) copy];
+	NSString* moduleName = [mvkShaderPrewarmModuleKey(module) copy];
+	NSDictionary* recipe = [@{@"key": mvkPrecompKeyString(key), @"length": @(length), @"entry": @(entry.c_str())} copy];
+	dispatch_async(mvkShaderPrewarmQueue(), ^{ @autoreleasepool {
+		auto context = mvkShaderPrewarmContext(directory);
+		if (!context) {
+			[recipe release]; [moduleName release]; [directory release];
+			--g_mvkWarmPending;
+			return;
+		}
+		NSMutableDictionary* modules = context[@"modules"];
+		NSMutableArray* order = context[@"order"];
+		NSArray* old = modules[moduleName];
+		if (![old containsObject:recipe]) {
+			NSMutableArray* variants = [NSMutableArray arrayWithObject:recipe];
+			if (old.count) { [variants addObject:old.firstObject]; }
+			modules[moduleName] = variants;
+			[order removeObject:moduleName];
+			[order addObject:moduleName];
+			while (order.count > 512) { [modules removeObjectForKey:order.firstObject]; [order removeObjectAtIndex:0]; }
+			++g_mvkWarmLearned;
+			mvkShaderPrewarmScheduleWrite(directory, context);
+		}
+		[recipe release]; [moduleName release]; [directory release];
+		--g_mvkWarmPending;
+	} });
+}
+
+void mvkShaderPrewarmRequest(id<MTLDevice> device, const MVKShaderModuleKey& module) {
+	if (!mvkShaderPrewarmEnabled()) { return; }
+	if (!mvkShaderPrewarmReserve()) { ++g_mvkWarmRequestDropped; return; }
+	++g_mvkWarmRequests;
+	device = [device retain];
+	NSString* directory = [mvkPrecompDirectory(device) copy];
+	NSString* moduleName = [mvkShaderPrewarmModuleKey(module) copy];
+	dispatch_async(mvkShaderPrewarmQueue(), ^{ @autoreleasepool {
+		NSArray* recipes = mvkShaderPrewarmContext(directory)[@"modules"][moduleName];
+		if (!recipes.count) { ++g_mvkWarmNoHint; }
+		for (NSDictionary* recipe in recipes) {
+			if (!mvkShaderPrewarmValidRecipe(recipe)) { continue; }
+			uint64_t key = strtoull([recipe[@"key"] UTF8String], nullptr, 16);
+			size_t length = [recipe[@"length"] unsignedLongLongValue];
+			id<MTLLibrary> library = mvkLibCacheGet(key, length);
+			if (library) { ++g_mvkWarmCached; [library release]; continue; }
+			// Speculative library loads must not fight the pressure trimmer.
+			// The normal pipeline path still loads/compiles every needed shader.
+			if (mvkMadeiraMemoryPressureActive()) { ++g_mvkWarmPressureSkipped; continue; }
+			std::string entry = [recipe[@"entry"] UTF8String];
+			library = mvkPrecompLoad(device, key, entry, directory);
+			if (library) { mvkLibCachePut(key, length, library); [library release]; ++g_mvkWarmLoaded; }
+			else { ++g_mvkWarmDiskMiss; }
+		}
+		[moduleName release]; [directory release]; [device release];
+		--g_mvkWarmPending;
+	} });
+}
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraStoreElision.h b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraStoreElision.h
new file mode 100644
index 0000000..0cfdeed
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKMadeiraStoreElision.h
@@ -0,0 +1,262 @@
+/*
+ * MVKMadeiraStoreElision.h
+ *
+ * Copyright (c) 2026 The Brenwill Workshop Ltd. (http://www.brenwill.com)
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+struct MVKMadeiraStoreSignature {
+	uint64_t renderPass = 0;
+	uint32_t subpass = 0;
+	uint32_t attachment = 0;
+	uint32_t aspect = 0;
+	uint32_t width = 0;
+	uint32_t height = 0;
+
+	bool operator==(const MVKMadeiraStoreSignature& other) const {
+		return renderPass == other.renderPass && subpass == other.subpass &&
+			attachment == other.attachment && aspect == other.aspect &&
+			width == other.width && height == other.height;
+	}
+};
+
+struct MVKMadeiraStoreSignatureHash {
+	size_t operator()(const MVKMadeiraStoreSignature& sig) const {
+		uint64_t hash = sig.renderPass;
+		auto add = [&](uint64_t value) { hash ^= value + 0x9e3779b97f4a7c15ull + (hash << 6) + (hash >> 2); };
+		add(sig.subpass); add(sig.attachment); add(sig.aspect); add(sig.width); add(sig.height);
+		return (size_t)hash;
+	}
+};
+
+struct MVKMadeiraStoreMetadata {
+	uint64_t bytes = 0;
+	uint32_t format = 0;
+	uint32_t width = 0;
+	uint32_t height = 0;
+	const char* formatName = nullptr;
+};
+
+struct MVKMadeiraStoreElisionSnapshot {
+	uint64_t tracked = 0;
+	uint64_t eligible = 0;
+	uint64_t elided = 0;
+	uint64_t reverted = 0;
+	uint64_t estimatedBytesPerFrame = 0;
+};
+
+class MVKMadeiraStoreElisionTracker {
+public:
+	MVKMadeiraStoreElisionTracker() {
+		const char* mode = getenv("MVK_MADEIRA_STORE_ELISION");
+		_mode = mode ? std::max(0, std::min(atoi(mode), 2)) : 0;
+		const char* frames = getenv("MVK_MADEIRA_STORE_ELISION_FRAMES");
+		_threshold = frames && *frames ? std::max(1u, (uint32_t)strtoul(frames, nullptr, 10)) : 240;
+		_lastLog = std::chrono::steady_clock::now();
+		if (_mode) {
+			fprintf(stderr, "[mvk-store-elision] mode=%d frames=%u (1=learn, 2=apply)\n", _mode, _threshold);
+		}
+	}
+
+	MVKMadeiraStoreElisionTracker(int mode, uint32_t threshold) :
+		_lastLog(std::chrono::steady_clock::now()), _threshold(std::max(1u, threshold)),
+		_mode(std::max(0, std::min(mode, 2))) {}
+
+	bool enabled() const { return _mode != 0; }
+	int mode() const { return _mode; }
+
+	void overwrite(uint64_t image, uint64_t frame) {
+		if (!_mode || !image) { return; }
+		std::lock_guard<std::mutex> lock(_lock);
+		auto imgIt = _pending.find(image);
+		if (imgIt == _pending.end()) { maybeLogLocked(); return; }
+		for (const Pending& pending : imgIt->second) {
+			if (!pending.active) { continue; }
+			auto& state = _signatures[pending.signature];
+			if (state.lastWastedFrame != frame) {
+				state.streak = state.lastWastedFrame + 1 == frame ? state.streak + 1 : 1;
+				state.lastWastedFrame = frame;
+				state.wastedBytes += state.metadata.bytes;
+			}
+			if (!state.ineligible && state.streak >= _threshold) { state.eligible = true; }
+		}
+		_pending.erase(imgIt);
+		maybeLogLocked();
+	}
+
+	void consume(uint64_t image, uint64_t frame, const char* reason) {
+		if (!_mode || !image) { return; }
+		std::lock_guard<std::mutex> lock(_lock);
+		auto imgIt = _pending.find(image);
+		if (imgIt == _pending.end()) { maybeLogLocked(); return; }
+		for (const Pending& pending : imgIt->second) {
+			if (!pending.active) { continue; }
+			auto& state = _signatures[pending.signature];
+			bool wasElided = pending.elided;
+			state.ineligible = true;
+			state.eligible = false;
+			state.eliding = false;
+			state.streak = 0;
+			if (wasElided) {
+				++_reverted;
+				fprintf(stderr, "[mvk-store-elision] ERROR consumed-after-elision image=%llu pass=%llu subpass=%u attachment=%u aspect=0x%x extent=%ux%u frame=%llu reason=%s; disabling signature forever\n",
+					(unsigned long long)image, (unsigned long long)pending.signature.renderPass,
+					pending.signature.subpass, pending.signature.attachment, pending.signature.aspect,
+					pending.signature.width, pending.signature.height, (unsigned long long)frame,
+					reason ? reason : "unknown");
+			}
+		}
+		_pending.erase(imgIt);
+		maybeLogLocked();
+	}
+
+	bool shouldElide(const MVKMadeiraStoreSignature& signature,
+					 const MVKMadeiraStoreMetadata& metadata,
+					 bool staticallySafe) {
+		if (!_mode) { return false; }
+		std::lock_guard<std::mutex> lock(_lock);
+		auto& state = _signatures[signature];
+		state.metadata = metadata;
+		if (state.ineligible) { return false; }
+		if (staticallySafe) { state.eligible = true; }
+		bool elide = staticallySafe || (_mode == 2 && state.eligible);
+		state.eliding = elide;
+		maybeLogLocked();
+		return elide;
+	}
+
+	void stored(uint64_t image, uint32_t aspect,
+				const MVKMadeiraStoreSignature& signature,
+				const MVKMadeiraStoreMetadata& metadata,
+				bool elided, uint64_t frame) {
+		if (!_mode || !image) { return; }
+		std::lock_guard<std::mutex> lock(_lock);
+		auto& state = _signatures[signature];
+		state.metadata = metadata;
+		if (elided) {
+			if (state.lastElidedFrame == frame) {
+				++state.elidedStoresInFrame;
+			} else {
+				state.lastElidedFrame = frame;
+				state.elidedStoresInFrame = 1;
+			}
+			++state.elidedStores;
+		}
+		auto& pending = _pending[image];
+		for (Pending& old : pending) {
+			if (old.active && old.aspect == aspect) {
+				// A render-load/overwrite event should always precede this. Missing one is unsafe.
+				auto& oldState = _signatures[old.signature];
+				oldState.ineligible = true;
+				oldState.eligible = false;
+				oldState.eliding = false;
+				old.active = false;
+			}
+		}
+		pending.push_back({ signature, aspect, elided, true });
+		maybeLogLocked();
+	}
+
+	void forgetImage(uint64_t image) {
+		if (!_mode || !image) { return; }
+		std::lock_guard<std::mutex> lock(_lock);
+		_pending.erase(image);
+	}
+
+	MVKMadeiraStoreElisionSnapshot snapshot() {
+		std::lock_guard<std::mutex> lock(_lock);
+		return snapshotLocked();
+	}
+
+private:
+	struct SignatureState {
+		MVKMadeiraStoreMetadata metadata;
+		uint64_t lastWastedFrame = 0;
+		uint64_t wastedBytes = 0;
+		uint64_t lastElidedFrame = 0;
+		uint64_t elidedStores = 0;
+		uint32_t streak = 0;
+		uint32_t elidedStoresInFrame = 0;
+		bool eligible = false;
+		bool ineligible = false;
+		bool eliding = false;
+	};
+	struct Pending {
+		MVKMadeiraStoreSignature signature;
+		uint32_t aspect;
+		bool elided;
+		bool active;
+	};
+
+	MVKMadeiraStoreElisionSnapshot snapshotLocked() const {
+		MVKMadeiraStoreElisionSnapshot result;
+		result.tracked = _signatures.size();
+		result.reverted = _reverted;
+		for (const auto& entry : _signatures) {
+			const SignatureState& state = entry.second;
+			if (state.eligible && !state.ineligible) { ++result.eligible; }
+			if (state.eliding && state.elidedStores && !state.ineligible) {
+				++result.elided;
+				result.estimatedBytesPerFrame += state.metadata.bytes * state.elidedStoresInFrame;
+			}
+		}
+		return result;
+	}
+
+	void maybeLogLocked() {
+		auto now = std::chrono::steady_clock::now();
+		if (now - _lastLog < std::chrono::seconds(10)) { return; }
+		_lastLog = now;
+		auto snapshot = snapshotLocked();
+		std::array<std::pair<MVKMadeiraStoreSignature, const SignatureState*>, 5> top = {};
+		for (const auto& entry : _signatures) {
+			for (size_t i = 0; i < top.size(); ++i) {
+				if (!top[i].second || entry.second.wastedBytes > top[i].second->wastedBytes) {
+					for (size_t j = top.size() - 1; j > i; --j) { top[j] = top[j - 1]; }
+					top[i] = { entry.first, &entry.second };
+					break;
+				}
+			}
+		}
+		fprintf(stderr, "[mvk-store-elision] tracked=%llu eligible=%llu elided=%llu reverted=%llu estimated-bytes/frame=%llu top=",
+			(unsigned long long)snapshot.tracked, (unsigned long long)snapshot.eligible,
+			(unsigned long long)snapshot.elided, (unsigned long long)snapshot.reverted,
+			(unsigned long long)snapshot.estimatedBytesPerFrame);
+		bool first = true;
+		for (const auto& item : top) {
+			if (!item.second || !item.second->wastedBytes) { continue; }
+			fprintf(stderr, "%s{att=%u aspect=0x%x fmt=%s(%u) extent=%ux%u wasted=%llu}", first ? "" : ",",
+				item.first.attachment, item.first.aspect,
+				item.second->metadata.formatName ? item.second->metadata.formatName : "unknown",
+				item.second->metadata.format,
+				item.second->metadata.width, item.second->metadata.height,
+				(unsigned long long)item.second->wastedBytes);
+			first = false;
+		}
+		fprintf(stderr, "%s\n", first ? "none" : "");
+	}
+
+	std::mutex _lock;
+	std::unordered_map<MVKMadeiraStoreSignature, SignatureState, MVKMadeiraStoreSignatureHash> _signatures;
+	std::unordered_map<uint64_t, std::vector<Pending>> _pending;
+	std::chrono::steady_clock::time_point _lastLog;
+	uint64_t _reverted = 0;
+	uint32_t _threshold = 240;
+	int _mode = 0;
+};
