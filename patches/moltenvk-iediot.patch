+		@"schemaVersion": @1, @"key": mvkPrecompKeyString(key),
+		@"languageVersion": @(options.languageVersion), @"fastMathEnabled": @(options.fastMathEnabled),
+		@"preserveInvariance": @(options.preserveInvariance), @"preprocessorMacros": macros }];
