+		std::lock_guard<std::mutex> lock(_madeiraInFlightLock);
+		auto it = std::find(_madeiraInFlight.begin(), _madeiraInFlight.end(), seq);
+		if (it != _madeiraInFlight.end()) { _madeiraInFlight.erase(it); }
