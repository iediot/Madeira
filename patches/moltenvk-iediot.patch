+/** Returns the armed frame dump, or null; a relaxed load when nothing is armed. */
+static std::shared_ptr<MVKMadeiraFrameDump> mvkMadeiraFrameDumpCurrent() {
+	if ( !_mvkMadeiraDumpArmed.load(std::memory_order_relaxed) ) { return nullptr; }
+	std::lock_guard<std::mutex> guard(mvkMadeiraDumpLock());
+	return mvkMadeiraDumpArmedFrame();
+}
+
+void mvkMadeiraFrameDumpTick() {
+	static const bool enabled = mvkMadeiraDumpEnv("MVK_MADEIRA_FRAME_DUMP", 1) != 0;
+	if ( !enabled ) { return; }
+
+	// The present that ends the armed frame.
+	if (_mvkMadeiraDumpArmed.load(std::memory_order_relaxed)) {
+		std::shared_ptr<MVKMadeiraFrameDump> closing;
+		{
+			std::lock_guard<std::mutex> guard(mvkMadeiraDumpLock());
+			closing.swap(mvkMadeiraDumpArmedFrame());
+			_mvkMadeiraDumpArmed.store(false);
+		}
+		if (closing) {
+			uint32_t seqs, passes;
+			{
+				std::lock_guard<std::mutex> guard(closing->lock);
+				seqs = closing->nextSeq;
+				passes = closing->nextPass;
+			}
+			fprintf(stderr, "[mvk-dump] frame closed dir=%s passes=%u entries=%u (files finish as command buffers complete)\n",
+					closing->dir.c_str(), passes, seqs);
+		}
+		return;
+	}
+
+	static std::atomic<uint32_t> presents{0};
+	if (presents.fetch_add(1, std::memory_order_relaxed) % 30) { return; }
+
+	static std::string docs, trigger;
+	static std::once_flag once;
+	std::call_once(once, [] {
+		@autoreleasepool {
+			NSString* dir = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+			if (dir) {
+				docs = dir.UTF8String;
+				trigger = docs + "/mvk-dump-now";
+			}
+		}
+	});
+	struct stat st;
+	if (trigger.empty() || stat(trigger.c_str(), &st) != 0) { return; }
+	unlink(trigger.c_str());
+
+	// Never overwrite an earlier dump: take the number after the highest one present.
+	int last = 0;
+	if (DIR* dir = opendir(docs.c_str())) {
+		while (struct dirent* ent = readdir(dir)) {
+			int n = 0;
+			if (sscanf(ent->d_name, "mvk-dump-%d", &n) == 1 && n > last) { last = n; }
+		}
+		closedir(dir);
+	}
+	auto frame = std::make_shared<MVKMadeiraFrameDump>();
+	frame->dir = docs + "/mvk-dump-" + std::to_string(last + 1);
+	if (mkdir(frame->dir.c_str(), 0755) != 0) {
+		fprintf(stderr, "[mvk-dump] refused: cannot create %s: %s\n", frame->dir.c_str(), strerror(errno));
+		frame->dir.clear();	// nothing to index
+		return;
+	}
+	frame->budget = mvkMadeiraDumpEnv("MVK_MADEIRA_FRAME_DUMP_MB", 1536) << 20;
+	frame->inflightCap = mvkMadeiraDumpEnv("MVK_MADEIRA_FRAME_DUMP_INFLIGHT_MB", 768) << 20;
+	frame->maxDim = (uint32_t)mvkMadeiraDumpEnv("MVK_MADEIRA_FRAME_DUMP_MAX_DIM", 4096);
+	frame->inputDraws = (uint32_t)mvkMadeiraDumpEnv("MVK_MADEIRA_FRAME_DUMP_INPUT_DRAWS", 4);
+	mkdir((frame->dir + "/shaders").c_str(), 0755);
+	frame->jsonl = fopen((frame->dir + "/index.jsonl").c_str(), "w");
+	fprintf(stderr, "[mvk-dump] start dir=%s budget=%lluMB inflight=%lluMB max-dim=%u\n", frame->dir.c_str(),
+			(unsigned long long)(frame->budget >> 20), (unsigned long long)(frame->inflightCap >> 20), frame->maxDim);
+	std::lock_guard<std::mutex> guard(mvkMadeiraDumpLock());
+	mvkMadeiraDumpArmedFrame() = frame;
+	_mvkMadeiraDumpArmed.store(true);
+}
+
+static void mvkMadeiraDumpAddTarget(std::vector<MVKMadeiraDumpTarget>& targets, id<MTLTexture> tex,
+									NSUInteger level, NSUInteger slice, NSUInteger depthPlane, const char* slot) {
+	if ( !tex ) { return; }
+	for (auto& t : targets) {
+		if (t.texture == tex && t.level == level && t.slice == slice && t.depthPlane == depthPlane) { return; }
+	}
+	targets.push_back({ [tex retain], (uint32_t)level, (uint32_t)slice, (uint32_t)depthPlane, slot, -1, nullptr, {} });
+}
+
+static void mvkMadeiraDumpCollectAttachments(MTLRenderPassDescriptor* mtlRPDesc, std::vector<MVKMadeiraDumpTarget>& targets) {
+	char slot[32];
+	for (uint32_t i = 0; i < 8; i++) {
+		MTLRenderPassColorAttachmentDescriptor* att = mtlRPDesc.colorAttachments[i];
+		if ( !att.texture ) { continue; }
+		snprintf(slot, sizeof(slot), "color%u", i);
+		mvkMadeiraDumpAddTarget(targets, att.texture, att.level, att.slice, att.depthPlane, slot);
+		snprintf(slot, sizeof(slot), "color%u-resolve", i);
+		mvkMadeiraDumpAddTarget(targets, att.resolveTexture, att.resolveLevel, att.resolveSlice, att.resolveDepthPlane, slot);
+	}
+	MTLRenderPassDepthAttachmentDescriptor* depth = mtlRPDesc.depthAttachment;
+	mvkMadeiraDumpAddTarget(targets, depth.texture, depth.level, depth.slice, depth.depthPlane, "depth");
+	mvkMadeiraDumpAddTarget(targets, depth.resolveTexture, depth.resolveLevel, depth.resolveSlice, depth.resolveDepthPlane, "depth-resolve");
+	MTLRenderPassStencilAttachmentDescriptor* stencil = mtlRPDesc.stencilAttachment;
+	if (stencil.texture != depth.texture) {
+		mvkMadeiraDumpAddTarget(targets, stencil.texture, stencil.level, stencil.slice, stencil.depthPlane, "stencil");
+	}
+}
+
+/**
+ * Encodes a blit of each target into its own shared buffer on mtlCmdBuff, right after the
+ * encoder that produced it, and writes the buffers out once mtlCmdBuff completes. Releases
+ * and clears the targets. passFields is the JSON shared by every entry of the pass. A pass
+ * without targets is still listed (marker entry), so the index shows every dispatch.
+ */
+static void mvkMadeiraDumpEncode(const std::shared_ptr<MVKMadeiraFrameDump>& frame, id<MTLCommandBuffer> mtlCmdBuff,
+								 const char* kind, const std::string& passFields,
+								 std::vector<MVKMadeiraDumpTarget>& targets,
+								 int64_t passNo = -1, const std::string& firstFields = std::string()) {
+	struct Pending {
+		id<MTLBuffer> buffer;
+		std::string path;
+		std::string json;
+		uint32_t seq;
+		uint64_t size;
+	};
+	auto* pending = new std::vector<Pending>();
+	id<MTLBlitCommandEncoder> mtlBlit = nil;
+	uint32_t pass;
+	{
+		std::lock_guard<std::mutex> guard(frame->lock);
+		pass = passNo >= 0 ? (uint32_t)passNo : frame->nextPass++;
+		if (targets.empty()) {
+			uint32_t seq = frame->nextSeq++;
+			char head[96];
+			snprintf(head, sizeof(head), "{\"seq\":%u,\"pass\":%u,\"kind\":\"%s\",", seq, pass, kind);
+			frame->add(seq, head + passFields + firstFields + ",\"slot\":null,\"skipped\":\"no-outputs\"}");
+			frame->skipped++;
+		}
+	}
+	bool first = true;
+	for (auto& t : targets) {
+		id<MTLTexture> tex = t.texture;
+		const char* tkind = t.kind ? t.kind : kind;
+		MVKMadeiraDumpFormat fmt = { nullptr, 0, MTLBlitOptionNone };
+		bool known = mvkMadeiraDumpFormat(tex.pixelFormat, fmt);
+		uint32_t width = std::max<uint32_t>(1, (uint32_t)tex.width >> t.level);
+		uint32_t height = std::max<uint32_t>(1, (uint32_t)tex.height >> t.level);
+		uint64_t bytesPerRow = uint64_t(width) * fmt.bytesPerPixel;
+		uint64_t size = bytesPerRow * height;
+		MTLTextureType texType = tex.textureType;
+		const char* skip = nullptr;
+		if ( !known ) { skip = "format"; }
+		else if (tex.sampleCount > 1) { skip = "multisampled"; }
+		else if (tex.storageMode == MTLStorageModeMemoryless) { skip = "memoryless"; }
+		else if (tex.framebufferOnly) { skip = "framebuffer-only"; }
+		else if (texType == MTLTextureTypeTextureBuffer) { skip = "texture-buffer"; }
+		else if (t.level >= tex.mipmapLevelCount) { skip = "level"; }
+		else if (width > frame->maxDim || height > frame->maxDim) { skip = "max-dim"; }
+
+		uint32_t seq;
+		{
+			std::lock_guard<std::mutex> guard(frame->lock);
+			seq = t.seq >= 0 ? (uint32_t)t.seq : frame->nextSeq++;
+			if ( !skip && frame->reserved + size > frame->budget) { skip = "budget"; }
+			if ( !skip && frame->inflight + size > frame->inflightCap) { skip = "inflight"; }
+			if ( !skip ) { frame->reserved += size; frame->inflight += size; }
+		}
+		id<MTLBuffer> mtlBuff = nil;
+		if ( !skip ) {
+			mtlBuff = [mtlCmdBuff.device newBufferWithLength: size options: MTLResourceStorageModeShared];	// retained
+			if ( !mtlBuff ) {
+				skip = "alloc";
+				std::lock_guard<std::mutex> guard(frame->lock);
+				frame->reserved -= size;
+				frame->inflight -= size;
+			}
+		}
+
+		char file[160];
+		snprintf(file, sizeof(file), "%04u_%s_%s.raw", seq, tkind, t.slot.c_str());
+		std::string json;
+		char buf[256];
+		snprintf(buf, sizeof(buf), "{\"seq\":%u,\"pass\":%u,\"kind\":\"%s\",", seq, pass, tkind);
+		json += buf;
+		json += passFields;
+		if (first) { json += firstFields; first = false; }
+		json += ",\"slot\":";
+		mvkMadeiraJSON(json, t.slot.c_str());
+		json += ",\"texture\":{\"label\":";
+		mvkMadeiraJSON(json, tex.label);
+		json += ",\"ptr\":";
+		mvkMadeiraJSONPtr(json, tex);
+		snprintf(buf, sizeof(buf), ",\"type\":%lu,\"usage\":%lu,\"samples\":%lu,\"mips\":%lu,\"size\":[%lu,%lu,%lu,%lu]",
+				 (unsigned long)texType, (unsigned long)tex.usage, (unsigned long)tex.sampleCount, (unsigned long)tex.mipmapLevelCount,
+				 (unsigned long)tex.width, (unsigned long)tex.height, (unsigned long)tex.depth, (unsigned long)tex.arrayLength);
+		json += buf;
+		if (id<MTLTexture> parent = tex.parentTexture) {	// attachments and inputs are often views
+			json += ",\"parentTexture\":";
+			mvkMadeiraJSONPtr(json, parent);
+		}
+		json += "}";
+		json += t.extra;
+		snprintf(buf, sizeof(buf), ",\"width\":%u,\"height\":%u,\"level\":%u,\"slice\":%u,\"depthPlane\":%u,\"format\":%lu,\"formatName\":",
+				 width, height, t.level, t.slice, t.depthPlane, (unsigned long)tex.pixelFormat);
+		json += buf;
+		mvkMadeiraJSON(json, fmt.name);
+		snprintf(buf, sizeof(buf), ",\"bytesPerPixel\":%u,\"bytesPerRow\":%llu", fmt.bytesPerPixel, (unsigned long long)bytesPerRow);
+		json += buf;
+
+		if (skip) {
+			json += ",\"file\":null,\"skipped\":\"";
+			json += skip;
+			json += "\"}";
+			if ( !known && !t.kind ) {	// inputs are often compressed: not worth a line each
+				fprintf(stderr, "[mvk-dump] skip #%u %s %s: pixel format %lu unsupported\n",
+						seq, tkind, t.slot.c_str(), (unsigned long)tex.pixelFormat);
+			}
+			std::lock_guard<std::mutex> guard(frame->lock);
+			frame->skipped++;
+			frame->add(seq, std::move(json));
+		} else {
+			json += ",\"file\":";
+			mvkMadeiraJSON(json, file);
+			if ( !mtlBlit ) {
+				mtlBlit = [mtlCmdBuff blitCommandEncoder];
+				mtlBlit.label = @"mvk-dump";
+			}
+			bool is3D = texType == MTLTextureType3D;
+			bool layered = is3D || texType == MTLTextureType2DArray || texType == MTLTextureTypeCube || texType == MTLTextureTypeCubeArray;
+			[mtlBlit copyFromTexture: tex
+						 sourceSlice: is3D ? 0 : t.slice
+						 sourceLevel: t.level
+						sourceOrigin: MTLOriginMake(0, 0, is3D ? t.depthPlane : 0)
+						  sourceSize: MTLSizeMake(width, height, 1)
+							toBuffer: mtlBuff
+				   destinationOffset: 0
+			  destinationBytesPerRow: bytesPerRow
+			destinationBytesPerImage: layered ? size : 0
+							 options: fmt.options];
+			pending->push_back({ mtlBuff, frame->dir + "/" + file, std::move(json), seq, size });
+		}
+		[tex release];
+	}
+	targets.clear();
+	if (mtlBlit) { [mtlBlit endEncoding]; }
+	if (pending->empty()) { delete pending; return; }
+
+	// Completed handlers run on Metal's threads; the file writes go to a serial queue.
+	std::shared_ptr<MVKMadeiraFrameDump> keep = frame;
+	[mtlCmdBuff addCompletedHandler: ^(id<MTLCommandBuffer> mtlCB) {
+		bool gpuError = mtlCB.status == MTLCommandBufferStatusError;
+		dispatch_async(mvkMadeiraDumpQueue(), ^{
+			for (auto& p : *pending) {
+				bool ok = false;
+				if (FILE* out = fopen(p.path.c_str(), "wb")) {
+					ok = fwrite(p.buffer.contents, 1, p.size, out) == p.size;
+					ok = (fclose(out) == 0) && ok;
+				}
+				[p.buffer release];
+				p.json += ok ? (gpuError ? ",\"status\":\"gpu-error\"}" : ",\"status\":\"ok\"}") : ",\"status\":\"write-failed\"}";
+				std::lock_guard<std::mutex> guard(keep->lock);
+				keep->inflight -= p.size;
+				if (ok) { keep->written += p.size; } else { keep->skipped++; }
+				keep->add(p.seq, std::move(p.json));
+			}
+			delete pending;
+		});
+	}];
+}
+
+static void mvkMadeiraDumpJoin(std::string& json, const char* key, const std::vector<std::string>& items) {
+	json += ",\"";
+	json += key;
+	json += "\":[";
+	for (size_t i = 0; i < items.size(); i++) {
+		if (i) { json += ","; }
+		json += items[i];
+	}
+	json += "]";
+}
+
+static const char* mvkMadeiraDumpDescriptorType(VkDescriptorType type) {
+	switch (type) {
+		case VK_DESCRIPTOR_TYPE_SAMPLER:                return "sampler";
+		case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER: return "combined-image-sampler";
+		case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:          return "sampled-image";
+		case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:          return "storage-image";
+		case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:       return "input-attachment";
+		case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:   return "uniform-texel-buffer";
+		case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:   return "storage-texel-buffer";
+		case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:         return "uniform-buffer";
+		case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:         return "storage-buffer";
+		case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC: return "uniform-buffer-dynamic";
+		case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC: return "storage-buffer-dynamic";
+		case VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK:   return "inline-uniform-block";
+		default:                                        return "other";
+	}
+}
