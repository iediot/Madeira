+/** One stage of a pipeline: its name in the dump and what MoltenVK kept of its conversion. */
+struct MVKMadeiraDumpStage {
+	const char* name;
+	const MVKPipelineStageResourceInfo* res;
+};
+
+/**
+ * Writes the MSL and binding map of each stage of a pipeline to shaders/ once per dump, and
+ * returns the fields naming them. The MSL comes from the live MVKShaderLibrary; one whose
+ * shader module the game already destroyed is listed as unavailable.
+ */
+static std::string mvkMadeiraDumpShaders(const std::shared_ptr<MVKMadeiraFrameDump>& frame, MVKPipeline* pipeline,
+										 const MVKMadeiraDumpStage* stages, size_t stageCount) {
+	{
+		std::lock_guard<std::mutex> guard(frame->lock);
+		auto it = frame->pipelineShaders.find(pipeline);
+		if (it != frame->pipelineShaders.end()) { return it->second; }
+	}
+	char ptr[32];
+	snprintf(ptr, sizeof(ptr), "%p", pipeline);
+	MVKPipelineLayout* layout = pipeline->getLayout();
+	auto* files = new std::vector<std::pair<std::string, std::string>>();
+	std::string fields = ",\"shaders\":{";
+	std::string map = "{\"ptr\":\"";
+	map += ptr;
+	map += "\",\"name\":";
+	mvkMadeiraJSON(map, pipeline->getDebugName());
+	map += ",\"stages\":{";
+	bool firstStage = true;
+	for (size_t s = 0; s < stageCount; s++) {
+		const MVKPipelineStageResourceInfo* res = stages[s].res;
+		if ( !res || (!res->madeiraMSL && res->madeiraBindings.empty()) ) { continue; }
+		std::string file = std::string("shaders/") + ptr + "_" + stages[s].name + ".metal";
+		std::string msl;
+		bool haveMSL = mvkMadeiraShaderMSL(res->madeiraMSL, msl);
+
+		// The binding map, as JSON and as a comment heading the MSL. An argument-buffer set
+		// gives [[id(n)]] inside its spvDescriptorSetBuffer<set>, a direct one [[texture(n)]] etc.
+		std::string header = std::string("// Madeira frame dump: pipeline ") + ptr + ", " + stages[s].name + " stage\n"
+			"// set.binding -> Metal index ([[id]] for argument-buffer sets)\n";
+		std::string bindings = "[";
+		for (size_t b = 0; b < res->madeiraBindings.size(); b++) {
+			const MVKMadeiraBindingMap& m = res->madeiraBindings[b];
+			const MVKDescriptorSetLayout* setLayout = (layout && m.set < layout->getDescriptorSetCount()) ? layout->getDescriptorSetLayout(m.set) : nullptr;
+			const MVKDescriptorBinding* binding = nullptr;
+			if (setLayout) {
+				uint32_t idx = setLayout->getBindingIndex(m.binding);
+				if (idx < setLayout->bindings().size()) { binding = &setLayout->bindings()[idx]; }
+			}
+			bool argBuf = setLayout && setLayout->argBufMode() != MVKArgumentBufferMode::Off;
+			const char* type = binding ? mvkMadeiraDumpDescriptorType(binding->descriptorType) : "unknown";
+			char buf[320];
+			snprintf(buf, sizeof(buf), "%s{\"set\":%u,\"binding\":%u,\"count\":%u,\"type\":\"%s\",\"argBuffer\":%s,\"buffer\":%u,\"texture\":%u,\"sampler\":%u,\"constexprSampler\":%s}",
+					 b ? "," : "", m.set, m.binding, m.count, type, argBuf ? "true" : "false", m.buffer, m.texture, m.sampler,
+					 m.constexprSampler ? "true" : "false");
+			bindings += buf;
+			snprintf(buf, sizeof(buf), "//   set %u binding %u (%s x%u)%s -> buffer %u, texture %u, sampler %u%s\n",
+					 m.set, m.binding, type, m.count, argBuf ? " argument buffer" : "", m.buffer, m.texture, m.sampler,
+					 m.constexprSampler ? " (constexpr sampler)" : "");
+			header += buf;
+		}
+		bindings += "]";
+
+		fields += firstStage ? "\"" : ",\"";
+		fields += stages[s].name;
+		fields += "\":";
+		if (haveMSL) { mvkMadeiraJSON(fields, file.c_str()); } else { fields += "null"; }
+		map += firstStage ? "\"" : ",\"";
+		map += stages[s].name;
+		map += "\":{\"file\":";
+		if (haveMSL) { mvkMadeiraJSON(map, file.c_str()); } else { map += "null"; }
+		map += haveMSL ? ",\"msl\":\"ok\"" : ",\"msl\":\"unavailable\"";
+		map += ",\"bindings\":";
+		map += bindings;
+		map += "}";
+		firstStage = false;
+		if (haveMSL) { files->emplace_back(frame->dir + "/" + file, header + "\n" + msl); }
+	}
+	map += "}}\n";
+	fields += "},\"bindingMap\":\"shaders/";
+	fields += ptr;
+	fields += ".json\"";
+	files->emplace_back(frame->dir + "/shaders/" + ptr + ".json", std::move(map));
+	dispatch_async(mvkMadeiraDumpQueue(), ^{
+		for (auto& f : *files) {
+			if (FILE* out = fopen(f.first.c_str(), "w")) {
+				fwrite(f.second.data(), 1, f.second.size(), out);
+				fclose(out);
+			}
+		}
+		delete files;
+	});
+	std::lock_guard<std::mutex> guard(frame->lock);
+	frame->pipelineShaders.emplace(pipeline, fields);
+	return fields;
+}
+
+static std::string mvkMadeiraDumpPipelineJSON(const std::shared_ptr<MVKMadeiraFrameDump>& frame, MVKPipeline* pipeline,
+											  const MVKMadeiraDumpStage* stages, size_t stageCount, id mtlPipeline, NSString* mtlLabel) {
+	std::string json = "{\"ptr\":";
+	mvkMadeiraJSONPtr(json, pipeline);
+	json += ",\"mtl\":";
+	mvkMadeiraJSONPtr(json, mtlPipeline);
+	json += ",\"label\":";
+	mvkMadeiraJSON(json, mtlLabel);
+	json += ",\"name\":";
+	mvkMadeiraJSON(json, pipeline->getDebugName());
+	json += mvkMadeiraDumpShaders(frame, pipeline, stages, stageCount);
+	json += "}";
+	return json;
+}
+
+static std::string mvkMadeiraDumpGraphicsPipelineJSON(const std::shared_ptr<MVKMadeiraFrameDump>& frame, MVKGraphicsPipeline* pipeline) {
+	id<MTLRenderPipelineState> mtlPS = pipeline->getMainPipelineState();
+	MVKMadeiraDumpStage stages[] = {
+		{ "vertex",   &pipeline->getStageResources(kMVKShaderStageVertex) },
+		{ "tessctl",  &pipeline->getStageResources(kMVKShaderStageTessCtl) },
+		{ "tesseval", &pipeline->getStageResources(kMVKShaderStageTessEval) },
+		{ "fragment", &pipeline->getStageResources(kMVKShaderStageFragment) },
+	};
+	return mvkMadeiraDumpPipelineJSON(frame, pipeline, stages, 4, mtlPS, mtlPS.label);
+}
+
+/**
+ * Lists the textures and samplers one stage of a draw or dispatch can read, as bound at
+ * encode time: for direct bindings from the Metal encoder state, for argument-buffer sets
+ * from the descriptor set's CPU copy (its first id per descriptor is the MTLTexture). Only
+ * the bindings the shader uses, by the pipeline's conversion map; arrays show 16 elements.
+ */
+static void mvkMadeiraDumpCollectInputs(std::vector<MVKMadeiraDumpInput>& inputs, std::vector<std::string>& samplers,
+										const char* stageName, const MVKPipelineStageResourceInfo& res,
+										const MVKVulkanCommonEncoderState& vk, const MVKStageResourceBits& exists,
+										const MVKStageResourceBindings& bindings, MVKLiveResourceSet& live, MVKPixelFormats* pixFmts) {
+	if ( !vk._layout ) { return; }
+	for (const MVKMadeiraBindingMap& m : res.madeiraBindings) {
+		if (m.set >= vk._layout->getDescriptorSetCount() || m.set >= kMVKMaxDescriptorSetCount) { continue; }
+		const MVKDescriptorSetLayout* setLayout = vk._layout->getDescriptorSetLayout(m.set);
+		if ( !setLayout ) { continue; }
+		uint32_t bIdx = setLayout->getBindingIndex(m.binding);
+		if (bIdx >= setLayout->bindings().size()) { continue; }
+		const MVKDescriptorBinding& binding = setLayout->bindings()[bIdx];
+		uint32_t texCount = binding.perDescriptorResourceCount.texture;
+		bool hasSampler = binding.perDescriptorResourceCount.sampler || binding.hasImmutableSamplers() || m.constexprSampler;
+		if ( !texCount && !hasSampler ) { continue; }
+
+		MVKDescriptorSet* set = vk._descriptorSets[m.set];
+		bool argBuf = setLayout->argBufMode() != MVKArgumentBufferMode::Off;
+		uint32_t count = (binding.isVariable() && set) ? set->variableDescriptorCount : binding.descriptorCount;
+		size_t stride = descriptorCPUSize(binding.cpuLayout);
+		const char* cpu = (set && set->cpuBuffer && stride >= sizeof(id)) ? set->cpuBuffer + binding.cpuOffset : nullptr;
+		// An argument-buffer descriptor the shader never reads can still name a destroyed texture
+		// (Detroit crashed the dump that way), so without live tracking those are listed by pointer
+		// only. MVK_MADEIRA_FRAME_DUMP_INPUTS=1 turns the tracking on.
+		bool trusted = live.enabled;
+		bool storage = binding.descriptorType == VK_DESCRIPTOR_TYPE_STORAGE_IMAGE ||
+					   binding.descriptorType == VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER;
+		const char* type = mvkMadeiraDumpDescriptorType(binding.descriptorType);
+
+		for (uint32_t i = 0; i < count && i < 16; i++) {
+			char head[320];
+			if (texCount) {
+				uint32_t index = m.texture + i;
+				snprintf(head, sizeof(head), "{\"stage\":\"%s\",\"index\":%u,\"set\":%u,\"binding\":%u,\"element\":%u,\"count\":%u,\"type\":\"%s\",\"argBuffer\":%s,\"texture\":",
+						 stageName, index, m.set, m.binding, i, count, type, argBuf ? "true" : "false");
+				MVKMadeiraDumpInput in = { nil, false, std::string(stageName) + std::to_string(index), head };
+				id<MTLTexture> tex = nil;
+				if ( !argBuf ) {
+					if (index < kMVKMaxTextureCount && exists.textures.get(index)) { tex = bindings.textures[index]; }
+				} else if (cpu) {
+					tex = *reinterpret_cast<const id*>(cpu + i * stride);
+				}
+				if ( !tex ) {
+					in.json += "null";
+				} else if (argBuf && live.enabled) {
+					auto isLive = live.isLive(tex);	// holds the live list's lock while the texture is read
+					if (isLive) {
+						mvkMadeiraDumpTextureJSON(in.json, tex, pixFmts);
+						in.texture = [tex retain];
+						in.dumpable = !storage;
+					} else {
+						in.json += "{\"ptr\":";
+						mvkMadeiraJSONPtr(in.json, tex);
+						in.json += ",\"dead\":true}";
+					}
+				} else if (argBuf && !trusted) {
+					in.json += "{\"ptr\":";
+					mvkMadeiraJSONPtr(in.json, tex);
+					in.json += ",\"unverified\":true}";
+				} else {
+					mvkMadeiraDumpTextureJSON(in.json, tex, pixFmts);
+					in.texture = [tex retain];
+					in.dumpable = !storage;
+				}
+				inputs.push_back(std::move(in));
+			}
+			if (hasSampler) {
+				uint32_t index = m.sampler + i;
+				snprintf(head, sizeof(head), "{\"stage\":\"%s\",\"index\":%u,\"set\":%u,\"binding\":%u,\"element\":%u,\"argBuffer\":%s",
+						 stageName, index, m.set, m.binding, i, argBuf ? "true" : "false");
+				std::string json = head;
+				if (m.constexprSampler) {
+					json += ",\"constexpr\":true}";
+				} else {
+					id<MTLSamplerState> samp = nil;
+					if (binding.hasImmutableSamplers()) {
+						auto imm = setLayout->immutableSamplers();
+						if (binding.immSamplerIndex + i < imm.size()) { samp = imm[binding.immSamplerIndex + i]->getMTLSamplerState(); }
+						json += ",\"immutable\":true";
+					} else if ( !argBuf ) {
+						if (index < kMVKMaxSamplerCount && exists.samplers.get(index)) { samp = bindings.samplers[index]; }
+					} else if (cpu) {
+						samp = *reinterpret_cast<const id*>(cpu + i * stride + texCount * sizeof(id));
+					}
+					json += ",\"ptr\":";
+					mvkMadeiraJSONPtr(json, samp);
+					json += "}";
+				}
+				samplers.push_back(std::move(json));
+			}
+		}
+	}
+}
+
+/** Adds the sampled inputs not yet listed as retained input targets of a pass. */
+static void mvkMadeiraDumpAddInputTargets(std::vector<MVKMadeiraDumpTarget>& targets, const std::vector<MVKMadeiraDumpInput>& inputs,
+										  const std::string& extra) {
+	for (const MVKMadeiraDumpInput& in : inputs) {
+		if ( !in.dumpable || !in.texture ) { continue; }
+		bool listed = false;
+		for (auto& t : targets) { if (t.texture == in.texture) { listed = true; break; } }
+		if (listed) { continue; }
+		targets.push_back({ [in.texture retain], 0, 0, 0, in.slot, -1, "input", extra });
+	}
+}
+
+/**
+ * Takes the pass number and the seqs of the input targets ahead of encoding, so the entry
+ * of their consumer can name them, and marks the inputs the pass itself also writes.
+ */
+static uint32_t mvkMadeiraDumpReserve(MVKMadeiraFrameDump& frame, std::vector<MVKMadeiraDumpTarget>& inputs,
+									  const std::vector<MVKMadeiraDumpTarget>& outputs) {
+	for (auto& in : inputs) {
+		id<MTLTexture> root = mvkMadeiraDumpRoot(in.texture);
+		bool written = false;
+		for (auto& out : outputs) { if (mvkMadeiraDumpRoot(out.texture) == root) { written = true; break; } }
+		in.extra += written ? ",\"alsoWritten\":true" : ",\"alsoWritten\":false";
+	}
+	std::lock_guard<std::mutex> guard(frame.lock);
+	for (auto& in : inputs) { in.seq = frame.nextSeq++; }
+	return frame.nextPass++;
+}
+
+/** The inputs array of a draw or dispatch, each with the seq of its input entry if it was dumped. */
+static void mvkMadeiraDumpInputsJSON(std::string& json, const std::vector<MVKMadeiraDumpInput>& inputs,
+									 const std::vector<MVKMadeiraDumpTarget>& dumped) {
+	json += "[";
+	for (size_t i = 0; i < inputs.size(); i++) {
+		if (i) { json += ","; }
+		json += inputs[i].json;
+		if (inputs[i].texture) {
+			for (auto& t : dumped) {
+				if (t.texture == inputs[i].texture && t.seq >= 0) {
+					char buf[48];
+					snprintf(buf, sizeof(buf), ",\"inputSeq\":%lld", (long long)t.seq);
+					json += buf;
+					break;
+				}
+			}
+		}
+		json += "}";
+	}
+	json += "]";
+}
+
+void MVKCommandEncoder::madeiraDumpBeginPass(MTLRenderPassDescriptor* mtlRPDesc, MVKCommandUse cmdUse) {
+	delete _madeiraDumpPass;
+	auto* pass = new MVKMadeiraDumpPass();
+	NSString* label = getMTLRenderCommandEncoderName(cmdUse);
+	pass->label = label ? label.UTF8String : "";
+	pass->use = mvkMTLRenderCommandEncoderLabel(cmdUse).UTF8String;
+	pass->width = (uint32_t)mtlRPDesc.renderTargetWidth;
+	pass->height = (uint32_t)mtlRPDesc.renderTargetHeight;
+	mvkMadeiraDumpCollectAttachments(mtlRPDesc, pass->targets);
+	_madeiraDumpPass = pass;
+}
+
+void MVKCommandEncoder::madeiraDumpNoteDraw() {
+	MVKMadeiraDumpPass* pass = _madeiraDumpPass;
+	uint32_t drawIdx = pass->draws++;
+	MVKGraphicsPipeline* pipeline = getGraphicsPipeline();
+	if (pipeline && pass->pipelinePtrs.size() < 32 &&
+		std::find(pass->pipelinePtrs.begin(), pass->pipelinePtrs.end(), pipeline) == pass->pipelinePtrs.end()) {
+		pass->pipelinePtrs.push_back(pipeline);
+		pass->pipelines.push_back(mvkMadeiraDumpGraphicsPipelineJSON(_madeiraDump, pipeline));
+	}
+	MVKMetalGraphicsCommandEncoderState& mtlGfx = getMtlGraphics();
+	for (uint32_t i = 0; i < mtlGfx._numViewports && i < kMVKMaxViewportScissorCount && pass->viewports.size() < 16; i++) {
+		const VkViewport& vp = mtlGfx._viewports[i];
+		char buf[192];
+		snprintf(buf, sizeof(buf), "[%g,%g,%g,%g,%g,%g]", vp.x, vp.y, vp.width, vp.height, vp.minDepth, vp.maxDepth);
+		if (std::find(pass->viewports.begin(), pass->viewports.end(), buf) == pass->viewports.end()) {
+			pass->viewports.push_back(buf);
+		}
+	}
+	if ( !pipeline || drawIdx >= kMVKMadeiraDumpMaxDraws ) { return; }
+
+	// The render encoder's vertex stage runs the tessellation evaluation shader of a tessellated pipeline.
+	MVKMadeiraDumpDraw draw = { drawIdx, pipeline, {}, {} };
+	MVKShaderStage vtxStage = pipeline->isTessellationPipeline() ? kMVKShaderStageTessEval : kMVKShaderStageVertex;
+	MVKLiveResourceSet& live = getDevice()->getLiveResources();
+	mvkMadeiraDumpCollectInputs(draw.inputs, draw.samplers, "vertex", pipeline->getStageResources(vtxStage), getVkGraphics(),
+								mtlGfx._exists.vertex(), mtlGfx._bindings.vertex(), live, getPixelFormats());
+	mvkMadeiraDumpCollectInputs(draw.inputs, draw.samplers, "fragment", pipeline->getStageResources(kMVKShaderStageFragment), getVkGraphics(),
+								mtlGfx._exists.fragment(), mtlGfx._bindings.fragment(), live, getPixelFormats());
+	if (drawIdx < _madeiraDump->inputDraws) {
+		char extra[96];
+		snprintf(extra, sizeof(extra), ",\"consumerDraw\":%u,\"when\":\"after-pass\"", drawIdx);
+		mvkMadeiraDumpAddInputTargets(pass->inputs, draw.inputs, extra);
+	}
+	pass->drawList.push_back(std::move(draw));
+}
+
+void MVKCommandEncoder::madeiraDumpEndPass() {
+	MVKMadeiraDumpPass* pass = _madeiraDumpPass;
+	_madeiraDumpPass = nullptr;
+	if (_madeiraDump && _mtlCmdBuffer) {
+		std::string fields = "\"encoder\":";
+		mvkMadeiraJSON(fields, pass->label.c_str());
+		fields += ",\"use\":";
+		mvkMadeiraJSON(fields, pass->use.c_str());
+		char buf[96];
+		snprintf(buf, sizeof(buf), ",\"renderTarget\":[%u,%u],\"draws\":%u", pass->width, pass->height, pass->draws);
+		fields += buf;
+		mvkMadeiraDumpJoin(fields, "pipelines", pass->pipelines);
+		mvkMadeiraDumpJoin(fields, "viewports", pass->viewports);
+
+		// Inputs only for small passes: a pass of many draws samples many textures.
+		std::vector<MVKMadeiraDumpTarget> targets;
+		if (pass->draws <= _madeiraDump->inputDraws) { targets.swap(pass->inputs); }
+		uint32_t passNo = mvkMadeiraDumpReserve(*_madeiraDump, targets, pass->targets);
+
+		// The per-draw bindings go on the pass's first entry only; every entry repeats the fields above.
+		std::string first = ",\"drawList\":[";
+		for (size_t d = 0; d < pass->drawList.size(); d++) {
+			const MVKMadeiraDumpDraw& draw = pass->drawList[d];
+			snprintf(buf, sizeof(buf), "%s{\"draw\":%u,\"pipeline\":", d ? "," : "", draw.index);
+			first += buf;
+			mvkMadeiraJSONPtr(first, draw.pipeline);
+			first += ",\"inputs\":";
+			mvkMadeiraDumpInputsJSON(first, draw.inputs, targets);
+			mvkMadeiraDumpJoin(first, "samplers", draw.samplers);
+			first += "}";
+		}
+		snprintf(buf, sizeof(buf), "],\"drawsDropped\":%u", pass->draws > kMVKMadeiraDumpMaxDraws ? pass->draws - kMVKMadeiraDumpMaxDraws : 0);
+		first += buf;
+
+		targets.insert(targets.end(), pass->targets.begin(), pass->targets.end());
+		pass->targets.clear();	// owned by targets now
+		mvkMadeiraDumpEncode(_madeiraDump, _mtlCmdBuffer, "render", fields, targets, passNo, first);
+	}
+	delete pass;
+}
+
+void MVKCommandEncoder::madeiraDumpRenderPassDescriptor(MTLRenderPassDescriptor* mtlRPDesc, NSString* label) {
+	if ( !_madeiraDump || !_mtlCmdBuffer ) { return; }
+	std::vector<MVKMadeiraDumpTarget> targets;
+	mvkMadeiraDumpCollectAttachments(mtlRPDesc, targets);
+	std::string fields = "\"encoder\":";
+	mvkMadeiraJSON(fields, label);
+	fields += ",\"use\":";
+	mvkMadeiraJSON(fields, label);
+	char buf[64];
+	snprintf(buf, sizeof(buf), ",\"renderTarget\":[%lu,%lu]",
+			 (unsigned long)mtlRPDesc.renderTargetWidth, (unsigned long)mtlRPDesc.renderTargetHeight);
+	fields += buf;
+	mvkMadeiraDumpEncode(_madeiraDump, _mtlCmdBuffer, "render", fields, targets);
+}
+
+void MVKCommandEncoder::madeiraDumpTransferTexture(id<MTLTexture> mtlTex, uint32_t level, uint32_t slice, NSString* label) {
+	if ( !_madeiraDump || !_mtlCmdBuffer || !mtlTex ) { return; }
+	endCurrentMetalEncoding();
+	std::vector<MVKMadeiraDumpTarget> targets;
+	mvkMadeiraDumpAddTarget(targets, mtlTex, level, mtlTex.textureType == MTLTextureType3D ? 0 : slice,
+							mtlTex.textureType == MTLTextureType3D ? slice : 0, "dst");
+	std::string fields = "\"encoder\":";
+	mvkMadeiraJSON(fields, label);
+	fields += ",\"use\":";
+	mvkMadeiraJSON(fields, label);
+	mvkMadeiraDumpEncode(_madeiraDump, _mtlCmdBuffer, "blit", fields, targets);
+}
+
+// A transfer command's source, destination and regions, as a metadata entry ("status":"meta",
+// no file), so copies show even when their destination is not dumpable. Images and buffers of
+// a recorded transfer are valid by the Vulkan rules, so describing them is safe.
+void MVKCommandEncoder::madeiraDumpTransfer(MVKCommandUse cmdUse, const char* vkCmd,
+											id<MTLTexture> srcTex, id<MTLBuffer> srcBuff, NSUInteger srcBuffOffset,
+											id<MTLTexture> dstTex, id<MTLBuffer> dstBuff, NSUInteger dstBuffOffset,
+											const std::string& regions, size_t regionCount) {
+	if ( !_madeiraDump ) { return; }
+	uint32_t seq, pass;
+	{
+		std::lock_guard<std::mutex> guard(_madeiraDump->lock);
+		seq = _madeiraDump->nextSeq++;
+		pass = _madeiraDump->nextPass++;
+	}
+	auto describe = [this](std::string& json, id<MTLTexture> tex, id<MTLBuffer> buff, NSUInteger offset) {
+		if (tex) {
+			json += "{\"texture\":";
+			mvkMadeiraDumpTextureJSON(json, tex, getPixelFormats());
+			json += "}";
+		} else if (buff) {
+			json += "{\"buffer\":";
+			mvkMadeiraJSONPtr(json, buff);
+			char buf[96];
+			snprintf(buf, sizeof(buf), ",\"offset\":%lu,\"length\":%lu,\"label\":", (unsigned long)offset, (unsigned long)buff.length);
+			json += buf;
+			mvkMadeiraJSON(json, buff.label);
+			json += "}";
+		} else {
+			json += "null";
+		}
+	};
+	char buf[160];
+	snprintf(buf, sizeof(buf), "{\"seq\":%u,\"pass\":%u,\"kind\":\"transfer\",\"encoder\":", seq, pass);
+	std::string json = buf;
+	mvkMadeiraJSON(json, mvkMTLBlitCommandEncoderLabel(cmdUse));
+	json += ",\"use\":";
+	mvkMadeiraJSON(json, vkCmd);
+	json += ",\"slot\":null,\"src\":";
+	describe(json, srcTex, srcBuff, srcBuffOffset);
+	json += ",\"dst\":";
+	describe(json, dstTex, dstBuff, dstBuffOffset);
+	snprintf(buf, sizeof(buf), ",\"regionCount\":%zu,\"regions\":", regionCount);
+	json += buf;
+	json += regions;
+	json += ",\"status\":\"meta\"}";
+	std::lock_guard<std::mutex> guard(_madeiraDump->lock);
+	_madeiraDump->add(seq, std::move(json));
+}
+
+// The storage images of every descriptor set the bound compute pipeline reads, as the
+// binding code walks them: the first id of a storage-image descriptor is its MTLTexture.
+// Also everything the dispatch can read (inputs), and the sampled textures' contents.
+void MVKCommandEncoder::madeiraDumpDispatch(MTLSize threadgroups, MTLSize threadsPerThreadgroup, bool indirect) {
+	if ( !_madeiraDump || !_mtlCmdBuffer ) { return; }
+	MVKComputePipeline* pipeline = getComputePipeline();
+	const MVKVulkanComputeCommandEncoderState& vkCompute = getVkCompute();
+	std::vector<MVKMadeiraDumpTarget> targets;
+	if (pipeline && vkCompute._layout) {
+		const MVKPipelineStageResourceInfo& resources = pipeline->getStageResources();
+		bool used[kMVKMaxDescriptorSetCount] = {};
+		for (size_t idx : resources.resources.descriptorSetData) { if (idx < kMVKMaxDescriptorSetCount) { used[idx] = true; } }
+		for (const MVKDescriptorBindOperation& op : resources.bindScript.ops) { used[op.set] = true; }
+		for (const MVKMadeiraBindingMap& m : resources.madeiraBindings) { if (m.set < kMVKMaxDescriptorSetCount) { used[m.set] = true; } }
+		MVKLiveResourceSet& live = getDevice()->getLiveResources();
+		size_t setCount = std::min<size_t>(vkCompute._layout->getDescriptorSetCount(), kMVKMaxDescriptorSetCount);
+		for (size_t setIdx = 0; setIdx < setCount; setIdx++) {
+			if ( !used[setIdx] ) { continue; }
+			MVKDescriptorSet* set = vkCompute._descriptorSets[setIdx];
+			const MVKDescriptorSetLayout* setLayout = vkCompute._layout->getDescriptorSetLayout(setIdx);
+			if ( !set || !set->cpuBuffer || !setLayout ) { continue; }
+			for (const MVKDescriptorBinding& binding : setLayout->bindings()) {
+				if (binding.descriptorType != VK_DESCRIPTOR_TYPE_STORAGE_IMAGE) { continue; }
+				if ( !mvkIsAnyFlagEnabled(binding.stageFlags, VK_SHADER_STAGE_COMPUTE_BIT) ) { continue; }
+				size_t stride = descriptorCPUSize(binding.cpuLayout);
+				if (stride < sizeof(id)) { continue; }
+				uint32_t count = std::min<uint32_t>(binding.isVariable() ? set->variableDescriptorCount : binding.descriptorCount, 8);
+				for (uint32_t i = 0; i < count; i++) {
+					id<MTLTexture> tex = *reinterpret_cast<const id*>(set->cpuBuffer + binding.cpuOffset + i * stride);
+					if ( !tex ) { continue; }
+					char slot[48];
+					snprintf(slot, sizeof(slot), "set%zu-binding%u-%u", setIdx, binding.binding, i);
+					if (live.enabled) {
+						auto isLive = live.isLive(tex);	// holds the live list's lock while retaining
+						if (isLive) { mvkMadeiraDumpAddTarget(targets, tex, 0, 0, 0, slot); }
+					} else {
+						mvkMadeiraDumpAddTarget(targets, tex, 0, 0, 0, slot);
+					}
+				}
+			}
+		}
+	}
+
+	std::string fields = "\"encoder\":";
+	mvkMadeiraJSON(fields, mvkMTLComputeCommandEncoderLabel(kMVKCommandUseDispatch));
+	fields += ",\"use\":";
+	mvkMadeiraJSON(fields, indirect ? "vkCmdDispatchIndirect" : "vkCmdDispatch");
+	std::vector<std::string> pipelines;
+	if (pipeline) {
+		id<MTLComputePipelineState> mtlPS = getMtlCompute()._pipeline;
+		MVKMadeiraDumpStage stage = { "compute", &pipeline->getStageResources() };
+		pipelines.push_back(mvkMadeiraDumpPipelineJSON(_madeiraDump, pipeline, &stage, 1, mtlPS, mtlPS.label));
+	}
+	mvkMadeiraDumpJoin(fields, "pipelines", pipelines);
+	char buf[160];
+	if (indirect) {
+		snprintf(buf, sizeof(buf), ",\"threadgroups\":\"indirect\"");
+	} else {
+		snprintf(buf, sizeof(buf), ",\"threadgroups\":[%lu,%lu,%lu]",
+				 (unsigned long)threadgroups.width, (unsigned long)threadgroups.height, (unsigned long)threadgroups.depth);
+	}
+	fields += buf;
+	snprintf(buf, sizeof(buf), ",\"threadsPerThreadgroup\":[%lu,%lu,%lu]",
+			 (unsigned long)threadsPerThreadgroup.width, (unsigned long)threadsPerThreadgroup.height, (unsigned long)threadsPerThreadgroup.depth);
+	fields += buf;
+
+	// What the dispatch can read; the sampled textures are dumped after it, with its outputs.
+	std::vector<MVKMadeiraDumpInput> inputs;
+	std::vector<std::string> samplers;
+	std::vector<MVKMadeiraDumpTarget> all;
+	if (pipeline) {
+		MVKMetalComputeCommandEncoderState& mtlCompute = getMtlCompute();
+		mvkMadeiraDumpCollectInputs(inputs, samplers, "compute", pipeline->getStageResources(), vkCompute,
+									mtlCompute._exists, mtlCompute._bindings, getDevice()->getLiveResources(), getPixelFormats());
+		mvkMadeiraDumpAddInputTargets(all, inputs, ",\"consumer\":\"dispatch\",\"when\":\"after-dispatch\"");
+	}
+	uint32_t passNo = mvkMadeiraDumpReserve(*_madeiraDump, all, targets);
+	std::string first = ",\"inputs\":";
+	mvkMadeiraDumpInputsJSON(first, inputs, all);
+	mvkMadeiraDumpJoin(first, "samplers", samplers);
+	mvkMadeiraDumpRelease(inputs);
+	all.insert(all.end(), targets.begin(), targets.end());
+
+	// End the compute encoder only when there is something to copy; MoltenVK rebinds on the next one.
+	if ( !all.empty() ) { endCurrentMetalEncoding(); }
+	mvkMadeiraDumpEncode(_madeiraDump, _mtlCmdBuffer, "compute", fields, all, passNo, first);
