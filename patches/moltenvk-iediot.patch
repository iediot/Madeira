+	for (auto& m : macros) { h = h * 1099511628211ull ^ std::hash<std::string>()(m.first.name) ^ (size_t)m.second.value.ui64 ^ ((size_t)m.second.size << 56); }
+	std::lock_guard<std::mutex> lock(g_mvkt_lock);
+	if (!g_mvkt_sources) { g_mvkt_sources = new std::unordered_set<size_t>(); }
