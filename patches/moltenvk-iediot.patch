+#pragma mark -
+#pragma mark Madeira frame dump
+
+// Madeira: dumps the output of every pass of one frame to files, so a visual bug can be
+// bisected offline instead of clicking through GPU-trace replays. Copying an empty
+// Documents/mvk-dump-now to the device (tools/mvk-dump-fire.sh) arms one whole frame,
+// from the present that sees the trigger to the present after it. After each Metal render
+// encoder its color, resolve and depth attachments, and after each compute dispatch the
+// storage images it can write, are blitted into shared buffers on the same MTLCommandBuffer
+// (so ordering is exact) and written as raw bytes to Documents/mvk-dump-<n>/ from the
+// buffer's completed handler, one index.json entry per dump (tools/mvk-dump-pull.sh fetches
+// and converts them). Until triggered this costs one stat() every 30 presents and a relaxed
+// atomic load per MTLCommandBuffer; MVK_MADEIRA_FRAME_DUMP=0 turns even the stat() off.
+// MVK_MADEIRA_FRAME_DUMP_MB (default 1536) caps the bytes dumped, _MAX_DIM (default 4096)
+// the texture size, _INFLIGHT_MB (default 768) the bytes waiting in shared buffers for their
+// command buffer to complete; anything past a cap is listed in the index as skipped.
+
+struct MVKMadeiraDumpFormat {
+	const char* name;
+	uint32_t bytesPerPixel;
+	MTLBlitOption options;
+};
+
+static bool mvkMadeiraDumpFormat(MTLPixelFormat mtlFmt, MVKMadeiraDumpFormat& fmt) {
