+// Madeira frame dump: transfer regions as JSON (index entries of kind "transfer"), at most
+// kMVKMadeiraDumpMaxRegions of them; regionCount gives the total.
+static constexpr size_t kMVKMadeiraDumpMaxRegions = 32;
+static void mvkMadeiraRegionSub(std::string& j, const char* key, const VkImageSubresourceLayers& sub) {
+	char buf[160];
+	snprintf(buf, sizeof(buf), "\"%s\":{\"aspect\":%u,\"mip\":%u,\"layer\":%u,\"layers\":%u}",
+			 key, sub.aspectMask, sub.mipLevel, sub.baseArrayLayer, sub.layerCount);
+	j += buf;
+}
+static void mvkMadeiraRegionOffset(std::string& j, const char* key, const VkOffset3D& o) {
+	char buf[96];
+	snprintf(buf, sizeof(buf), "\"%s\":[%d,%d,%d]", key, o.x, o.y, o.z);
+	j += buf;
+}
+static void mvkMadeiraRegionExtent(std::string& j, const char* key, const VkExtent3D& e) {
+	char buf[96];
+	snprintf(buf, sizeof(buf), "\"%s\":[%u,%u,%u]", key, e.width, e.height, e.depth);
+	j += buf;
+}
+template <typename R>
+static std::string mvkMadeiraImageRegions(const R* regions, size_t count) {
+	std::string j = "[";
+	for (size_t i = 0; i < count && i < kMVKMadeiraDumpMaxRegions; i++) {
+		const R& r = regions[i];
+		if (i) { j += ","; }
+		j += "{";
+		mvkMadeiraRegionSub(j, "srcSubresource", r.srcSubresource);    j += ",";
+		mvkMadeiraRegionOffset(j, "srcOffset", r.srcOffset);           j += ",";
+		mvkMadeiraRegionSub(j, "dstSubresource", r.dstSubresource);    j += ",";
+		mvkMadeiraRegionOffset(j, "dstOffset", r.dstOffset);           j += ",";
+		mvkMadeiraRegionExtent(j, "extent", r.extent);
+		j += "}";
+	}
+	return j + "]";
+}
