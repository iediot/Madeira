+	if ([options respondsToSelector:@selector(optimizationLevel)]) {
+		result[@"optimizationLevel"] = @(options.optimizationLevel);
+	}
+	return result;
+}
+void mvkPrecompCollect(NSString* directory, uint64_t key, NSString* source, NSDictionary* options) {
+	if (!mvkPrecompCollectCap()) { return; }
+	uint64_t bytes = [source lengthOfBytesUsingEncoding:NSUTF8StringEncoding];
+	const uint64_t pendingCap = 32 * 1024 * 1024;
+	if (bytes > pendingCap) { return; }
+	uint64_t previous = g_mvkPrecompPending.fetch_add(bytes);
+	if (previous > pendingCap - bytes) { g_mvkPrecompPending.fetch_sub(bytes); return; }
+	static dispatch_queue_t queue = dispatch_queue_create("MoltenVK.msl-collect", DISPATCH_QUEUE_SERIAL);
+	// dispatch_async copies the block and retains its Objective-C captures under MRC.
+	dispatch_async(queue, ^{
+		@autoreleasepool {
+			static NSMutableDictionary* totals = [NSMutableDictionary new];
+			NSFileManager* fm = NSFileManager.defaultManager;
+			NSString* srcDir = [directory stringByAppendingPathComponent:@"src"];
+			NSString* stem = [srcDir stringByAppendingPathComponent:mvkPrecompKeyString(key)];
+			NSString* metalPath = [stem stringByAppendingString:@".metal"];
+			NSString* jsonPath = [stem stringByAppendingString:@".json"];
+			if (![fm fileExistsAtPath:metalPath] || ![fm fileExistsAtPath:jsonPath]) {
+				if (!totals[srcDir]) {
+					uint64_t used = 0;
+					for (NSString* file in [fm contentsOfDirectoryAtPath:srcDir error:nil]) {
+						if ([file hasSuffix:@".metal"]) { used += [[fm attributesOfItemAtPath:[srcDir stringByAppendingPathComponent:file] error:nil] fileSize]; }
+					}
+					totals[srcDir] = @(used);
+				}
+				uint64_t used = [totals[srcDir] unsignedLongLongValue];
+				uint64_t oldBytes = [[fm attributesOfItemAtPath:metalPath error:nil] fileSize];
+				uint64_t added = bytes > oldBytes ? bytes - oldBytes : 0;
+				if (used <= mvkPrecompCollectCap() && added <= mvkPrecompCollectCap() - used &&
+					[fm createDirectoryAtPath:srcDir withIntermediateDirectories:YES attributes:nil error:nil]) {
+					[fm createDirectoryAtPath:[directory stringByAppendingPathComponent:@"lib"] withIntermediateDirectories:YES attributes:nil error:nil];
+					NSData* json = [NSJSONSerialization dataWithJSONObject:options options:NSJSONWritingSortedKeys error:nil];
+					// NSDataWritingAtomic writes a temporary file then renames it. Publish source last.
+					if (json && [json writeToFile:jsonPath options:NSDataWritingAtomic error:nil] &&
+						[[source dataUsingEncoding:NSUTF8StringEncoding] writeToFile:metalPath options:NSDataWritingAtomic error:nil]) {
+						totals[srcDir] = @(used + added);
+						++g_mvkPrecompCollected;
+					}
+				}
+			}
+		}
+		g_mvkPrecompPending.fetch_sub(bytes);
+	});
+}
