+#define MVK_DUMP_FMT(f, bpp) case MTLPixelFormat##f: fmt = { #f, bpp, MTLBlitOptionNone }; return true;
+		MVK_DUMP_FMT(A8Unorm, 1) MVK_DUMP_FMT(R8Unorm, 1) MVK_DUMP_FMT(R8Unorm_sRGB, 1) MVK_DUMP_FMT(R8Snorm, 1)
+		MVK_DUMP_FMT(R8Uint, 1) MVK_DUMP_FMT(R8Sint, 1) MVK_DUMP_FMT(Stencil8, 1)
+		MVK_DUMP_FMT(R16Unorm, 2) MVK_DUMP_FMT(R16Snorm, 2) MVK_DUMP_FMT(R16Uint, 2) MVK_DUMP_FMT(R16Sint, 2) MVK_DUMP_FMT(R16Float, 2)
+		MVK_DUMP_FMT(RG8Unorm, 2) MVK_DUMP_FMT(RG8Unorm_sRGB, 2) MVK_DUMP_FMT(RG8Snorm, 2) MVK_DUMP_FMT(RG8Uint, 2) MVK_DUMP_FMT(RG8Sint, 2)
+		MVK_DUMP_FMT(Depth16Unorm, 2)
+		MVK_DUMP_FMT(R32Uint, 4) MVK_DUMP_FMT(R32Sint, 4) MVK_DUMP_FMT(R32Float, 4)
+		MVK_DUMP_FMT(RG16Unorm, 4) MVK_DUMP_FMT(RG16Snorm, 4) MVK_DUMP_FMT(RG16Uint, 4) MVK_DUMP_FMT(RG16Sint, 4) MVK_DUMP_FMT(RG16Float, 4)
+		MVK_DUMP_FMT(RGBA8Unorm, 4) MVK_DUMP_FMT(RGBA8Unorm_sRGB, 4) MVK_DUMP_FMT(RGBA8Snorm, 4) MVK_DUMP_FMT(RGBA8Uint, 4) MVK_DUMP_FMT(RGBA8Sint, 4)
+		MVK_DUMP_FMT(BGRA8Unorm, 4) MVK_DUMP_FMT(BGRA8Unorm_sRGB, 4)
+		MVK_DUMP_FMT(RGB10A2Unorm, 4) MVK_DUMP_FMT(RGB10A2Uint, 4) MVK_DUMP_FMT(BGR10A2Unorm, 4)
+		MVK_DUMP_FMT(RG11B10Float, 4) MVK_DUMP_FMT(RGB9E5Float, 4)
+		MVK_DUMP_FMT(Depth32Float, 4)
+		MVK_DUMP_FMT(RG32Uint, 8) MVK_DUMP_FMT(RG32Sint, 8) MVK_DUMP_FMT(RG32Float, 8)
+		MVK_DUMP_FMT(RGBA16Unorm, 8) MVK_DUMP_FMT(RGBA16Snorm, 8) MVK_DUMP_FMT(RGBA16Uint, 8) MVK_DUMP_FMT(RGBA16Sint, 8) MVK_DUMP_FMT(RGBA16Float, 8)
