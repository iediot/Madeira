+std::string mvkPSOKey(id<MTLDevice> device, MTLComputePipelineDescriptor* desc) {
+	std::string key("C", 1);
+	mvkPSOKeyAddObject(key, device);
+	mvkPSOKeyAddString(key, desc.label);
+	mvkPSOKeyAddFunction(key, desc.computeFunction);
+	mvkPSOKeyAdd(key, desc.threadGroupSizeIsMultipleOfThreadExecutionWidth);
+	mvkPSOKeyAdd(key, desc.maxTotalThreadsPerThreadgroup);
+	mvkPSOKeyAddStageInput(key, desc.stageInputDescriptor);
+	for (NSUInteger idx = 0; idx < 31; ++idx) { mvkPSOKeyAdd(key, desc.buffers[idx].mutability); }
+	mvkPSOKeyAdd(key, desc.supportIndirectCommandBuffers);
+	mvkPSOKeyAddLibraries(key, desc.preloadedLibraries);
+	mvkPSOKeyAddLinkedFunctions(key, desc.linkedFunctions);
+	mvkPSOKeyAdd(key, desc.supportAddingBinaryFunctions);
+	mvkPSOKeyAdd(key, desc.maxCallStackDepth);
+#if MVK_XCODE_16
+	if (@available(iOS 18.0, macOS 15.0, *)) { mvkPSOKeyAdd(key, desc.shaderValidation); }
+#endif
+	return key;
+}
