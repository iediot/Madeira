+// Madeira: Detroit issues ~115 vkQueueSubmits a frame with no command buffers and no
+// semaphores, and each still created, labelled, enqueued and committed an empty
+// MTLCommandBuffer. Such a submit has nothing to do but signal its fence once every
+// earlier submission on this queue has finished. Submissions with work are numbered
+// as they execute (serially, in submission order) and drop out when destroyed, which
+// is after finish() has signalled their own fence and semaphores. An empty submit's
+// fence is signalled at once if nothing is in flight, else parked until every
+// submission numbered before it is gone. Later submissions never delay it.
+// MVK_MADEIRA_SKIP_EMPTY_SUBMIT=0 restores the empty MTLCommandBuffer.
+uint64_t MVKQueue::madeiraBeginSubmission() {
+	std::lock_guard<std::mutex> lock(_madeiraInFlightLock);
+	uint64_t seq = _madeiraNextSeq++;
+	_madeiraInFlight.push_back(seq);
+	return seq;
+}
+
+void MVKQueue::madeiraEndSubmission(uint64_t seq) {
+	MVKSmallVector<MVKFence*, 4> ready;
+	{
+		std::lock_guard<std::mutex> lock(_madeiraInFlightLock);
+		auto it = std::find(_madeiraInFlight.begin(), _madeiraInFlight.end(), seq);
+		if (it != _madeiraInFlight.end()) { _madeiraInFlight.erase(it); }
+		uint64_t oldest = _madeiraInFlight.empty() ? UINT64_MAX : _madeiraInFlight.front();
+		while ( !_madeiraParkedFences.empty() && _madeiraParkedFences.front().first <= oldest ) {
+			ready.push_back(_madeiraParkedFences.front().second);
+			_madeiraParkedFences.pop_front();
+		}
+	}
+	for (auto* fence : ready) {
+		fence->signal();
+		fence->release();
+	}
+}
+
+void MVKQueue::madeiraSignalAfterInFlight(MVKFence* fence) {
+	{
+		std::lock_guard<std::mutex> lock(_madeiraInFlightLock);
+		if ( !_madeiraInFlight.empty() ) {
+			fence->retain();	// Released once signalled
+			_madeiraParkedFences.emplace_back(_madeiraNextSeq, fence);
+			return;
+		}
+	}
+	fence->signal();
+}
