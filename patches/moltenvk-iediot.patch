+
+static void mvkMadeiraJSON(std::string& out, const char* str) {
+	if ( !str ) { out += "null"; return; }
+	out += '"';
+	for (; *str; str++) {
+		unsigned char c = *str;
+		if (c == '"' || c == '\\') { out += '\\'; out += (char)c; }
+		else if (c < 0x20) { char esc[8]; snprintf(esc, sizeof(esc), "\\u%04x", c); out += esc; }
+		else { out += (char)c; }
+	}
+	out += '"';
+}
+static void mvkMadeiraJSON(std::string& out, NSString* str) { mvkMadeiraJSON(out, str ? str.UTF8String : nullptr); }
+static void mvkMadeiraJSONPtr(std::string& out, const void* ptr) {
+	char buf[32]; snprintf(buf, sizeof(buf), "\"%p\"", ptr); out += buf;
+}
+
+static uint64_t mvkMadeiraDumpEnv(const char* name, uint64_t dflt) {
+	const char* val = getenv(name);
+	return (val && *val) ? strtoull(val, nullptr, 10) : dflt;
+}
+
+/** One armed frame. Shared by the encoders that recorded into it and the writes still pending. */
+struct MVKMadeiraFrameDump {
+	std::string dir;
+	uint64_t budget = 0;
+	uint64_t inflightCap = 0;
+	uint32_t maxDim = 0;
+
+	// Encoding threads and the write queue both get here.
+	std::mutex lock;
+	uint32_t nextSeq = 0;
+	uint32_t nextPass = 0;
+	uint64_t reserved = 0;
+	uint64_t inflight = 0;
+	uint64_t written = 0;
+	uint32_t skipped = 0;
+	FILE* jsonl = nullptr;
+	std::vector<std::pair<uint32_t, std::string>> entries;
+
+	/** Records a finished entry. The lock must be held. */
+	void add(uint32_t seq, std::string&& json) {
+		if (jsonl) { fputs(json.c_str(), jsonl); fputc('\n', jsonl); fflush(jsonl); }
+		entries.emplace_back(seq, std::move(json));
+	}
+
+	// The last reference goes after the last write: index.json then holds every entry in submission order.
+	~MVKMadeiraFrameDump() {
+		if (dir.empty()) { return; }
+		std::sort(entries.begin(), entries.end(), [](const auto& a, const auto& b) { return a.first < b.first; });
+		if (FILE* idx = fopen((dir + "/index.json").c_str(), "w")) {
+			fputs("[\n", idx);
+			for (size_t i = 0; i < entries.size(); i++) {
+				fputs(entries[i].second.c_str(), idx);
+				fputs(i + 1 < entries.size() ? ",\n" : "\n", idx);
+			}
+			fputs("]\n", idx);
+			fclose(idx);
+		}
+		if (jsonl) { fclose(jsonl); }
+		fprintf(stderr, "[mvk-dump] stop dir=%s entries=%zu bytes=%llu skipped=%u\n",
+				dir.c_str(), entries.size(), (unsigned long long)written, skipped);
+	}
+};
+
+/** A texture to dump, retained until the dump is encoded. */
+struct MVKMadeiraDumpTarget {
+	id<MTLTexture> texture;
+	uint32_t level;
+	uint32_t slice;
+	uint32_t depthPlane;
+	std::string slot;
+};
+
+/** The Metal render pass being recorded: its attachments and what drew into it. */
+struct MVKMadeiraDumpPass {
+	std::vector<MVKMadeiraDumpTarget> targets;
+	std::string label;
+	std::string use;
+	uint32_t width = 0;
+	uint32_t height = 0;
+	uint32_t draws = 0;
+	std::vector<const void*> pipelinePtrs;
+	std::vector<std::string> pipelines;
+	std::vector<std::string> viewports;
+	~MVKMadeiraDumpPass() { for (auto& t : targets) { [t.texture release]; } }
+};
