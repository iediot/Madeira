+// Madeira: process-wide cache of compiled MSL libraries, least recently used out.
+// A library belongs to its shader module and goes with it, and games that create and
+// destroy pipelines in bulk compile the same source again and again: Detroit: Become
+// Human compiled 203,776 sources (82 ms each) of which 180,121 were exact repeats in
+// the same run. The key is the complete source plus every other compile input
+// (macros, fast-math flags, position invariance), so a hit is the library a fresh
+// compile would return. MVK_MADEIRA_LIBRARY_CACHE sets the entry count (default 256,
+// 0 = off). A library is far from small: 3,300 of them took Detroit past the iPad's 12 GB limit in 3 minutes, so the cap stays low; precompiled libraries cover the rest.
+#include <list>
+#include "MVKMadeiraMemoryPressure.h"
+#include <unordered_map>
+namespace {
+struct MVKLibCacheEntry { id<MTLLibrary> lib; std::list<uint64_t>::iterator lru; size_t length; };
+std::mutex g_mvkLibCacheLock;
+std::unordered_map<uint64_t, MVKLibCacheEntry>* g_mvkLibCache;
+std::list<uint64_t>* g_mvkLibLRU;
+std::atomic<uint64_t> g_mvkLibHits, g_mvkLibMisses;
+size_t mvkLibCacheCap() {
+	static size_t cap = [] {
+		const char* v = getenv("MVK_MADEIRA_LIBRARY_CACHE");
+		return (v && *v) ? (size_t)strtoull(v, nullptr, 10) : (size_t)256;
+	}();
+	return mvkMadeiraPressureCapacity(cap, 32);
+}
+uint64_t mvkLibCacheKey(NSString* src, const vector<pair<MSLSpecializationMacroInfo, MVKShaderMacroValue>>& macros,
+						uint32_t fastMath, bool invariant, size_t* length) {
+	const char* c = src.UTF8String;
+	size_t n = c ? strlen(c) : 0;
+	*length = n;
+	uint64_t h = 1469598103934665603ull;
+	for (size_t i = 0; i < n; i++) { h ^= (unsigned char)c[i]; h *= 1099511628211ull; }
+	for (auto& m : macros) {
+		h = h * 1099511628211ull ^ std::hash<std::string>()(m.first.name);
+		h = h * 1099511628211ull ^ (uint64_t)m.second.value.ui64 ^ ((uint64_t)m.second.size << 56);
+	}
+	h = h * 1099511628211ull ^ fastMath;
+	h = h * 1099511628211ull ^ (invariant ? 0x9e3779b97f4a7c15ull : 0);
+	return h;
+}
+id<MTLLibrary> mvkLibCacheGet(uint64_t key, size_t length) {
+	std::lock_guard<std::mutex> g(g_mvkLibCacheLock);
+	if (!g_mvkLibCache) { return nil; }
+	auto it = g_mvkLibCache->find(key);
+	if (it == g_mvkLibCache->end() || it->second.length != length) { return nil; }
+	g_mvkLibLRU->splice(g_mvkLibLRU->begin(), *g_mvkLibLRU, it->second.lru);
+	return [it->second.lib retain];
+}
+void mvkLibCachePut(uint64_t key, size_t length, id<MTLLibrary> lib) {
+	size_t cap = mvkLibCacheCap();
+	if (!lib || !cap) { return; }
+	std::lock_guard<std::mutex> g(g_mvkLibCacheLock);
+	if (!g_mvkLibCache) { g_mvkLibCache = new std::unordered_map<uint64_t, MVKLibCacheEntry>(); g_mvkLibLRU = new std::list<uint64_t>(); }
+	if (g_mvkLibCache->count(key)) { return; }
+	g_mvkLibLRU->push_front(key);
+	(*g_mvkLibCache)[key] = { [lib retain], g_mvkLibLRU->begin(), length };
+	while (g_mvkLibCache->size() > cap) {
+		uint64_t old = g_mvkLibLRU->back();
+		g_mvkLibLRU->pop_back();
+		auto it = g_mvkLibCache->find(old);
+		if (it != g_mvkLibCache->end()) { [it->second.lib release]; g_mvkLibCache->erase(it); }
+	}
+}
+void mvkLibCacheNote(bool hit) {
+	uint64_t n = (hit ? ++g_mvkLibHits : ++g_mvkLibMisses);
+	uint64_t h = g_mvkLibHits.load(), m = g_mvkLibMisses.load();
+	if ((h + m) % 4096 == 0)
+		fprintf(stderr, "[mvk-libcache] hits=%llu misses=%llu (%.0f%%) cap=%zu\n", (unsigned long long)h, (unsigned long long)m,
+				(h + m) ? 100.0 * h / (h + m) : 0.0, mvkLibCacheCap());
+	(void)n;
+}
+// Disk I/O is serialized, including quota accounting and duplicate suppression.
+// Bound queued source memory too: a slow/full disk must not grow the process heap.
+std::atomic<uint64_t> g_mvkPrecompLoaded{0}, g_mvkPrecompCompiled{0}, g_mvkPrecompCollected{0};
+std::atomic<uint64_t> g_mvkPrecompEvents{0}, g_mvkPrecompPending{0};
+void mvkPrecompNote(bool loaded) {
+	if (loaded) { ++g_mvkPrecompLoaded; } else { ++g_mvkPrecompCompiled; }
+	if ((++g_mvkPrecompEvents % 2048) == 0) {
+		fprintf(stderr, "[mvk-precomp] loaded=%llu compiled=%llu collected=%llu\n",
+			(unsigned long long)g_mvkPrecompLoaded.load(), (unsigned long long)g_mvkPrecompCompiled.load(),
+			(unsigned long long)g_mvkPrecompCollected.load());
+	}
+}
+NSString* mvkPrecompKeyString(uint64_t key) {
+	return [NSString stringWithFormat:@"%016llx", (unsigned long long)key];
+}
+NSString* mvkPrecompDirectory(id<MTLDevice> device) {
+	return [mvkMadeiraGameCacheDirectory(device) stringByAppendingPathComponent:@"msl"];
+}
+uint64_t mvkPrecompCollectCap() {
+	static uint64_t cap = [] {
+		const char* v = getenv("MVK_MADEIRA_MSL_COLLECT_MB");
+		uint64_t mb = v ? strtoull(v, nullptr, 10) : 2048;
+		return std::min(mb, UINT64_MAX / (1024 * 1024)) * (1024 * 1024);
+	}();
+	return cap;
+}
+id<MTLLibrary> mvkPrecompLoad(id<MTLDevice> device, uint64_t key, const std::string& entry,
+							NSString* directory = nil) {
+	const char* enabled = getenv("MVK_MADEIRA_PRECOMPILED");
+	if (enabled && !strcmp(enabled, "0")) { return nil; }
+	NSString* path = [[(directory ?: mvkPrecompDirectory(device)) stringByAppendingPathComponent:@"lib"]
+		stringByAppendingPathComponent:[mvkPrecompKeyString(key) stringByAppendingString:@".metallib"]];
+	if (![NSFileManager.defaultManager fileExistsAtPath:path]) { return nil; }
+	// Say why the first few files are refused: a silent nil hid that 11,557 libraries
+	// built for iOS 27 could not load on iPadOS 26 (only loaded=0 showed).
+	NSError* err = nil;
+	id<MTLLibrary> lib = [device newLibraryWithURL:[NSURL fileURLWithPath:path] error:&err];
+	static std::atomic<int> refusals{0};
+	if (!lib && refusals.fetch_add(1) < 4)
+		fprintf(stderr, "[mvk-precomp] refused %s: %s\n", path.UTF8String, err ? err.localizedDescription.UTF8String : "no error");
+	if (lib && ![lib.functionNames containsObject:@(entry.c_str())]) {
+		if (refusals.fetch_add(1) < 4) fprintf(stderr, "[mvk-precomp] refused %s: no function %s\n", path.UTF8String, entry.c_str());
+		[lib release];
+		return nil;
+	}
+	if (lib) { mvkPrecompNote(true); }
+	return lib;
+}
+#include "MVKMadeiraShaderPrewarm.h"
+NSDictionary* mvkPrecompOptions(MTLCompileOptions* options, uint64_t key) {
+	NSMutableDictionary* macros = [NSMutableDictionary dictionary];
+	for (NSString* name in options.preprocessorMacros) {
+		// Preserve NSNumber's textual expansion, without a JSON float round trip.
+		macros[name] = [options.preprocessorMacros[name] description];
+	}
+	NSMutableDictionary* result = [NSMutableDictionary dictionaryWithDictionary:@{
+		@"schemaVersion": @1, @"key": mvkPrecompKeyString(key),
+		@"languageVersion": @(options.languageVersion), @"fastMathEnabled": @(options.fastMathEnabled),
+		@"preserveInvariance": @(options.preserveInvariance), @"preprocessorMacros": macros }];
+#if MVK_XCODE_16
+	if ([options respondsToSelector:@selector(mathMode)]) {
+		result[@"mathMode"] = @(options.mathMode);
+		result[@"mathFloatingPointFunctions"] = @(options.mathFloatingPointFunctions);
+	}
+#endif
+	if ([options respondsToSelector:@selector(optimizationLevel)]) {
+		result[@"optimizationLevel"] = @(options.optimizationLevel);
+	}
+	return result;
+}
+void mvkPrecompCollect(NSString* directory, uint64_t key, NSString* source, NSDictionary* options) {
+	if (!mvkPrecompCollectCap()) { return; }
+	uint64_t bytes = [source lengthOfBytesUsingEncoding:NSUTF8StringEncoding];
+	const uint64_t pendingCap = 32 * 1024 * 1024;
+	if (bytes > pendingCap) { return; }
+	uint64_t previous = g_mvkPrecompPending.fetch_add(bytes);
+	if (previous > pendingCap - bytes) { g_mvkPrecompPending.fetch_sub(bytes); return; }
+	static dispatch_queue_t queue = dispatch_queue_create("MoltenVK.msl-collect", DISPATCH_QUEUE_SERIAL);
+	// dispatch_async copies the block and retains its Objective-C captures under MRC.
+	dispatch_async(queue, ^{
+		@autoreleasepool {
+			static NSMutableDictionary* totals = [NSMutableDictionary new];
+			NSFileManager* fm = NSFileManager.defaultManager;
+			NSString* srcDir = [directory stringByAppendingPathComponent:@"src"];
+			NSString* stem = [srcDir stringByAppendingPathComponent:mvkPrecompKeyString(key)];
+			NSString* metalPath = [stem stringByAppendingString:@".metal"];
+			NSString* jsonPath = [stem stringByAppendingString:@".json"];
+			if (![fm fileExistsAtPath:metalPath] || ![fm fileExistsAtPath:jsonPath]) {
+				if (!totals[srcDir]) {
+					uint64_t used = 0;
+					for (NSString* file in [fm contentsOfDirectoryAtPath:srcDir error:nil]) {
+						if ([file hasSuffix:@".metal"]) { used += [[fm attributesOfItemAtPath:[srcDir stringByAppendingPathComponent:file] error:nil] fileSize]; }
+					}
+					totals[srcDir] = @(used);
+				}
+				uint64_t used = [totals[srcDir] unsignedLongLongValue];
+				uint64_t oldBytes = [[fm attributesOfItemAtPath:metalPath error:nil] fileSize];
+				uint64_t added = bytes > oldBytes ? bytes - oldBytes : 0;
+				if (used <= mvkPrecompCollectCap() && added <= mvkPrecompCollectCap() - used &&
+					[fm createDirectoryAtPath:srcDir withIntermediateDirectories:YES attributes:nil error:nil]) {
+					[fm createDirectoryAtPath:[directory stringByAppendingPathComponent:@"lib"] withIntermediateDirectories:YES attributes:nil error:nil];
+					NSData* json = [NSJSONSerialization dataWithJSONObject:options options:NSJSONWritingSortedKeys error:nil];
+					// NSDataWritingAtomic writes a temporary file then renames it. Publish source last.
+					if (json && [json writeToFile:jsonPath options:NSDataWritingAtomic error:nil] &&
+						[[source dataUsingEncoding:NSUTF8StringEncoding] writeToFile:metalPath options:NSDataWritingAtomic error:nil]) {
+						totals[srcDir] = @(used + added);
+						++g_mvkPrecompCollected;
+					}
+				}
+			}
+		}
+		g_mvkPrecompPending.fetch_sub(bytes);
+	});
+}
+
+}
+
+void mvkMadeiraTrimLibraryCache() {
+	std::lock_guard<std::mutex> lock(g_mvkLibCacheLock);
+	if (!g_mvkLibCache) return;
+	while (g_mvkLibCache->size() > mvkLibCacheCap()) {
+		uint64_t key = g_mvkLibLRU->back();
+		g_mvkLibLRU->pop_back();
+		auto old = g_mvkLibCache->find(key);
+		[old->second.lib release];
+		g_mvkLibCache->erase(old);
+	}
+}
+
+MVKMadeiraLibraryStats mvkMadeiraLibraryStats() {
+	MVKMadeiraLibraryStats stats;
+	{
+		std::lock_guard<std::mutex> lock(g_mvkLibCacheLock);
+		if (g_mvkLibCache) {
+			stats.entries = g_mvkLibCache->size();
+			for (auto& entry : *g_mvkLibCache) { stats.sourceBytes += entry.second.length; }
+		}
+	}
+	stats.hits = g_mvkLibHits.load(std::memory_order_relaxed);
+	stats.misses = g_mvkLibMisses.load(std::memory_order_relaxed);
+	stats.liveLibraries = g_mvkLiveShaderLibraries.load(std::memory_order_relaxed);
+	stats.precompilePendingBytes = g_mvkPrecompPending.load(std::memory_order_relaxed);
+	return stats;
+}
+
+void mvkMadeiraShaderPrewarmLog() {
+	fprintf(stderr, "[mvk-shader-prefetch] enabled=%d requests=%llu loaded=%llu learned=%llu pending=%llu dropped=%llu write_failures=%llu modules_cap=512 variants_cap=2 jobs_cap=32\n",
+		mvkShaderPrewarmEnabled(), (unsigned long long)g_mvkWarmRequests.load(),
+		(unsigned long long)g_mvkWarmLoaded.load(), (unsigned long long)g_mvkWarmLearned.load(),
+		(unsigned long long)g_mvkWarmPending.load(), (unsigned long long)g_mvkWarmDropped.load(),
+		(unsigned long long)g_mvkWarmWritesFailed.load());
+	fprintf(stderr, "[mvk-shader-prefetch-outcome] no_hint=%llu already_cached=%llu disk_missing_or_refused=%llu pressure_skipped=%llu request_admission_dropped=%llu learning_admission_dropped=%llu\n",
+		(unsigned long long)g_mvkWarmNoHint.load(), (unsigned long long)g_mvkWarmCached.load(),
+		(unsigned long long)g_mvkWarmDiskMiss.load(), (unsigned long long)g_mvkWarmPressureSkipped.load(),
+		(unsigned long long)g_mvkWarmRequestDropped.load(), (unsigned long long)g_mvkWarmLearnDropped.load());
+}
