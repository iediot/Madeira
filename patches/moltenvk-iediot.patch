+						NSDictionary* attrs = [NSFileManager.defaultManager attributesOfItemAtPath:[_directory stringByAppendingPathComponent:file] error:nil];
+						if (attrs) { [entries addObject:@[attrs.fileModificationDate ?: NSDate.distantPast, @(attrs.fileSize), file]]; }
