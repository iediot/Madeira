+uint32_t MVKDevice::reserveAsyncPipelineFrameBudgetMS() {
+	std::lock_guard<std::mutex> lock(_madeiraAsyncFrameBudgetLock);
+	uint32_t milliseconds = (uint32_t)((_madeiraAsyncFrameBudgetRemainingNS + 999999ull) / 1000000ull);
+	_madeiraAsyncFrameBudgetRemainingNS = 0;
+	return milliseconds;
+}
+
+void MVKDevice::refundAsyncPipelineFrameBudgetNS(uint64_t nanoseconds) {
+	std::lock_guard<std::mutex> lock(_madeiraAsyncFrameBudgetLock);
+	_madeiraAsyncFrameBudgetRemainingNS = std::min<uint64_t>(_madeiraAsyncFrameBudgetRemainingNS + nanoseconds,
+														(uint64_t)_madeiraAsyncPipelineFrameBudgetMS * 1000000ull);
+}
+
+void MVKDevice::resetAsyncPipelineFrameBudget() {
+	std::lock_guard<std::mutex> lock(_madeiraAsyncFrameBudgetLock);
+	_madeiraAsyncFrameBudgetRemainingNS = (uint64_t)_madeiraAsyncPipelineFrameBudgetMS * 1000000ull;
+}
