+void MVKDevice::logMemoryBreakdown() {
+	task_vm_info_data_t vmInfo = {};
+	mach_msg_type_number_t vmCount = TASK_VM_INFO_COUNT;
+	uint64_t footprint = 0;
+	if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&vmInfo, &vmCount) == KERN_SUCCESS) {
+		footprint = vmInfo.phys_footprint;
+	}
+	auto pso = mvkPipelineStateCache().occupancy();
+	auto load = [&](MVKMemoryAllocationType type) {
+		auto& counter = _memoryCounters[(size_t)type];
+		return std::pair<uint64_t, uint64_t>{ counter.count.load(std::memory_order_relaxed),
+											 counter.bytes.load(std::memory_order_relaxed) };
+	};
+	auto vkMem = load(MVKMemoryAllocationType::VulkanDeviceMemory);
+	auto heaps = load(MVKMemoryAllocationType::MetalHeap);
+	auto deviceBuffers = load(MVKMemoryAllocationType::MetalDeviceMemoryBuffer);
+	auto buffers = load(MVKMemoryAllocationType::MetalBuffer);
+	auto heapBuffers = load(MVKMemoryAllocationType::MetalHeapBuffer);
+	auto textures = load(MVKMemoryAllocationType::MetalTexture);
+	auto heapTextures = load(MVKMemoryAllocationType::MetalHeapTexture);
+	auto spirv = load(MVKMemoryAllocationType::ShaderSPIRV);
+	auto msl = load(MVKMemoryAllocationType::ShaderMSL);
+	uint64_t pendingResidency = 0;
+	auto conversions = mvkMadeiraConversionCacheStats();
+	auto libraries = mvkMadeiraLibraryStats();
+	auto async = mvkMadeiraAsyncMemoryStats();
+	MVKMadeiraVMUsage tags[256] = {}, jitRX = {}, jitRW = {};
+	mvkMadeiraVMUsageSnapshot(tags, jitRX, jitRW);
+	MVKMadeiraMallocZoneUsage zones[32] = {};
+	uint64_t mallocUsed = 0, mallocAllocated = 0;
+	unsigned zoneCount = mvkMadeiraMallocZoneSnapshot(zones, mallocUsed, mallocAllocated);
+#if MVK_XCODE_16
+	@synchronized(_residencySet) { pendingResidency = _residencyPendingRemovalBytes; }
+#endif
+	char line[8192];
+	size_t length = 0;
+	auto append = [&](const char* format, auto... args) {
+		if (length >= sizeof(line)) return;
+		int written = snprintf(line + length, sizeof(line) - length, format, args...);
+		if (written > 0) length += std::min<size_t>((size_t)written, sizeof(line) - length - 1);
+	};
+	append("[mem-breakdown] phys=%llu internal=%llu compressed=%llu external=%llu reusable=%llu metal=%llu ",
+		(unsigned long long)footprint, (unsigned long long)vmInfo.internal,
+		(unsigned long long)vmInfo.compressed, (unsigned long long)vmInfo.external,
+		(unsigned long long)vmInfo.reusable, (unsigned long long)_physicalDevice->getCurrentAllocatedSize());
+	append("malloc=%llu/%llu malloc_zones=%u[", (unsigned long long)mallocUsed,
+		(unsigned long long)mallocAllocated, zoneCount);
+	for (unsigned i = 0; i < zoneCount; ++i) {
+		append("%s%s:%llu/%llu", i ? "," : "", zones[i].name,
+			(unsigned long long)zones[i].used, (unsigned long long)zones[i].allocated);
+	}
+	append("] jit_reserved=%llu jit_rx=%llu/%llu/%llu jit_rw=%llu/%llu/%llu ",
+		(unsigned long long)mvkMadeiraParseAddress("WINE_IOS_JIT_SIZE"),
+		(unsigned long long)jitRX.dirty, (unsigned long long)jitRX.swapped, (unsigned long long)jitRX.resident,
+		(unsigned long long)jitRW.dirty, (unsigned long long)jitRW.swapped, (unsigned long long)jitRW.resident);
+	append("async_jobs=%llu/%llu/%llu completions=%llu owned_min=%llu ",
+		(unsigned long long)async.jobs, (unsigned long long)async.queued, (unsigned long long)async.running,
+		(unsigned long long)async.completions, (unsigned long long)async.ownedMinBytes);
+	append("pso=%lu/%lu pipelines=%llu shader_libraries=%llu lib_cache=%llu/%llu lib_hits=%llu/%llu ",
+		(unsigned long)pso.first, (unsigned long)pso.second,
+		(unsigned long long)_livePipelines.load(std::memory_order_relaxed),
+		(unsigned long long)libraries.liveLibraries, (unsigned long long)libraries.entries,
+		(unsigned long long)libraries.sourceBytes, (unsigned long long)libraries.hits,
+		(unsigned long long)libraries.misses);
+	append("spirv=%llu/%llu msl_compressed=%llu/%llu conversion=%llu/%llu/%llu precompile_pending=%llu ",
+		(unsigned long long)spirv.first, (unsigned long long)spirv.second,
+		(unsigned long long)msl.first, (unsigned long long)msl.second,
+		(unsigned long long)conversions.entries, (unsigned long long)conversions.bytes,
+		(unsigned long long)conversions.cap, (unsigned long long)libraries.precompilePendingBytes);
+	append("archive_file_proxy=%llu/%llu/%llu vk_memory=%llu/%llu heaps=%llu/%llu buffers=%llu/%llu heap_buffers=%llu/%llu textures=%llu/%llu heap_textures=%llu/%llu residency_pending=%llu ",
+		(unsigned long long)g_mvkArchiveFrozenPages.load(std::memory_order_relaxed),
+		(unsigned long long)g_mvkArchiveFrozenFileBytes.load(std::memory_order_relaxed),
+		(unsigned long long)mvkMadeiraPressureCapacity(g_mvkArchiveBudgetFileBytes.load(std::memory_order_relaxed), 128 * 1024 * 1024, 2),
+		(unsigned long long)vkMem.first, (unsigned long long)vkMem.second,
+		(unsigned long long)heaps.first, (unsigned long long)heaps.second,
+		(unsigned long long)buffers.first, (unsigned long long)buffers.second,
+		(unsigned long long)heapBuffers.first, (unsigned long long)heapBuffers.second,
+		(unsigned long long)textures.first, (unsigned long long)textures.second,
+		(unsigned long long)heapTextures.first, (unsigned long long)heapTextures.second,
+		(unsigned long long)pendingResidency);
+	append("%s", "vm_tags=");
+	bool selected[256] = {};
+	uint64_t otherResident = 0, otherDirty = 0, otherSwapped = 0;
+	unsigned printed = 0;
+	for (; printed < 16; ++printed) {
+		unsigned best = 256; uint64_t bestBytes = 0;
+		for (unsigned tag = 0; tag < 256; ++tag) {
+			uint64_t bytes = tags[tag].dirty + tags[tag].swapped;
+			if (!selected[tag] && bytes > bestBytes) { best = tag; bestBytes = bytes; }
+		}
+		if (best == 256 || !bestBytes) break;
+		selected[best] = true;
+		append("%s%u:%llu/%llu/%llu", printed ? "," : "", best,
+			(unsigned long long)tags[best].dirty, (unsigned long long)tags[best].swapped,
+			(unsigned long long)tags[best].resident);
+	}
+	for (unsigned tag = 0; tag < 256; ++tag) if (!selected[tag]) {
+		otherResident += tags[tag].resident; otherDirty += tags[tag].dirty; otherSwapped += tags[tag].swapped;
+	}
+	append(" vm_tags_other=%llu/%llu/%llu pipeline_cache=%llu/%llu/%llu device_memory_buffers=%llu/%llu driver_pipeline_bytes=unknown\n",
+		(unsigned long long)otherDirty, (unsigned long long)otherSwapped, (unsigned long long)otherResident,
+		(unsigned long long)_livePipelineCaches.load(std::memory_order_relaxed),
+		(unsigned long long)_pipelineCacheBuckets.load(std::memory_order_relaxed),
+		(unsigned long long)_pipelineCacheEntries.load(std::memory_order_relaxed),
+		(unsigned long long)deviceBuffers.first, (unsigned long long)deviceBuffers.second);
+	fwrite(line, 1, length, stderr);
+	logBinaryArchiveMemory();
+	mvkMadeiraShaderPrewarmLog();
+}
